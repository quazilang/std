// Regression coverage for reusable in-place String cleanup.

@test
fn string_clear_invalidates_and_is_repeat_safe() void {
    var value: String = String.from("owned string");
    value.clear();
    if (value.bytes_len() != 0) { panic("String.clear did not clear the byte length"); }
    if (!value.is_empty()) { panic("String.clear did not invalidate the string view"); }
    if (!value.as_str().is_empty()) { panic("String.clear did not replace the data view"); }
    value.clear();
}
