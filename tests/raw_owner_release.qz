// Regression coverage for consuming cleanup of raw-allocation owners.

import std.collections;

@test
fn map_free_consumes_the_owner() void {
    var values: collections.Map = collections.Map.new().unwrap();
    values.insert(1, 2).unwrap();
    values.free();
}

@test
fn set_free_consumes_the_owner() void {
    var values: collections.Set = collections.Set.new().unwrap();
    values.insert(1).unwrap();
    values.free();
}

@test
fn collection_receivers_preserve_single_owner_access() void {
    var map: collections.Map = collections.Map.new().unwrap();
    map.insert(7, 42).unwrap();
    if (map.get(7).unwrap() != 42) { panic("Map shared lookup lost an inserted value"); }
    if (!map.remove(7)) { panic("Map exclusive removal did not remove an inserted value"); }
    if (map.contains(7)) { panic("Map still contains a removed key"); }

    var set: collections.Set = collections.Set.new().unwrap();
    set.insert(7).unwrap();
    if (!set.contains(7)) { panic("Set shared lookup lost an inserted value"); }
    if (!set.remove(7)) { panic("Set exclusive removal did not remove an inserted value"); }
    if (set.contains(7)) { panic("Set still contains a removed key"); }
}

@test
fn array_free_consumes_the_owner() void {
    var values: Array[i32] = Array.new();
    values.push(1);
    values.free();
}

@test
fn box_free_consumes_the_owner() void {
    var value = Box.new(7);
    value.free();
}
