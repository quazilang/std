// Regression coverage for the compiler-backed child-process contract.

import std.process;
import std.time;
import std.process.ExitStatus;

@test
fn process_spawn_waits_for_an_exact_program_path() void {
    var args: Array[str] = Array.new();
    args.push("-i");
    var child: process.Child = match process.spawn("/usr/bin/env", args) {
        Ok(value) => value,
        Err(error) => panic(error.native_code().to_string().as_str()),
    };
    const waited = child.wait();
    if (waited.is_err()) { panic("process.wait failed"); }
    const succeeded: bool = match waited.unwrap() {
        Option.Some(ExitStatus.Code(0)) => true,
        _ => false,
    };
    if (!succeeded) { panic("/usr/bin/env -i returned an unexpected status"); }
}

@test
fn process_spawn_reports_execve_failure_before_returning_a_child() void {
    var args: Array[str] = Array.new();
    const failed: bool = match process.spawn("/definitely-not-a-quazi-executable", args) {
        Ok(_) => false,
        Err(_) => true,
    };
    if (!failed) { panic("process.spawn returned a child for a missing program"); }
}

@test
fn process_try_wait_keeps_the_local_available_for_wait_or_close() void {
    var args: Array[str] = Array.new();
    args.push("-i");
    var child: process.Child = match process.spawn("/usr/bin/env", args) {
        Ok(value) => value,
        Err(_) => panic("process.spawn failed for try_wait"),
    };
    const polled = child.try_wait().unwrap();
    const exited: bool = polled.is_some();
    const waited = child.wait().unwrap();
    if (exited && waited.is_some()) { panic("wait returned a second status after try_wait cleared the child"); }
    if (!exited && waited.is_none()) { panic("wait lost a live child after try_wait"); }

    var close_args: Array[str] = Array.new();
    close_args.push("-i");
    var closable: process.Child = match process.spawn("/usr/bin/env", close_args) {
        Ok(value) => value,
        Err(_) => panic("process.spawn failed for close"),
    };
    const closed = closable.close();
    if (closed.is_err() || !closed.unwrap()) { panic("process.close did not consume its child"); }
}

fn command_code(command: process.Command) i32 {
    const status = command.status().unwrap();
    match status {
        ExitStatus.Code(code) => code,
        ExitStatus.Signal(_) => -1,
    }
}

@test
fn command_finds_programs_and_sets_directory_and_environment() void {
    // PATH lookup, working directory and an added variable.
    const configured = process.Command.new("sh")
        .arg("-c")
        .arg("test \"$(pwd)\" = /tmp && test \"$QUAZI_COMMAND_TEST\" = 'a b'")
        .current_dir("/tmp")
        .env("QUAZI_COMMAND_TEST", "a b");
    if (command_code(configured) != 0) { panic("directory or environment not applied"); }
    // A removed variable is gone; an inherited one (PATH) stays.
    const removed = process.Command.new("sh")
        .arg("-c")
        .arg("test -z \"$QUAZI_COMMAND_TEST\" && test -n \"$PATH\"")
        .env("QUAZI_COMMAND_TEST", "x")
        .env_remove("QUAZI_COMMAND_TEST");
    if (command_code(removed) != 0) { panic("env_remove"); }
    // A cleared environment keeps only explicit variables.
    const cleared = process.Command.new("/bin/sh")
        .arg("-c")
        .arg("test -z \"$HOME\" && test \"$ONLY\" = 1")
        .env_clear()
        .env("ONLY", "1");
    if (command_code(cleared) != 0) { panic("env_clear"); }
    if (command_code(process.Command.new("sh").arg("-c").arg("exit 7")) != 7) { panic("exit code"); }
    if (process.Command.new("definitely-not-a-quazi-program").status().is_ok()) { panic("missing program"); }
    if (process.Command.new("sh").current_dir("/definitely/missing").status().is_ok()) { panic("missing directory"); }
}

@test
fn process_wait_timeout_returns_none_then_terminates() void {
    var args: Array[str] = Array.new();
    args.push("sleep");
    args.push("5");
    var child: process.Child = process.spawn("/usr/bin/env", args).unwrap();
    const early = child.wait_timeout(time.Duration.from_milliseconds(50)).unwrap();
    if (early.is_some()) { panic("sleep 5 finished within 50 ms"); }
    const status = child.wait_or_terminate(time.Duration.from_milliseconds(20)).unwrap();
    const signalled: bool = match status {
        Option.Some(ExitStatus.Signal(_)) => true,
        _ => false,
    };
    if (!signalled) { panic("a terminated child must report a signal"); }

    var quick_args: Array[str] = Array.new();
    quick_args.push("true");
    var quick: process.Child = process.spawn("/usr/bin/env", quick_args).unwrap();
    const done = quick.wait_timeout(time.Duration.from_seconds(5)).unwrap();
    const exited: bool = match done {
        Option.Some(ExitStatus.Code(0)) => true,
        _ => false,
    };
    if (!exited) { panic("a quick child must exit within the timeout"); }
}

@test
fn command_output_captures_both_streams_concurrently() void {
    const small = process.Command.new("sh").arg("-c").arg("printf hello; printf oops >&2; exit 3").output().unwrap();
    const code: i32 = match small.status { ExitStatus.Code(c) => c, ExitStatus.Signal(_) => -1 };
    if (code != 3 || small.stdout.len() != 5 || small.stderr.len() != 4) { panic("small output"); }
    if (small.stdout.get(0) != 104) { panic("stdout bytes"); }
    // Both pipes stay drained: a child filling one while the parent waits on
    // the other must not deadlock.
    const big = process.Command.new("sh").arg("-c").arg("head -c 3000000 /dev/zero >&2; head -c 2000000 /dev/zero").output().unwrap();
    if (big.stdout.len() != 2000000 || big.stderr.len() != 3000000) { panic("large output"); }
    if (process.Command.new("definitely-not-a-quazi-program").output().is_ok()) { panic("missing program"); }
}
