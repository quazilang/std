// Portable dependency-free f64 mathematics.
//
// These routines are implemented in Quazi, so importing std.math never pulls
// in libc or libm. Trigonometric inputs and outputs use radians.

fn __magnitude(value: i64) u64 {
    if (value < 0) { ret ((-(value + 1)) as u64) + 1; }
    ret value as u64;
}

fn __u64_greater(left: u64, right: u64) bool {
    const left_high: u64 = left >> 63;
    const right_high: u64 = right >> 63;
    if (left_high != right_high) { ret left_high != 0; }
    ret left > right;
}

fn __gcd_u64(a: u64, b: u64) u64 {
    var left: u64 = a;
    var right: u64 = b;
    if (left == 0) { ret right; }
    if (right == 0) { ret left; }
    var shift: u32 = 0;
    for (((left | right) & 1) == 0) {
        left = left >> 1;
        right = right >> 1;
        shift++;
    }
    for ((left & 1) == 0) { left = left >> 1; }
    for (right != 0) {
        for ((right & 1) == 0) { right = right >> 1; }
        if (math.__u64_greater(left, right)) {
            const swap: u64 = left;
            left = right;
            right = swap;
        }
        right = right - left;
    }
    ret left << shift;
}

pub fn gcd(a: i64, b: i64) i64 {
    const value: u64 = math.__gcd_u64(math.__magnitude(a), math.__magnitude(b));
    if (value > 9223372036854775807) { panic("gcd result does not fit i64"); }
    ret value as i64;
}

pub fn lcm(a: i64, b: i64) i64 {
    if (a == 0 || b == 0) { ret 0; }
    ret (a / math.gcd(a, b) * b).abs();
}

pub fn factorial(value: u32) u64 {
    var result: u64 = 1;
    var factor: u32 = 2;
    for (factor <= value) { result = result * (factor as u64); factor++; }
    ret result;
}

pub fn permutations(n: u32, r: u32) u64 {
    if (r > n) { ret 0; }
    var result: u64 = 1;
    var offset: u32 = 0;
    for (offset < r) { result = result * ((n - offset) as u64); offset++; }
    ret result;
}

pub fn combinations(n: u32, r: u32) u64 {
    if (r > n) { ret 0; }
    var count: u32 = r;
    if (count > n - count) { count = n - count; }
    var result: u64 = 1;
    var index: u32 = 1;
    for (index <= count) {
        result = result * ((n - count + index) as u64) / (index as u64);
        index++;
    }
    ret result;
}

pub fn abs(value: f64) f64 { ret value.abs(); }
pub fn min(a: f64, b: f64) f64 { ret a.min(b); }
pub fn max(a: f64, b: f64) f64 { ret a.max(b); }
pub fn clamp(value: f64, low: f64, high: f64) f64 { ret value.clamp(low, high); }

// The IEEE-754 bits of an f64 and back, and the correctly rounded SSE2
// square root.
@intrinsic("quazi.f64.to_bits")
fn __to_bits(value: f64) u64;
@intrinsic("quazi.f64.from_bits")
fn __from_bits(bits: u64) f64;
@intrinsic("quazi.f64.sqrt")
fn __hardware_sqrt(value: f64) f64;

// Biased exponent field (0..2047).
fn __exponent_field(value: f64) i64 { ret ((math.__to_bits(value) >> 52) & 2047) as i64; }

// 2^k for an integral f64 -1022 <= k <= 1023. Adding 1.5 * 2^52 moves k
// into the low fraction bits (two's complement modulo 2^52), and the
// exponent field takes k + 1023 modulo 2048.
fn __power_of_two(k: f64) f64 {
    const low: u64 = math.__to_bits(k + 6755399441055744.0);
    ret math.__from_bits(((low + 1023) & 2047) << 52);
}

// Clears the fraction bits below the units place; keeps the sign of zero.
pub fn trunc(value: f64) f64 {
    const exponent: i64 = math.__exponent_field(value) - 1023;
    if (exponent >= 52) { ret value; }
    const bits: u64 = math.__to_bits(value);
    if (exponent < 0) { ret math.__from_bits(bits & 9223372036854775808); }
    const fraction: u64 = (4503599627370495 as u64) >> (exponent as u64);
    ret math.__from_bits(bits & (fraction ^ 18446744073709551615));
}

pub fn floor(value: f64) f64 {
    const whole: f64 = math.trunc(value);
    if (whole > value) { ret whole - 1.0; }
    ret whole;
}

pub fn ceil(value: f64) f64 {
    const whole: f64 = math.trunc(value);
    if (whole < value) { ret whole + 1.0; }
    ret whole;
}

// Halves round away from zero. `value - whole` is exact, so values just below
// a half (0.49999999999999994) are not pushed over it.
pub fn round(value: f64) f64 {
    const whole: f64 = math.trunc(value);
    const rest: f64 = value - whole;
    if (rest >= 0.5) { ret whole + 1.0; }
    if (rest <= -0.5) { ret whole - 1.0; }
    ret whole;
}

pub fn fract(value: f64) f64 { ret value - math.trunc(value); }
pub fn sign(value: f64) f64 {
    if (value < 0.0) { ret -1.0; }
    if (value > 0.0) { ret 1.0; }
    ret value;
}
pub fn lerp(start: f64, end: f64, amount: f64) f64 {
    ret start + (end - start) * amount;
}
pub fn map_range(value: f64, from_low: f64, from_high: f64,
    to_low: f64, to_high: f64) f64 {
    ret to_low + (value - from_low) * (to_high - to_low) / (from_high - from_low);
}
pub fn radians(degrees: f64) f64 { ret degrees * 0.0174532925199432958; }
pub fn degrees(radians: f64) f64 { ret radians * 57.2957795130823208768; }

// Correctly rounded (sqrtsd); NaN below zero, -0.0 stays -0.0.
pub fn sqrt(value: f64) f64 { ret math.__hardware_sqrt(value); }

pub fn cbrt(value: f64) f64 {
    if (value == 0.0 || value != value) { ret value; }
    if (value < 0.0) { ret -math.cbrt(-value); }
    if (value == 1.0 / 0.0) { ret value; }
    // Subnormals are scaled into the normal range first (2^54 = (2^18)^3).
    var x: f64 = value;
    var scale: f64 = 1.0;
    if (math.__exponent_field(x) == 0) {
        x = x * 18014398509481984.0;
        scale = 1.0 / 262144.0;
    }
    // Dividing the bit pattern by three approximates the cube root's exponent
    // and leading bits (within about 5%); Newton steps then converge.
    var estimate: f64 = math.__from_bits(math.__to_bits(x) / 3 + 3071306043645493248);
    var iteration: usize = 0;
    for (iteration < 6) {
        estimate = estimate - (estimate * estimate * estimate - x) / (3.0 * estimate * estimate);
        iteration++;
    }
    ret estimate * scale;
}

pub fn hypot(x: f64, y: f64) f64 {
    const ax: f64 = x.abs();
    const ay: f64 = y.abs();
    // An infinite leg wins even over NaN (C99 Annex F).
    if (ax == 1.0 / 0.0 || ay == 1.0 / 0.0) { ret 1.0 / 0.0; }
    if (ax != ax || ay != ay) { ret 0.0 / 0.0; }
    const largest: f64 = math.max(ax, ay);
    if (largest == 0.0 || largest == 1.0 / 0.0) { ret largest; }
    const sx: f64 = ax / largest;
    const sy: f64 = ay / largest;
    ret largest * math.sqrt(sx * sx + sy * sy);
}

// sin and cos on [-pi/4, pi/4] (fdlibm kernels, about 1 ULP).
fn __sin_kernel(x: f64) f64 {
    const z: f64 = x * x;
    const r: f64 = 8.33333333332248946124e-03 + z * (-1.98412698298579493134e-04
        + z * (2.75573137070700676789e-06 + z * (-2.50507602534068634195e-08
        + z * 1.58969099521155010221e-10)));
    ret x + z * x * (-1.66666666666666324348e-01 + z * r);
}

fn __cos_kernel(x: f64) f64 {
    const z: f64 = x * x;
    const r: f64 = z * (4.16666666666666019037e-02 + z * (-1.38888888888741095749e-03
        + z * (2.48015872894767294178e-05 + z * (-2.75573143513906633035e-07
        + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)))));
    const half: f64 = 0.5 * z;
    const w: f64 = 1.0 - half;
    ret w + (((1.0 - w) - half) + z * r);
}

// value = n * pi/2 + reduced with |reduced| <= pi/4. pi/2 is split into three
// parts (Cody-Waite), exact for |n| < 2^20 (|value| up to about 1.6e6);
// beyond that accuracy degrades gradually.
struct __Reduced { quadrant: f64, angle: f64, }

fn __reduce_half_pi(value: f64) __Reduced {
    const n: f64 = math.round(value * 0.63661977236758134308);
    const angle: f64 = ((value - n * 1.57079632673412561417)
        - n * 6.07710050630396597660e-11) - n * 2.02226624871116645580e-21;
    const quadrant: f64 = n - 4.0 * math.floor(n / 4.0);
    __Reduced { quadrant: quadrant, angle: angle }
}

pub fn sin(value: f64) f64 {
    if (value != value || value.abs() == 1.0 / 0.0) { ret 0.0 / 0.0; }
    // Tiny inputs (and signed zeros) are their own sine.
    if (value.abs() < 7.450580596923828e-09) { ret value; }
    const reduced = math.__reduce_half_pi(value);
    const q: f64 = reduced.quadrant;
    if (q == 0.0) { ret math.__sin_kernel(reduced.angle); }
    if (q == 1.0) { ret math.__cos_kernel(reduced.angle); }
    if (q == 2.0) { ret -math.__sin_kernel(reduced.angle); }
    -math.__cos_kernel(reduced.angle)
}

pub fn cos(value: f64) f64 {
    if (value != value || value.abs() == 1.0 / 0.0) { ret 0.0 / 0.0; }
    const reduced = math.__reduce_half_pi(value);
    const q: f64 = reduced.quadrant;
    if (q == 0.0) { ret math.__cos_kernel(reduced.angle); }
    if (q == 1.0) { ret -math.__sin_kernel(reduced.angle); }
    if (q == 2.0) { ret -math.__cos_kernel(reduced.angle); }
    math.__sin_kernel(reduced.angle)
}

pub fn tan(value: f64) f64 {
    if (value != value || value.abs() == 1.0 / 0.0) { ret 0.0 / 0.0; }
    if (value.abs() < 7.450580596923828e-09) { ret value; }
    const reduced = math.__reduce_half_pi(value);
    const s: f64 = math.__sin_kernel(reduced.angle);
    const c: f64 = math.__cos_kernel(reduced.angle);
    if (reduced.quadrant == 0.0 || reduced.quadrant == 2.0) { ret s / c; }
    -c / s
}

// fdlibm's atan: reduce against atan(1/2), atan(1), atan(3/2) or pi/2
// (each split into high and low parts), then an odd polynomial.
fn __atan_polynomial(x: f64) f64 {
    const z: f64 = x * x;
    const w: f64 = z * z;
    const odd: f64 = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01
        + w * (9.09088713343650656196e-02 + w * (6.66107313738753120669e-02
        + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))));
    const even: f64 = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01
        + w * (-7.69187620504482999495e-02 + w * (-5.83357013379057348645e-02
        + w * -3.65315727442169155270e-02))));
    ret x * (odd + even);
}

pub fn atan(value: f64) f64 {
    // Zeros (keeping their sign) and NaN pass through unchanged.
    if (value == 0.0 || value != value) { ret value; }
    if (value < 0.0) { ret -math.atan(-value); }
    if (value > 7.378697629483821e19) { ret 1.5707963267948966192; }
    if (value < 0.4375) {
        if (value < 7.450580596923828e-09) { ret value; }
        ret value - math.__atan_polynomial(value);
    }
    var x: f64 = value;
    var high: f64 = 0.0;
    var low: f64 = 0.0;
    if (value < 0.6875) {
        x = (2.0 * value - 1.0) / (2.0 + value);
        high = 4.63647609000806093515e-01;
        low = 2.26987774529616870924e-17;
    } else if (value < 1.1875) {
        x = (value - 1.0) / (value + 1.0);
        high = 7.85398163397448278999e-01;
        low = 3.06161699786838301793e-17;
    } else if (value < 2.4375) {
        x = (value - 1.5) / (1.0 + 1.5 * value);
        high = 9.82793723247329054082e-01;
        low = 1.39033110312309984516e-17;
    } else {
        x = -1.0 / value;
        high = 1.57079632679489655800e+00;
        low = 6.12323399573676603587e-17;
    }
    ret high - ((math.__atan_polynomial(x) - low) - x);
}

pub fn arctan(value: f64) f64 { ret math.atan(value); }

pub fn atan2(y: f64, x: f64) f64 {
    if (y != y || x != x) { ret 0.0 / 0.0; }
    const infinity: f64 = 1.0 / 0.0;
    const pi: f64 = 3.1415926535897932385;
    // The sign of y, including -0.0, selects the half plane (C99 Annex F).
    const y_negative: bool = y < 0.0 || (y == 0.0 && 1.0 / y < 0.0);
    if (y.abs() == infinity && x.abs() == infinity) {
        const angle: f64 = if (x > 0.0) { pi / 4.0 } else { 3.0 * pi / 4.0 };
        ret if (y_negative) { -angle } else { angle };
    }
    if (x > 0.0) { ret math.atan(y / x); }
    if (x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)) {
        if (y == 0.0) { ret if (y_negative) { -pi } else { pi }; }
        ret if (y_negative) { math.atan(y / x) - pi } else { math.atan(y / x) + pi };
    }
    if (y > 0.0) { ret pi / 2.0; }
    if (y < 0.0) { ret -pi / 2.0; }
    y
}

pub fn arctan2(y: f64, x: f64) f64 { ret math.atan2(y, x); }

pub fn asin(value: f64) f64 {
    if (value != value || value < -1.0 || value > 1.0) { ret 0.0 / 0.0; }
    // (1 - v)(1 + v) keeps the digits that 1 - v * v cancels near |v| = 1.
    ret math.atan2(value, math.sqrt((1.0 - value) * (1.0 + value)));
}

// Near |v| = 1, pi/2 - asin(v) cancels; the half-angle forms keep the digits.
pub fn acos(value: f64) f64 {
    if (value > 0.5) { ret 2.0 * math.asin(math.sqrt((1.0 - value) * 0.5)); }
    if (value < -0.5) {
        ret 3.1415926535897932385 - 2.0 * math.asin(math.sqrt((1.0 + value) * 0.5));
    }
    1.5707963267948966192 - math.asin(value)
}

pub fn exp(value: f64) f64 {
    if (value != value) { ret value; }
    if (value > 709.782712893384) { ret 1.0 / 0.0; }
    if (value < -745.1332191019411) { ret 0.0; }
    // value = k * ln2 + r with |r| <= ln2/2; ln2 is split in two parts so
    // k * ln2_hi is exact.
    const k: f64 = math.round(value * 1.44269504088896338700);
    const r: f64 = (value - k * 6.93147180369123816490e-01) - k * 1.90821492927058770002e-10;
    // exp(r) by its Taylor series to r^13 (truncation below 1e-17 here).
    var sum: f64 = 1.0;
    var term: f64 = 1.0;
    var index: f64 = 1.0;
    for (index <= 13.0) {
        term = term * r / index;
        sum = sum + term;
        index = index + 1.0;
    }
    // Scale by 2^k in at most two exact steps (subnormal results round once).
    if (k > 1023.0) { ret sum * 2.0 * math.__power_of_two(k - 1.0); }
    if (k < -1022.0) {
        ret sum * math.__power_of_two(k + 1000.0) * math.__power_of_two(-1000.0);
    }
    sum * math.__power_of_two(k)
}

pub fn ln(value: f64) f64 {
    if (value != value) { ret value; }
    if (value < 0.0) { ret 0.0 / 0.0; }
    if (value == 0.0) { ret -1.0 / 0.0; }
    if (value == 1.0 / 0.0) { ret value; }
    var normalized: f64 = value;
    var scale: f64 = 0.0;
    for (normalized > 1.5) { normalized = normalized * 0.5; scale = scale + 1.0; }
    for (normalized < 0.75) { normalized = normalized * 2.0; scale = scale - 1.0; }
    const ratio: f64 = (normalized - 1.0) / (normalized + 1.0);
    const squared: f64 = ratio * ratio;
    var term: f64 = ratio;
    var sum: f64 = ratio;
    var denominator: f64 = 3.0;
    var iteration: usize = 0;
    for (iteration < 18) {
        term = term * squared;
        sum = sum + term / denominator;
        denominator = denominator + 2.0;
        iteration++;
    }
    ret 2.0 * sum + scale * 0.6931471805599453094;
}

pub fn log2(value: f64) f64 { ret math.ln(value) / 0.6931471805599453094; }
pub fn log10(value: f64) f64 { ret math.ln(value) / 2.3025850929940456840; }

// sinh by its odd Taylor series below 1/2, where exp(x) - exp(-x) would
// cancel; the truncated term x^17/17! is below 2e-21 there.
fn __small_sinh(x: f64) f64 {
    const z: f64 = x * x;
    ret x + x * z * (1.0 / 6.0 + z * (1.0 / 120.0 + z * (1.0 / 5040.0
        + z * (1.0 / 362880.0 + z * (1.0 / 39916800.0 + z * (1.0 / 6227020800.0
        + z * (1.0 / 1307674368000.0)))))));
}

pub fn sinh(value: f64) f64 {
    if (value.abs() < 0.5) { ret math.__small_sinh(value); }
    const positive: f64 = math.exp(value);
    ret (positive - 1.0 / positive) * 0.5;
}
pub fn cosh(value: f64) f64 {
    const positive: f64 = math.exp(value);
    ret (positive + 1.0 / positive) * 0.5;
}
pub fn tanh(value: f64) f64 {
    if (value != value) { ret value; }
    if (value > 20.0) { ret 1.0; }
    if (value < -20.0) { ret -1.0; }
    if (value.abs() < 0.5) {
        const s: f64 = math.__small_sinh(value);
        ret s / math.sqrt(1.0 + s * s);
    }
    const doubled: f64 = math.exp(2.0 * value);
    ret (doubled - 1.0) / (doubled + 1.0);
}

pub fn pow(base: f64, exponent: f64) f64 {
    // pow(x, 0) and pow(1, y) are 1 even for NaN operands (C99 Annex F).
    if (exponent == 0.0 || base == 1.0) { ret 1.0; }
    if (base != base || exponent != exponent) { ret 0.0 / 0.0; }
    if (base == 0.0) { if (exponent < 0.0) { ret 1.0 / 0.0; } ret 0.0; }
    if (base < 0.0) {
        if (exponent == 1.0 / 0.0) {
            if (base == -1.0) { ret 1.0; }
            if (base < -1.0) { ret 1.0 / 0.0; }
            ret 0.0;
        }
        if (exponent == -1.0 / 0.0) {
            if (base == -1.0) { ret 1.0; }
            if (base < -1.0) { ret 0.0; }
            ret 1.0 / 0.0;
        }
        const integral: f64 = math.trunc(exponent);
        if (integral != exponent) { ret 0.0 / 0.0; }
        var magnitude: f64 = integral.abs();
        var result: f64 = 1.0;
        var factor: f64 = base;
        // Integral f64 values need at most 53 squaring steps, even near 2^53.
        for (magnitude > 0.0) {
            const half: f64 = math.trunc(magnitude / 2.0);
            if (magnitude - half * 2.0 != 0.0) { result = result * factor; }
            factor = factor * factor;
            magnitude = half;
        }
        if (exponent < 0.0) { ret 1.0 / result; }
        ret result;
    }
    ret math.exp(exponent * math.ln(base));
}

impl f64 {
    pub fn trunc(self: f64) f64 { ret math.trunc(self); }
    pub fn floor(self: f64) f64 { ret math.floor(self); }
    pub fn ceil(self: f64) f64 { ret math.ceil(self); }
    pub fn round(self: f64) f64 { ret math.round(self); }
    pub fn fract(self: f64) f64 { ret math.fract(self); }
    pub fn sign(self: f64) f64 { ret math.sign(self); }
    pub fn sqrt(self: f64) f64 { ret math.sqrt(self); }
    pub fn cbrt(self: f64) f64 { ret math.cbrt(self); }
    pub fn sin(self: f64) f64 { ret math.sin(self); }
    pub fn cos(self: f64) f64 { ret math.cos(self); }
    pub fn tan(self: f64) f64 { ret math.tan(self); }
    pub fn atan(self: f64) f64 { ret math.atan(self); }
    pub fn arctan(self: f64) f64 { ret math.atan(self); }
    pub fn atan2(self: f64, x: f64) f64 { ret math.atan2(self, x); }
    pub fn arctan2(self: f64, x: f64) f64 { ret math.atan2(self, x); }
    pub fn asin(self: f64) f64 { ret math.asin(self); }
    pub fn acos(self: f64) f64 { ret math.acos(self); }
    pub fn exp(self: f64) f64 { ret math.exp(self); }
    pub fn ln(self: f64) f64 { ret math.ln(self); }
    pub fn log2(self: f64) f64 { ret math.log2(self); }
    pub fn log10(self: f64) f64 { ret math.log10(self); }
    pub fn sinh(self: f64) f64 { ret math.sinh(self); }
    pub fn cosh(self: f64) f64 { ret math.cosh(self); }
    pub fn tanh(self: f64) f64 { ret math.tanh(self); }
    pub fn degrees(self: f64) f64 { ret math.degrees(self); }
    pub fn radians(self: f64) f64 { ret math.radians(self); }
    pub fn pow(self: f64, exponent: f64) f64 { ret math.pow(self, exponent); }
}

fn __is_nan(value: f64) bool { value != value }
fn __is_negative_zero(value: f64) bool { value == 0.0 && 1.0 / value < 0.0 }

@test
fn roots_and_hypot_follow_annex_f() void {
    const zero: f64 = 0.0;
    const nan: f64 = zero / zero;
    const inf: f64 = 1.0 / zero;
    if (!__is_nan(math.sqrt(-1.0)) || !__is_negative_zero(math.sqrt(-0.0)) || math.sqrt(inf) != inf) { panic("sqrt special values"); }
    if (math.hypot(inf, nan) != inf || math.hypot(nan, -inf) != inf || !__is_nan(math.hypot(nan, 1.0))) { panic("hypot special values"); }
}

@test
fn inverse_trigonometry_follows_annex_f() void {
    const zero: f64 = 0.0;
    const nan: f64 = zero / zero;
    const inf: f64 = 1.0 / zero;
    if (!__is_nan(math.asin(nan)) || !__is_nan(math.asin(2.0)) || !__is_nan(math.acos(-2.0))) { panic("asin/acos domain"); }
    const pi: f64 = 3.1415926535897932385;
    if (math.atan2(0.0, -1.0) != pi || math.atan2(-0.0, -1.0) != -pi) { panic("atan2 signed zero"); }
    if (math.atan2(inf, inf) != pi / 4.0 || math.atan2(-inf, -inf) != -3.0 * pi / 4.0) { panic("atan2 infinities"); }
    if (!__is_negative_zero(math.atan2(-0.0, 1.0)) || !__is_nan(math.atan2(nan, 1.0))) { panic("atan2 zero/NaN"); }
}

@test
fn pow_and_min_max_follow_annex_f() void {
    const zero: f64 = 0.0;
    const nan: f64 = zero / zero;
    const inf: f64 = 1.0 / zero;
    if (math.pow(1.0, nan) != 1.0 || math.pow(nan, 0.0) != 1.0 || !__is_nan(math.pow(nan, 2.0)) || !__is_nan(math.pow(-8.0, 0.5))) {
        panic("pow special values");
    }
    if (math.min(nan, 1.0) != 1.0 || math.max(1.0, nan) != 1.0 || math.max(nan, 2.0) != 2.0) { panic("min/max NaN operands"); }
    if (__is_negative_zero(math.abs(-0.0)) || math.abs(-inf) != inf) { panic("abs signs"); }
}

@test
fn exp_ln_and_rounding_follow_annex_f() void {
    const zero: f64 = 0.0;
    const nan: f64 = zero / zero;
    const inf: f64 = 1.0 / zero;
    if (math.ln(0.0) != -inf || !__is_nan(math.ln(-1.0)) || math.exp(-inf) != 0.0 || math.exp(inf) != inf) { panic("exp/ln"); }
    if (math.trunc(1.0e300) != 1.0e300 || math.floor(-1.0e300) != -1.0e300) { panic("large rounding"); }
}

@test
fn angle_reduction_stays_accurate_for_large_arguments() void {
    // sin(1e6) = -0.34999350217129294; sin(1e9) = 0.5458434494486996.
    if ((math.sin(1.0e6) + 0.34999350217129294).abs() > 1.0e-9) { panic("sin(1e6) is inaccurate"); }
    if ((math.sin(1.0e9) - 0.5458434494486996).abs() > 1.0e-6) { panic("sin(1e9) is inaccurate"); }
    if ((math.cos(1.0e6) - 0.9367521275331447).abs() > 1.0e-9) { panic("cos(1e6) is inaccurate"); }
}

@test
fn special_values_and_reductions_hold() {
    if (math.__to_bits(math.sqrt(2.0)) != 4609047870845172685) { panic("sqrt(2) is not correctly rounded"); }
    if (math.sqrt(5e-324) != 2.2227587494850775e-162) { panic("subnormal sqrt"); }
    if (math.__to_bits(math.trunc(-0.0)) != 9223372036854775808) { panic("trunc(-0.0) lost its sign"); }
    if (math.__to_bits(math.ceil(-0.5)) != 9223372036854775808) { panic("ceil(-0.5) must be -0.0"); }
    if (math.round(0.49999999999999994) != 0.0 || math.round(-2.5) != -3.0) { panic("round halves"); }
    if (math.floor(-4.5e15) != -4.5e15 || math.floor(-1.5) != -2.0) { panic("floor"); }
    if (math.__to_bits(math.sin(2.0)) != 4606365442650518598) { panic("sin(2) is off by more than 0 ULP"); }
    if (math.cos(1e5).abs() > 1.0 || math.sin(1e5) != math.sin(1e5)) { panic("large-argument reduction"); }
    if ((math.exp(1.0) - 2.718281828459045).abs() > 1.4e-15 || math.exp(-745.2) != 0.0) { panic("exp"); }
    if (math.cbrt(-27.0) != -3.0 || math.cbrt(8e-300) != 2e-100) { panic("cbrt"); }
    if (math.atan(1.0) != 0.7853981633974483 || math.acos(-1.0) != 3.141592653589793) { panic("atan/acos"); }
}
