// std.fs — file system operations
// Checked convenience wrappers plus explicit unsafe raw-buffer operations
// around std.unix syscalls (Linux primary).
// Windows: @cfg dispatch pending — use std.windows directly for now.
import std.core;
import std.unix;

// ── File struct ───────────────────────────────────────────────────────────────

pub struct File {
    fd: i32,
}

impl File {
    // Open existing file for reading. Returns Ok(File) or Err(errno as i32).
    pub fn open(path: str) Result[File, i32] {
        var fd: i32 = 0;
        unsafe { fd = unix.open(path, 0, 0); }  // O_RDONLY = 0
        if (fd < 0) { ret Err(fd); }
        ret Ok(File { fd: fd });
    }

    // Create or truncate file for writing. Mode 0o644 = 420.
    pub fn create(path: str) Result[File, i32] {
        var fd: i32 = 0;
        // O_WRONLY=1 | O_CREAT=64 | O_TRUNC=512 = 577; mode 0o644 = 420
        unsafe { fd = unix.open(path, 577, 420); }
        if (fd < 0) { ret Err(fd); }
        ret Ok(File { fd: fd });
    }

    // Open for reading and writing, creating if needed. Mode 0o644.
    pub fn open_rw(path: str) Result[File, i32] {
        var fd: i32 = 0;
        // O_RDWR=2 | O_CREAT=64 = 66; mode 0o644 = 420
        unsafe { fd = unix.open(path, 66, 420); }
        if (fd < 0) { ret Err(fd); }
        ret Ok(File { fd: fd });
    }

    // Open in append mode, creating if needed. Mode 0o644.
    pub fn open_append(path: str) Result[File, i32] {
        var fd: i32 = 0;
        // O_WRONLY=1 | O_CREAT=64 | O_APPEND=1024 = 1089; mode 0o644 = 420
        unsafe { fd = unix.open(path, 1089, 420); }
        if (fd < 0) { ret Err(fd); }
        ret Ok(File { fd: fd });
    }

    // Raw buffer read. The caller owns the allocation and must guarantee that
    // `buf` is writable for at least `n` bytes.
    pub unsafe fn read(self: File, buf: *u8, n: usize) isize {
        var r: isize = 0;
        r = unix.read(self.fd, buf, n);
        ret r;
    }

    // Write an exact immutable byte string; its stored length is authoritative.
    pub fn write(self: File, buf: bytes) isize {
        var r: isize = 0;
        unsafe { r = core.write_bytes(self.fd, buf.as_ptr(), buf.len()); }
        ret r;
    }

    // Raw buffer write for FFI-style callers. The caller must guarantee that
    // `buf` is readable for at least `n` bytes.
    pub unsafe fn write_raw(self: File, buf: *u8, n: usize) isize {
        ret core.write_bytes(self.fd, buf, n);
    }

    // Write an entire string. Returns bytes written or negative errno.
    pub fn write_str(self: File, s: str) isize {
        var r: isize = 0;
        unsafe { r = unix.write(self.fd, s, core.strlen(s)); }
        ret r;
    }

    // Close the file descriptor. Returns 0 on success or negative errno.
    pub fn close(self: File) i32 {
        var r: i32 = 0;
        unsafe { r = unix.close(self.fd); }
        ret r;
    }

    // Seek to offset. whence: 0=SET, 1=CUR, 2=END. Returns new position.
    pub fn seek(self: File, offset: i64, whence: i32) i64 {
        var r: i64 = 0;
        unsafe { r = unix.lseek(self.fd, offset, whence); }
        ret r;
    }

    // Get the underlying file descriptor.
    pub fn fd(self: File) i32 { ret self.fd; }

    // Flush kernel buffers to disk.
    pub fn sync(self: File) i32 {
        var r: i32 = 0;
        unsafe { r = unix.fsync(self.fd); }
        ret r;
    }

    // Truncate or extend file to exactly len bytes.
    pub fn truncate(self: File, len: i64) i32 {
        var r: i32 = 0;
        unsafe { r = unix.ftruncate(self.fd, len); }
        ret r;
    }
}

// ── Seek origin constants ─────────────────────────────────────────────────────

pub fn seek_set() i32 { ret 0; }
pub fn seek_cur() i32 { ret 1; }
pub fn seek_end() i32 { ret 2; }

// ── Path operations ───────────────────────────────────────────────────────────

// Returns true if path exists and is accessible.
pub fn exists(path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.access(path, 0); }  // F_OK = 0
    ret r == 0;
}

// Returns true if path is readable.
pub fn readable(path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.access(path, 4); }  // R_OK = 4
    ret r == 0;
}

// Returns true if path is writable.
pub fn writable(path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.access(path, 2); }  // W_OK = 2
    ret r == 0;
}

// Delete a file. Returns true on success.
pub fn remove(path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.unlink(path); }
    ret r == 0;
}

// Create a directory. Mode 0o755 = 493. Returns true on success.
pub fn mkdir(path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.mkdir(path, 493); }
    ret r == 0;
}

// Create a directory with explicit mode. Returns true on success.
pub fn mkdir_mode(path: str, mode: u32) bool {
    var r: i32 = 0;
    unsafe { r = unix.mkdir(path, mode); }
    ret r == 0;
}

// Remove an empty directory. Returns true on success.
pub fn rmdir(path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.rmdir(path); }
    ret r == 0;
}

// Rename or move a file. Returns true on success.
pub fn rename(from: str, to: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.rename(from, to); }
    ret r == 0;
}

// Create a hard link. Returns true on success.
pub fn link(existing: str, new_path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.link(existing, new_path); }
    ret r == 0;
}

// Create a symbolic link. Returns true on success.
pub fn symlink(target: str, link_path: str) bool {
    var r: i32 = 0;
    unsafe { r = unix.symlink(target, link_path); }
    ret r == 0;
}

// Change file permissions. Mode 0o644 = 420, 0o755 = 493.
pub fn chmod(path: str, mode: u32) bool {
    var r: i32 = 0;
    unsafe { r = unix.chmod(path, mode); }
    ret r == 0;
}
