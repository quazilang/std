// std.fs — cross-platform file-system operations for Linux and Windows.
//
// File owns its operating-system handle. Whole-program destruction analysis
// finds File.free and inserts it on every lexical exit, including early return.
// Application code normally never calls close/free explicitly.
import std.core;
import std.unix;
@cfg(target_os = "netbsd")
import std.netbsd;
import std.win32_core;
pub import std.path.Path;
pub import std.path.PathBuf;

pub enum FsError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidPath,
    IsDirectory,
    NotDirectory,
    DirectoryNotEmpty,
    ReadOnly,
    NoSpace,
    TooManyOpenFiles,
    AllocationFailed,
    InvalidData,
    Unsupported,
    TooLarge,
    Native(i32),
}

impl FsError {
    pub fn message(self: FsError) str {
        ret match self {
            FsError.NotFound => "file or directory not found",
            FsError.PermissionDenied => "file-system permission denied",
            FsError.AlreadyExists => "file or directory already exists",
            FsError.InvalidPath => "invalid file-system path",
            FsError.IsDirectory => "expected a file, found a directory",
            FsError.NotDirectory => "expected a directory",
            FsError.DirectoryNotEmpty => "directory is not empty",
            FsError.ReadOnly => "file system is read-only",
            FsError.NoSpace => "no space left on device",
            FsError.TooManyOpenFiles => "too many open files",
            FsError.AllocationFailed => "file-system buffer allocation failed",
            FsError.InvalidData => "invalid file-system data",
            FsError.Unsupported => "file-system operation is unsupported",
            FsError.TooLarge => "file exceeds the requested size limit",
            FsError.Native(_) => "unclassified operating-system file error",
        };
    }
}

fn fs_error(code: i32) FsError {
    if (code == -2 || code == 2 || code == 3) { ret FsError.NotFound; }
    if (code == -13 || code == 5) { ret FsError.PermissionDenied; }
    if (code == -17 || code == 80 || code == 183) { ret FsError.AlreadyExists; }
    if (code == -22 || code == 87 || code == 123 || code == 161) { ret FsError.InvalidPath; }
    if (code == -21) { ret FsError.IsDirectory; }
    if (code == -20 || code == 267) { ret FsError.NotDirectory; }
    if (code == -39 || code == 145) { ret FsError.DirectoryNotEmpty; }
    if (code == -30 || code == 19) { ret FsError.ReadOnly; }
    if (code == -28 || code == 112) { ret FsError.NoSpace; }
    if (code == -24 || code == 4) { ret FsError.TooManyOpenFiles; }
    if (code == -12 || code == 8 || code == 14) { ret FsError.AllocationFailed; }
    ret FsError.Native(code);
}

fn last_fs_error() FsError {
    var code: u32 = 0;
    unsafe { code = win32_core.last_error(); }
    ret fs_error(code as i32);
}

// The process's current working directory as an owned path.
pub fn current_dir() Result[String, FsError] {
    var capacity: usize = 4096;
    for (capacity <= 1048576) {
        var buffer: *u8 = 0;
        unsafe { buffer = core.malloc(capacity); }
        if (buffer == 0) { ret Err(FsError.AllocationFailed); }
        var length: isize = -1;
        var retry: bool = false;
        @cfg(target_os = "linux") {
            var result: isize = 0;
            unsafe { result = unix.getcwd(core.str_from_ptr(buffer), capacity); }
            // ERANGE: the path is longer than the buffer.
            if (result == -34) { retry = true; } else if (result < 0) {
                unsafe { core.free(buffer); }
                ret Err(fs_error(result as i32));
            } else { length = result - 1; }
        }
        @cfg(target_os = "netbsd") {
            var result: isize = 0;
            unsafe { result = netbsd.getcwd(core.str_from_ptr(buffer), capacity); }
            if (result == -34) { retry = true; } else if (result < 0) {
                unsafe { core.free(buffer); }
                ret Err(fs_error(result as i32));
            } else { unsafe { length = core.strlen(core.str_from_ptr(buffer)) as isize; } }
        }
        @cfg(target_os = "windows") {
            var written: u32 = 0;
            unsafe { written = win32_core.get_current_directory(capacity as u32, buffer); }
            if (written == 0) {
                unsafe { core.free(buffer); }
                ret Err(last_fs_error());
            }
            // A result >= capacity is the required size including the NUL.
            if ((written as usize) >= capacity) { retry = true; } else { length = written as isize; }
        }
        if (!retry) {
            if (length < 0) { unsafe { core.free(buffer); } ret Err(FsError.Native(-1)); }
            var path: String = String.new();
            unsafe { path = String.from(core.str_from_ptr(buffer)); core.free(buffer); }
            ret Ok(path);
        }
        unsafe { core.free(buffer); }
        capacity = capacity * 2;
    }
    Err(FsError.InvalidPath)
}

// Change the process's current working directory. This affects every thread.
pub fn set_current_dir(path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = 0;
        unsafe { result = unix.chdir(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "netbsd") {
        var result: i32 = 0;
        unsafe { result = netbsd.chdir(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        var result: i32 = 0;
        unsafe { result = win32_core.set_current_directory(core.str_as_ptr(path)); }
        if (result == 0) { ret Err(last_fs_error()); }
        ret Ok(true);
    }
    Err(FsError.Native(-1))
}

@test
fn current_dir_round_trips_through_set_current_dir() void {
    const original: String = current_dir().unwrap();
    if (original.is_empty()) { panic("current directory is empty"); }
    if (set_current_dir("/").is_err()) { panic("cannot change to the root directory"); }
    const root: String = current_dir().unwrap();
    if (root.as_str() != "/") { panic("current_dir did not report the new directory"); }
    if (set_current_dir("/definitely/not/a/real/directory/quazi").is_ok()) { panic("missing directory accepted"); }
    if (set_current_dir(original.as_str()).is_err()) { panic("cannot restore the original directory"); }
}

// Private ownership adapters keep raw buffers and directory handles inside the
// same automatic-destruction model exposed by File and String.
struct FsRawBuffer {
    data: *u8,
}

impl FsRawBuffer {
    unsafe fn take(self: FsRawBuffer) *u8 {
        const data: *u8 = self.data;
        self.data = 0;
        ret data;
    }

    fn free(self: FsRawBuffer) void {
        if (self.data != 0) { unsafe { core.free(self.data); } }
        self.data = 0;
    }
}

struct DirectoryScan {
    handle: isize,
    data: *u8,
}

impl DirectoryScan {
    fn free(self: DirectoryScan) void {
        @cfg(target_os = "linux") {
            if (self.handle >= 0) { unsafe { unix.close(self.handle as i32); } }
        }
        @cfg(target_os = "netbsd") {
            if (self.handle >= 0) { unsafe { netbsd.close(self.handle as i32); } }
        }
        @cfg(target_os = "windows") {
            if (self.handle != -1) {
                unsafe { win32_core.find_close(self.handle as usize); }
            }
        }
        if (self.data != 0) { unsafe { core.free(self.data); } }
        self.handle = -1;
        self.data = 0;
    }
}

unsafe fn is_dot_entry(name: *u8) bool {
    if (*name != 46) { ret false; }
    if (*(name + 1) == 0) { ret true; }
    ret *(name + 1) == 46 && *(name + 2) == 0;
}

pub struct File {
    handle: isize,
}

impl File {
    // Open an existing file for reading.
    pub fn open(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 0, 0);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "netbsd") {
            unsafe {
                const fd: i32 = netbsd.open(path, 0, 0);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 2147483648 as u32, 3, 0, 3, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(last_fs_error()); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Create or truncate a file for writing.
    pub fn create(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 577, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "netbsd") {
            unsafe {
                const fd: i32 = netbsd.open(path, 577, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 1073741824, 3, 0, 2, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(last_fs_error()); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Open for reading and writing, creating the file when needed.
    pub fn open_rw(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 66, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "netbsd") {
            unsafe {
                const fd: i32 = netbsd.open(path, 66, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 3221225472 as u32, 3, 0, 4, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(last_fs_error()); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Open for append, creating the file when needed.
    pub fn open_append(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 1089, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "netbsd") {
            unsafe {
                const fd: i32 = netbsd.open(path, 1089, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            const opened: Result[File, FsError] = File.open_rw(path);
            if (opened.is_err()) { ret Err(opened.unwrap_err()); }
            var file: File = opened.unwrap();
            const position: Result[i64, FsError] = file.seek(0, 2);
            if (position.is_err()) { ret Err(position.unwrap_err()); }
            ret Ok(file);
        }
        ret Err(FsError.Unsupported);
    }

    // Raw buffer read. The caller guarantees `buf` is writable for `n` bytes.
    pub unsafe fn read(self: &File!, buf: *u8, n: usize) isize {
        @cfg(target_os = "linux") {
            ret core.read(self.handle as i32, buf, n);
        }
        @cfg(target_os = "netbsd") {
            ret netbsd.read(self.handle as i32, buf, n);
        }
        @cfg(target_os = "windows") {
            var count: u32 = 0;
            const ok: i32 = win32_core.read_file(
                self.handle as usize, buf, n as u32, &count, 0
            );
            if (ok == 0) { ret -1; }
            ret count as isize;
        }
        ret -1;
    }

    pub fn write(self: &File!, buf: bytes) Result[usize, FsError] {
        var result: isize = -1;
        unsafe { result = self.write_raw(buf.as_ptr(), buf.len()); }
        if (result < 0) {
            @cfg(target_os = "windows") { ret Err(last_fs_error()); }
            ret Err(fs_error(result as i32));
        }
        ret Ok(result as usize);
    }

    // Raw buffer write. The caller guarantees `buf` is readable for `n` bytes.
    pub unsafe fn write_raw(self: &File!, buf: *u8, n: usize) isize {
        @cfg(target_os = "linux") {
            ret core.write_bytes(self.handle as i32, buf, n);
        }
        @cfg(target_os = "netbsd") {
            ret netbsd.write(self.handle as i32, buf, n);
        }
        @cfg(target_os = "windows") {
            var count: u32 = 0;
            const ok: i32 = win32_core.write_file(
                self.handle as usize, buf, n as u32, &count, 0
            );
            if (ok == 0) { ret -1; }
            ret count as isize;
        }
        ret -1;
    }

    pub fn write_str(self: &File!, text: str) Result[usize, FsError] {
        var result: isize = -1;
        unsafe { result = self.write_raw(core.str_as_ptr(text), core.strlen(text)); }
        if (result < 0) {
            @cfg(target_os = "windows") { ret Err(last_fs_error()); }
            ret Err(fs_error(result as i32));
        }
        ret Ok(result as usize);
    }

    // Explicit close is available for scarce-resource handoff. It invalidates
    // this File, so the later automatic destructor is a harmless no-op.
    pub fn close(self: &File!) Result[bool, FsError] {
        if (self.handle == -1) { ret Ok(false); }
        var result: i32 = 0;
        @cfg(target_os = "linux") {
            unsafe { result = unix.close(self.handle as i32); }
        }
        @cfg(target_os = "netbsd") {
            unsafe { result = netbsd.close(self.handle as i32); }
        }
        @cfg(target_os = "windows") {
            unsafe {
                if (win32_core.close_handle(self.handle as usize) == 0) {
                    const error: FsError = last_fs_error();
                    self.handle = -1;
                    ret Err(error);
                }
            }
        }
        self.handle = -1;
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }

    // Destructor discovered by whole-program analysis.
    pub fn free(self: File) void {
        self.close();
    }

    pub fn seek(self: &File!, offset: i64, whence: i32) Result[i64, FsError] {
        @cfg(target_os = "linux") {
            var position: i64 = -1;
            unsafe { position = unix.lseek(self.handle as i32, offset, whence); }
            if (position < 0) { ret Err(fs_error(position as i32)); }
            ret Ok(position);
        }
        @cfg(target_os = "netbsd") {
            var position: i64 = -1;
            unsafe { position = netbsd.lseek(self.handle as i32, offset, whence); }
            if (position < 0) { ret Err(fs_error(position as i32)); }
            ret Ok(position);
        }
        @cfg(target_os = "windows") {
            var position: i64 = 0;
            unsafe {
                const ok: i32 = win32_core.seek(
                    self.handle as usize, offset, &position, whence as u32
                );
                if (ok == 0) { ret Err(last_fs_error()); }
                ret Ok(position);
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Linux descriptor, or a truncated Windows HANDLE for compatibility.
    pub fn fd(self: &File) i32 { ret self.handle as i32; }
    pub fn raw_handle(self: &File) usize { ret self.handle as usize; }

    pub fn sync(self: &File!) Result[bool, FsError] {
        @cfg(target_os = "linux") {
            var result: i32 = -1;
            unsafe { result = unix.fsync(self.handle as i32); }
            if (result < 0) { ret Err(fs_error(result)); }
            ret Ok(true);
        }
        @cfg(target_os = "netbsd") {
            var result: i32 = -1;
            unsafe { result = netbsd.fsync(self.handle as i32); }
            if (result < 0) { ret Err(fs_error(result)); }
            ret Ok(true);
        }
        @cfg(target_os = "windows") {
            unsafe {
                if (win32_core.sync(self.handle as usize) == 0) { ret Err(last_fs_error()); }
            }
            ret Ok(true);
        }
        ret Err(FsError.Unsupported);
    }

    // File truncation is currently implemented by the Linux backend.
    pub fn truncate(self: &File!, len: i64) Result[bool, FsError] {
        @cfg(target_os = "linux") {
            var result: i32 = -1;
            unsafe { result = unix.ftruncate(self.handle as i32, len); }
            if (result < 0) { ret Err(fs_error(result)); }
            ret Ok(true);
        }
        @cfg(target_os = "netbsd") {
            var result: i32 = -1;
            unsafe { result = netbsd.ftruncate(self.handle as i32, len); }
            if (result < 0) { ret Err(fs_error(result)); }
            ret Ok(true);
        }
        ret Err(FsError.Unsupported);
    }
}

pub fn seek_set() i32 { ret 0; }
pub fn seek_cur() i32 { ret 1; }
pub fn seek_end() i32 { ret 2; }

// Read a UTF-8 text file into an owned String. File closure is automatic on
// success and every error path; only the private raw staging allocation needs
// explicit release before it has been promoted into String ownership.
pub fn read_to_string(path: str) Result[String, FsError] {
    read_to_string_with_limit(path, 18446744073709551615)
}

// Read a whole UTF-8 file of at most `max_bytes` bytes. A larger file fails
// with TooLarge after reading at most `max_bytes + 1` bytes, so untrusted
// paths cannot force unbounded allocation.
pub fn read_to_string_with_limit(path: str, max_bytes: usize) Result[String, FsError] {
    const opened: Result[File, FsError] = File.open(path);
    if (opened.is_err()) { ret Err(opened.unwrap_err()); }
    var file: File = opened.unwrap();
    var capacity: usize = 4096;
    var length: usize = 0;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity + 1); }
    if (buffer.data == 0) { ret Err(FsError.AllocationFailed); }

    for (true) {
        if (length == capacity) {
            capacity = capacity * 2;
            var grown: *u8 = 0;
            unsafe { grown = core.realloc(buffer.data, capacity + 1); }
            if (grown == 0) { ret Err(FsError.AllocationFailed); }
            buffer.data = grown;
        }
        // Never request more than one byte past the limit.
        var request: usize = capacity - length;
        if (max_bytes - length < request) { request = max_bytes - length + 1; }
        var count: isize = -1;
        unsafe { count = file.read(buffer.data + length, request); }
        if (count < 0) {
            @cfg(target_os = "windows") { ret Err(last_fs_error()); }
            ret Err(fs_error(count as i32));
        }
        if (count == 0) { break; }
        length = length + count as usize;
        if (length > max_bytes) { ret Err(FsError.TooLarge); }
    }
    var valid: bool = false;
    unsafe { valid = core.is_valid_utf8(buffer.data, length); }
    if (!valid) { ret Err(FsError.InvalidData); }
    unsafe { *(buffer.data + length) = 0; }
    var result: String = String.new();
    unsafe { result = String.from_raw(buffer.take(), length, capacity + 1); }
    ret Ok(result);
}

pub fn exists(path: str) bool {
    @cfg(target_os = "linux") {
        unsafe { ret unix.access(path, 0) == 0; }
    }
        @cfg(target_os = "netbsd") {
        unsafe { ret netbsd.access(path, 0) == 0; }
    }
    @cfg(target_os = "windows") {
        unsafe {
            ret win32_core.file_attributes(core.str_as_ptr(path)) != 4294967295 as u32;
        }
    }
    ret false;
}

pub fn readable(path: str) bool {
    const opened: Result[File, FsError] = File.open(path);
    if (opened.is_err()) { ret false; }
    const file: File = opened.unwrap();
    ret true;
}

// Count immediate directory entries, excluding `.` and `..`. The scan buffer
// and OS enumeration handle are closed automatically on success and errors.
pub fn count_entries(path: str) Result[usize, FsError] {
    const capacity: usize = 4096;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity); }
    if (buffer.data == 0) { ret Err(FsError.AllocationFailed); }

    @cfg(target_os = "linux") {
        var fd: i32 = -1;
        unsafe { fd = unix.open(path, 65536, 0); }
        if (fd < 0) { ret Err(fs_error(fd)); }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: fd as isize,
            data: scan_data,
        };
        var count: usize = 0;
        for (true) {
            var batch_size: isize = -1;
            unsafe { batch_size = unix.getdents64(fd, scan.data, capacity); }
            if (batch_size < 0) { ret Err(fs_error(batch_size as i32)); }
            if (batch_size == 0) { break; }
            var offset: usize = 0;
            for (offset < batch_size as usize) {
                var record_length: usize = 0;
                unsafe {
                    record_length = (*(scan.data + offset + 16)) as usize;
                    record_length = record_length
                        + (((*(scan.data + offset + 17)) as usize) << 8);
                }
                if (record_length < 20 || offset + record_length > batch_size as usize) {
                    ret Err(FsError.InvalidData);
                }
                unsafe {
                    if (!is_dot_entry(scan.data + offset + 19)) { count++; }
                }
                offset = offset + record_length;
            }
        }
        ret Ok(count);
    }

    @cfg(target_os = "netbsd") {
        var raw_dir: *u8 = 0;
        unsafe { raw_dir = netbsd.opendir(path); }
        if (raw_dir == 0) {
            var error: i32 = 0;
            unsafe { error = netbsd.errno_value(); }
            ret Err(fs_error(-error));
        }
        var count: usize = 0;
        for (true) {
            var entry: *u8 = 0;
            unsafe { entry = netbsd.readdir(raw_dir); }
            if (entry == 0) { break; }
            // NetBSD 11 sys/dirent.h: ino_t(8), reclen(2), namlen(2),
            // d_type(1), then d_name at byte offset 13.
            var name: *u8 = entry + 13;
            unsafe { if (!is_dot_entry(name)) { count++; } }
        }
        unsafe { netbsd.closedir(raw_dir); }
        ret Ok(count);
    }

    @cfg(target_os = "windows") {
        var pattern: String = String.from(path);
        pattern = pattern.push_str("\\*");
        var raw_handle: usize = 0;
        unsafe {
            raw_handle = win32_core.find_first(
                core.str_as_ptr(pattern.as_str()), buffer.data
            );
        }
        const handle: isize = raw_handle as isize;
        if (handle == -1) {
            var error: u32 = 0;
            unsafe { error = win32_core.last_error(); }
            if (error == 2 || error == 18) { ret Ok(0); }
            ret Err(fs_error(error as i32));
        }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: handle,
            data: scan_data,
        };
        var count: usize = 0;
        for (true) {
            unsafe {
                if (!is_dot_entry(scan.data + 44)) { count++; }
                if (win32_core.find_next(raw_handle, scan.data) == 0) { break; }
            }
        }
        ret Ok(count);
    }

    ret Err(FsError.Unsupported);
}

// Names of the immediate entries of a directory, excluding `.` and `..`, in
// the order the operating system reports them. Names are copied into owned
// strings; the scan buffer and OS enumeration handle are closed on success
// and errors.
pub fn read_dir_names(path: str) Result[Array[String], FsError] {
    const capacity: usize = 4096;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity); }
    if (buffer.data == 0) { ret Err(FsError.AllocationFailed); }
    var names: Array[String] = Array.new();

    @cfg(target_os = "linux") {
        var fd: i32 = -1;
        unsafe { fd = unix.open(path, 65536, 0); }
        if (fd < 0) { ret Err(fs_error(fd)); }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: fd as isize,
            data: scan_data,
        };
        for (true) {
            var batch_size: isize = -1;
            unsafe { batch_size = unix.getdents64(fd, scan.data, capacity); }
            if (batch_size < 0) { ret Err(fs_error(batch_size as i32)); }
            if (batch_size == 0) { break; }
            var offset: usize = 0;
            for (offset < batch_size as usize) {
                var record_length: usize = 0;
                unsafe {
                    record_length = (*(scan.data + offset + 16)) as usize;
                    record_length = record_length
                        + (((*(scan.data + offset + 17)) as usize) << 8);
                }
                if (record_length < 20 || offset + record_length > batch_size as usize) {
                    ret Err(FsError.InvalidData);
                }
                unsafe {
                    const name: *u8 = scan.data + offset + 19;
                    if (!is_dot_entry(name)) { names.push(String.from(core.str_from_ptr(name))); }
                }
                offset = offset + record_length;
            }
        }
        ret Ok(names);
    }

    @cfg(target_os = "netbsd") {
        var raw_dir: *u8 = 0;
        unsafe { raw_dir = netbsd.opendir(path); }
        if (raw_dir == 0) {
            var error: i32 = 0;
            unsafe { error = netbsd.errno_value(); }
            ret Err(fs_error(-error));
        }
        for (true) {
            var entry: *u8 = 0;
            unsafe { entry = netbsd.readdir(raw_dir); }
            if (entry == 0) { break; }
            // d_name at byte offset 13 (see count_entries).
            var name: *u8 = entry + 13;
            unsafe {
                if (!is_dot_entry(name)) { names.push(String.from(core.str_from_ptr(name))); }
            }
        }
        unsafe { netbsd.closedir(raw_dir); }
        ret Ok(names);
    }

    @cfg(target_os = "windows") {
        var pattern: String = String.from(path);
        pattern = pattern.push_str("\\*");
        var raw_handle: usize = 0;
        unsafe {
            raw_handle = win32_core.find_first(
                core.str_as_ptr(pattern.as_str()), buffer.data
            );
        }
        const handle: isize = raw_handle as isize;
        if (handle == -1) {
            var error: u32 = 0;
            unsafe { error = win32_core.last_error(); }
            if (error == 2 || error == 18) { ret Ok(names); }
            ret Err(fs_error(error as i32));
        }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: handle,
            data: scan_data,
        };
        for (true) {
            unsafe {
                // WIN32_FIND_DATAA.cFileName starts at byte offset 44.
                const name: *u8 = scan.data + 44;
                if (!is_dot_entry(name)) { names.push(String.from(core.str_from_ptr(name))); }
                if (win32_core.find_next(raw_handle, scan.data) == 0) { break; }
            }
        }
        ret Ok(names);
    }

    ret Err(FsError.Unsupported);
}

// What a path names, as reported by the operating system.
pub enum FileType {
    File,
    Directory,
    Symlink,
    Other,
}

// Size, kind, write protection and modification time of a file-system entry.
pub struct Metadata {
    size: u64,
    // 0 file, 1 directory, 2 symbolic link, 3 other.
    kind_code: u8,
    readonly: bool,
    modified_nanos: i64,
}

impl Metadata {
    pub fn len(self: &Metadata) u64 { ret self.size; }
    pub fn file_type(self: &Metadata) FileType { file_type_of(self.kind_code) }
    pub fn is_file(self: &Metadata) bool { ret self.kind_code == 0; }
    pub fn is_dir(self: &Metadata) bool { ret self.kind_code == 1; }
    pub fn is_symlink(self: &Metadata) bool { ret self.kind_code == 2; }
    // No write permission bit for anyone (Linux) or the read-only attribute
    // (Windows).
    pub fn readonly(self: &Metadata) bool { ret self.readonly; }
    // Last modification as nanoseconds since 1970-01-01 UTC.
    pub fn modified_unix_nanos(self: &Metadata) i64 { ret self.modified_nanos; }
}

// Metadata of the entry `path` names, following symbolic links.
pub fn metadata(path: str) Result[Metadata, FsError] { ret fs_metadata(path, true); }

// Metadata of `path` itself: a symbolic link reports FileType.Symlink.
pub fn symlink_metadata(path: str) Result[Metadata, FsError] { ret fs_metadata(path, false); }

fn fs_metadata(path: str, follow: bool) Result[Metadata, FsError] {
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(160); }
    if (buffer.data == 0) { ret Err(FsError.AllocationFailed); }

    @cfg(target_os = "linux") {
        // struct stat (x86-64): st_mode u32 at 24, st_size i64 at 48,
        // st_mtime seconds/nanoseconds at 88/96.
        var status: i32 = 0;
        unsafe {
            if (follow) { status = unix.stat(path, buffer.data); }
            else { status = unix.lstat(path, buffer.data); }
        }
        if (status < 0) { ret Err(fs_error(status)); }
        var mode: u32 = 0;
        var size: i64 = 0;
        var seconds: i64 = 0;
        var nanos: i64 = 0;
        unsafe {
            mode = *((buffer.data + 24) as *u32);
            size = *((buffer.data + 48) as *i64);
            seconds = *((buffer.data + 88) as *i64);
            nanos = *((buffer.data + 96) as *i64);
        }
        const format: u32 = mode & 61440;
        var kind: u8 = 3;
        if (format == 32768) { kind = 0; }
        else if (format == 16384) { kind = 1; }
        else if (format == 40960) { kind = 2; }
        ret Ok(Metadata {
            size: size as u64,
            kind_code: kind,
            readonly: (mode & 146) == 0,
            modified_nanos: seconds * 1000000000 + nanos,
        });
    }

    @cfg(target_os = "windows") {
        // Windows reports links as reparse points on the link itself only;
        // following them needs a handle, so both forms read the entry.
        var status: i32 = 0;
        const text: String = String.from(path);
        unsafe {
            status = win32_core.file_attribute_data(core.str_as_ptr(text.as_str()), 0, buffer.data);
        }
        if (status == 0) {
            var error: u32 = 0;
            unsafe { error = win32_core.last_error(); }
            ret Err(fs_error(error as i32));
        }
        var attributes: u32 = 0;
        var write_low: u64 = 0;
        var write_high: u64 = 0;
        var size_high: u64 = 0;
        var size_low: u64 = 0;
        unsafe {
            attributes = *(buffer.data as *u32);
            write_low = (*((buffer.data + 20) as *u32)) as u64;
            write_high = (*((buffer.data + 24) as *u32)) as u64;
            size_high = (*((buffer.data + 28) as *u32)) as u64;
            size_low = (*((buffer.data + 32) as *u32)) as u64;
        }
        var kind: u8 = 0;
        if ((attributes & 1024) != 0 && !follow) { kind = 2; }
        else if ((attributes & 16) != 0) { kind = 1; }
        // FILETIME counts 100 ns since 1601-01-01.
        const ticks: u64 = (write_high << 32) | write_low;
        const unix_ticks: i64 = (ticks as i64) - 116444736000000000;
        ret Ok(Metadata {
            size: (size_high << 32) | size_low,
            kind_code: kind,
            readonly: (attributes & 1) != 0,
            modified_nanos: unix_ticks * 100,
        });
    }

    ret Err(FsError.Unsupported);
}

fn joined(base: str, name: str) String {
    if (base.is_empty()) { ret String.from(name); }
    String.from(base).push_str("/").push_str(name)
}

// Every entry below `root` as a path relative to it (`a`, `a/b.txt`, ...),
// depth first. Directories are listed before their contents; symbolic links
// are reported but not followed, so cycles cannot recur. `/` separates the
// components on every platform (Windows accepts it too). An empty root is the
// current directory. The root must be readable; a subdirectory that cannot be
// listed (for example without permission) is reported but not entered.
pub fn walk(root_path: str) Result[Array[String], FsError] {
    const root: str = if (root_path.is_empty()) { "." } else { root_path };
    var found: Array[String] = Array.new();
    var pending: Array[String] = Array.new();
    pending.push(String.new());
    for (pending.len() > 0) {
        const last: usize = pending.len() - 1;
        const relative: String = pending.remove(last);
        const directory: String = joined(root, relative.as_str());
        const listed = read_dir_names(directory.as_str());
        if (listed.is_err()) {
            if (relative.is_empty()) { ret Err(listed.unwrap_err()); }
            continue;
        }
        var names: Array[String] = listed.unwrap();
        for (names.len() > 0) {
            const name: String = names.remove(0);
            const child: String = joined(relative.as_str(), name.as_str());
            const full: String = joined(root, child.as_str());
            const info: Metadata = symlink_metadata(full.as_str())?;
            if (info.is_dir()) { pending.push(String.from(child.as_str())); }
            found.push(child);
        }
    }
    Ok(found)
}

// ── Buffered I/O ────────────────────────────────────────────────────────────

// Size of the LineReader and BufferedWriter buffers.
fn buffer_size() usize { 65536 }

// Reads a file line by line through one 64 KiB buffer. Lines end at `\n`
// (a preceding `\r` is dropped too); the last line needs no terminator.
// Every line must be valid UTF-8.
pub struct LineReader {
    file: File,
    buffer: *u8,
    start: usize,
    end: usize,
    done: bool,
}

impl LineReader {
    pub fn open(path: str) Result[LineReader, FsError] {
        const file: File = File.open(path)?;
        var buffer: *u8 = 0;
        unsafe { buffer = core.malloc(buffer_size()); }
        if (buffer == 0) { ret Err(FsError.AllocationFailed); }
        Ok(LineReader { file: file, buffer: buffer, start: 0, end: 0, done: false })
    }

    // The next line without its terminator, or None at the end of the file.
    pub fn read_line(self: &LineReader!) Result[Option[String], FsError] {
        var line: *u8 = 0;
        var length: usize = 0;
        var capacity: usize = 0;
        var found: bool = false;
        for (!found) {
            if (self.start == self.end) {
                if (self.done) { break; }
                var count: isize = 0;
                const target: *u8 = self.buffer;
                unsafe { count = self.file.read(target, buffer_size()); }
                if (count < 0) {
                    unsafe { if (line != 0) { core.free(line); } }
                    @cfg(target_os = "windows") { ret Err(last_fs_error()); }
                    ret Err(fs_error(count as i32));
                }
                if (count == 0) {
                    self.done = true;
                    break;
                }
                self.start = 0;
                self.end = count as usize;
            }
            // Copy up to the next newline (or the buffered rest) into `line`.
            var stop: usize = self.start;
            unsafe {
                for (stop < self.end && *(self.buffer + stop) != 10) { stop = stop + 1; }
            }
            const piece: usize = stop - self.start;
            if (length + piece + 1 > capacity) {
                var grown: usize = capacity * 2;
                if (grown < length + piece + 1) { grown = length + piece + 1; }
                if (grown < 64) { grown = 64; }
                unsafe { line = core.realloc(line, grown); }
                if (line == 0) { ret Err(FsError.AllocationFailed); }
                capacity = grown;
            }
            unsafe { core.memcpy(line + length, self.buffer + self.start, piece); }
            length = length + piece;
            if (stop < self.end) {
                found = true;
                self.start = stop + 1;
            } else {
                self.start = self.end;
            }
        }
        if (!found && length == 0) {
            unsafe { if (line != 0) { core.free(line); } }
            ret Ok(None);
        }
        if (line == 0) {
            unsafe { line = core.malloc(1); }
            if (line == 0) { ret Err(FsError.AllocationFailed); }
            capacity = 1;
        }
        unsafe {
            if (length > 0 && *(line + length - 1) == 13) { length = length - 1; }
            *(line + length) = 0;
            if (!core.is_valid_utf8(line, length)) {
                core.free(line);
                ret Err(FsError.InvalidData);
            }
        }
        var text: String = String.new();
        unsafe { text = String.from_raw(line, length, capacity); }
        Ok(Some(text))
    }

    // Closes the file now (dropping the reader does it otherwise); later
    // reads report the end of the file.
    pub fn close(self: &LineReader!) Result[bool, FsError] {
        self.done = true;
        self.start = self.end;
        self.file.close()
    }

    pub fn free(self: LineReader) void {
        if (self.buffer != 0) { unsafe { core.free(self.buffer); } }
        self.buffer = 0;
        self.file.close();
    }
}

// Collects writes in a 64 KiB buffer and hands them to the file in large
// pieces. `flush` reports write errors; dropping the writer flushes what is
// left (ignoring errors, like closing a file) and closes the file.
pub struct BufferedWriter {
    file: File,
    buffer: *u8,
    used: usize,
}

impl BufferedWriter {
    pub fn create(path: str) Result[BufferedWriter, FsError] {
        const file: File = File.create(path)?;
        var buffer: *u8 = 0;
        unsafe { buffer = core.malloc(buffer_size()); }
        if (buffer == 0) { ret Err(FsError.AllocationFailed); }
        Ok(BufferedWriter { file: file, buffer: buffer, used: 0 })
    }

    unsafe fn write_all(self: &BufferedWriter!, data: *u8, length: usize) Result[bool, FsError] {
        var offset: usize = 0;
        for (offset < length) {
            const written: isize = self.file.write_raw(data + offset, length - offset);
            if (written <= 0) {
                @cfg(target_os = "windows") { ret Err(last_fs_error()); }
                ret Err(fs_error(written as i32));
            }
            offset = offset + (written as usize);
        }
        Ok(true)
    }

    pub fn write_str(self: &BufferedWriter!, text: str) Result[usize, FsError] {
        const length: usize = text.bytes_len();
        unsafe {
            const data: *u8 = core.str_as_ptr(text);
            if (self.used + length > buffer_size()) {
                self.flush()?;
            }
            if (length >= buffer_size()) {
                self.write_all(data, length)?;
                ret Ok(length);
            }
            core.memcpy(self.buffer + self.used, data, length);
        }
        self.used = self.used + length;
        Ok(length)
    }

    // Hands the buffered bytes to the operating system. After an error the
    // bytes not yet written stay buffered for a later flush.
    pub fn flush(self: &BufferedWriter!) Result[bool, FsError] {
        const pending: usize = self.used;
        const data: *u8 = self.buffer;
        var offset: usize = 0;
        for (offset < pending) {
            var written: isize = 0;
            unsafe { written = self.file.write_raw(data + offset, pending - offset); }
            if (written <= 0) {
                unsafe { core.memmove(data, data + offset, pending - offset); }
                self.used = pending - offset;
                @cfg(target_os = "windows") { ret Err(last_fs_error()); }
                if (written == 0) { ret Err(FsError.InvalidData); }
                ret Err(fs_error(written as i32));
            }
            offset = offset + (written as usize);
        }
        self.used = 0;
        Ok(true)
    }

    // Flushes and closes the file, reporting either failure.
    pub fn close(self: &BufferedWriter!) Result[bool, FsError] {
        self.flush()?;
        self.file.close()
    }

    pub fn free(self: BufferedWriter) void {
        if (self.buffer != 0) {
            // Best effort, like closing a file: errors cannot be reported here.
            if (self.used > 0) { self.flush(); }
            unsafe { core.free(self.buffer); }
        }
        self.buffer = 0;
        self.file.close();
    }
}

fn file_type_of(code: u8) FileType {
    if (code == 0) { ret FileType.File; }
    if (code == 1) { ret FileType.Directory; }
    if (code == 2) { ret FileType.Symlink; }
    FileType.Other
}

// ── Directory entries ───────────────────────────────────────────────────────

// One entry of a directory listing: its name, its path (the listed
// directory joined with the name) and its type as the listing reported it.
pub struct DirEntry {
    name: String,
    path: String,
    // 0 file, 1 directory, 2 symbolic link, 3 other (see Metadata).
    kind_code: u8,
}

impl DirEntry {
    pub fn name(self: &DirEntry) str { ret self.name.as_str(); }
    pub fn path(self: &DirEntry) Path { Path.new(self.path.as_str()) }
    pub fn path_str(self: &DirEntry) str { ret self.path.as_str(); }
    pub fn file_type(self: &DirEntry) FileType { file_type_of(self.kind_code) }
    pub fn is_file(self: &DirEntry) bool { ret self.kind_code == 0; }
    pub fn is_dir(self: &DirEntry) bool { ret self.kind_code == 1; }
    pub fn is_symlink(self: &DirEntry) bool { ret self.kind_code == 2; }
    // Metadata of the entry itself (a link is not followed).
    pub fn metadata(self: &DirEntry) Result[Metadata, FsError] {
        symlink_metadata(self.path.as_str())
    }
}

// The entries of one directory, in operating-system order; iterate it with
// `for entry : fs.read_dir(path)? { ... }`.
pub struct ReadDir {
    // Stored last-first so `next` removes from the end.
    pending: Array[DirEntry],
}

impl ReadDir {
    pub fn has_next(self: &ReadDir) bool { ret self.pending.len() > 0; }

    pub fn next(self: &ReadDir!) Option[DirEntry] {
        if (self.pending.len() == 0) { ret None; }
        const last: usize = self.pending.len() - 1;
        Some(self.pending.remove(last))
    }

    // Entries not yet returned.
    pub fn len(self: &ReadDir) usize { ret self.pending.len(); }
}

fn entry_path(directory: str, name: str) String {
    var text: String = String.from(directory);
    if (!directory.is_empty() && !directory.ends_with("/") && !directory.ends_with("\\")) {
        var separator: str = "/";
        @cfg(target_os = "windows") { separator = "\\"; }
        text = text.push_str(separator);
    }
    text.push_str(name)
}

// Maps a `d_type` value (Linux/NetBSD) to the entry kind code; 0 (unknown)
// asks the file system.
fn dirent_kind(d_type: u8, path: str) u8 {
    if (d_type == 8) { ret 0; }
    if (d_type == 4) { ret 1; }
    if (d_type == 10) { ret 2; }
    if (d_type != 0) { ret 3; }
    const info = symlink_metadata(path);
    if (info.is_err()) { ret 3; }
    if (info.unwrap().is_symlink()) { ret 2; }
    const followed = symlink_metadata(path);
    if (followed.is_err()) { ret 3; }
    const resolved: Metadata = followed.unwrap();
    if (resolved.is_dir()) { ret 1; }
    if (resolved.is_file()) { ret 0; }
    3
}

// The immediate entries of a directory (without `.` and `..`).
pub fn read_dir(path: str) Result[ReadDir, FsError] {
    const directory: str = if (path.is_empty()) { "." } else { path };
    const capacity: usize = 4096;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity); }
    if (buffer.data == 0) { ret Err(FsError.AllocationFailed); }
    var entries: Array[DirEntry] = Array.new();

    @cfg(target_os = "linux") {
        var fd: i32 = -1;
        unsafe { fd = unix.open(directory, 65536, 0); }
        if (fd < 0) { ret Err(fs_error(fd)); }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan { handle: fd as isize, data: scan_data };
        for (true) {
            var batch_size: isize = -1;
            unsafe { batch_size = unix.getdents64(fd, scan.data, capacity); }
            if (batch_size < 0) { ret Err(fs_error(batch_size as i32)); }
            if (batch_size == 0) { break; }
            var offset: usize = 0;
            for (offset < batch_size as usize) {
                var record_length: usize = 0;
                var d_type: u8 = 0;
                unsafe {
                    record_length = (*(scan.data + offset + 16)) as usize;
                    record_length = record_length + (((*(scan.data + offset + 17)) as usize) << 8);
                    d_type = *(scan.data + offset + 18);
                }
                if (record_length < 20 || offset + record_length > batch_size as usize) {
                    ret Err(FsError.InvalidData);
                }
                unsafe {
                    const name: *u8 = scan.data + offset + 19;
                    if (!is_dot_entry(name)) {
                        const text: str = core.str_from_ptr(name);
                        const full: String = entry_path(directory, text);
                        const kind: u8 = dirent_kind(d_type, full.as_str());
                        entries.push(DirEntry { name: String.from(text), path: full, kind_code: kind });
                    }
                }
                offset = offset + record_length;
            }
        }
    }

    @cfg(target_os = "netbsd") {
        var raw_dir: *u8 = 0;
        unsafe { raw_dir = netbsd.opendir(directory); }
        if (raw_dir == 0) {
            var error: i32 = 0;
            unsafe { error = netbsd.errno_value(); }
            ret Err(fs_error(-error));
        }
        for (true) {
            var entry: *u8 = 0;
            unsafe { entry = netbsd.readdir(raw_dir); }
            if (entry == 0) { break; }
            unsafe {
                // NetBSD 11 sys/dirent.h: d_type at byte 12, d_name at 13.
                const name: *u8 = entry + 13;
                if (!is_dot_entry(name)) {
                    const text: str = core.str_from_ptr(name);
                    const full: String = entry_path(directory, text);
                    const kind: u8 = dirent_kind(*(entry + 12), full.as_str());
                    entries.push(DirEntry { name: String.from(text), path: full, kind_code: kind });
                }
            }
        }
        unsafe { netbsd.closedir(raw_dir); }
    }

    @cfg(target_os = "windows") {
        var pattern: String = String.from(directory);
        pattern = pattern.push_str("\\*");
        var raw_handle: usize = 0;
        unsafe {
            raw_handle = win32_core.find_first(core.str_as_ptr(pattern.as_str()), buffer.data);
        }
        const handle: isize = raw_handle as isize;
        if (handle == -1) {
            var error: u32 = 0;
            unsafe { error = win32_core.last_error(); }
            if (error != 2 && error != 18) { ret Err(fs_error(error as i32)); }
        } else {
            var scan_data: *u8 = 0;
            unsafe { scan_data = buffer.take(); }
            const scan: DirectoryScan = DirectoryScan { handle: handle, data: scan_data };
            for (true) {
                unsafe {
                    // WIN32_FIND_DATAA: attributes at 0, cFileName at 44.
                    const name: *u8 = scan.data + 44;
                    if (!is_dot_entry(name)) {
                        const attributes: u32 = *(scan.data as *u32);
                        var kind: u8 = 0;
                        if ((attributes & 1024) != 0) { kind = 2; }
                        else if ((attributes & 16) != 0) { kind = 1; }
                        const text: str = core.str_from_ptr(name);
                        entries.push(DirEntry {
                            name: String.from(text),
                            path: entry_path(directory, text),
                            kind_code: kind,
                        });
                    }
                    if (win32_core.find_next(raw_handle, scan.data) == 0) { break; }
                }
            }
        }
    }

    // Reverse into last-first order for ReadDir.next.
    var pending: Array[DirEntry] = Array.new();
    for (entries.len() > 0) {
        const last: usize = entries.len() - 1;
        pending.push(entries.remove(last));
    }
    Ok(ReadDir { pending: pending })
}

pub fn is_dir(path: str) bool {
    const info = metadata(path);
    if (info.is_err()) { ret false; }
    info.unwrap().is_dir()
}

pub fn is_file(path: str) bool {
    const info = metadata(path);
    if (info.is_err()) { ret false; }
    info.unwrap().is_file()
}

pub fn is_symlink(path: str) bool {
    const info = symlink_metadata(path);
    if (info.is_err()) { ret false; }
    info.unwrap().is_symlink()
}

// Creates `path` and every missing parent; an existing directory is fine.
pub fn create_dir_all(path: str) Result[bool, FsError] {
    if (path.is_empty()) { ret Err(FsError.InvalidPath); }
    if (is_dir(path)) { ret Ok(false); }
    const length: usize = path.len();
    var index: usize = 1;
    for (index <= length) {
        const at_end: bool = index == length;
        var boundary: bool = at_end;
        if (!at_end) {
            const piece: String = path[index:index + 1];
            boundary = piece.as_str() == "/" || piece.as_str() == "\\";
        }
        if (boundary) {
            const prefix: String = path[0:index];
            const text = prefix.as_str();
            // Skip roots and drive prefixes (`/`, `C:`).
            if (!text.ends_with(":") && !is_dir(text)) {
                const made = mkdir(text);
                if (made.is_err() && !is_dir(text)) { ret Err(made.unwrap_err()); }
            }
        }
        index = index + 1;
    }
    Ok(true)
}

// The absolute path with symbolic links, `.` and `..` resolved; the path
// must exist.
pub fn canonicalize(path: str) Result[Path, FsError] {
    @cfg(target_os = "linux") {
        // O_PATH | O_CLOEXEC opens without reading; /proc names the target.
        var fd: i32 = -1;
        unsafe { fd = unix.open(path, 2621440, 0); }
        if (fd < 0) { ret Err(fs_error(fd)); }
        const link: String = "/proc/self/fd/{fd}";
        var buffer: *u8 = 0;
        unsafe { buffer = core.malloc(4097); }
        if (buffer == 0) {
            unsafe { unix.close(fd); }
            ret Err(FsError.AllocationFailed);
        }
        var length: isize = 0;
        unsafe {
            core.memset(buffer, 0, 4097);
            length = unix.readlink(link.as_str(), core.str_from_ptr(buffer), 4096);
            unix.close(fd);
        }
        if (length <= 0) {
            unsafe { core.free(buffer); }
            ret Err(fs_error(length as i32));
        }
        var text: String = String.new();
        unsafe {
            *(buffer + (length as usize)) = 0;
            text = String.from_raw(buffer, length as usize, 4097);
        }
        ret Ok(Path.new(text.as_str()));
    }
    @cfg(target_os = "windows") {
        if (!exists(path)) { ret Err(FsError.NotFound); }
        var buffer: *u8 = 0;
        unsafe { buffer = core.malloc(32768); }
        if (buffer == 0) { ret Err(FsError.AllocationFailed); }
        const text: String = String.from(path);
        var length: u32 = 0;
        unsafe {
            length = win32_core.full_path_name(core.str_as_ptr(text.as_str()), 32767, buffer, 0);
        }
        if (length == 0 || length >= 32767) {
            unsafe { core.free(buffer); }
            ret Err(FsError.InvalidPath);
        }
        var full: String = String.new();
        unsafe {
            *(buffer + (length as usize)) = 0;
            full = String.from_raw(buffer, length as usize, 32768);
        }
        ret Ok(Path.new(full.as_str()));
    }
    Err(FsError.Unsupported)
}

// Creates or truncates `path` and writes `contents`.
pub fn write(path: str, contents: str) Result[usize, FsError] {
    var file = File.create(path)?;
    const written: usize = file.write_str(contents)?;
    file.close()?;
    Ok(written)
}

pub fn writable(path: str) bool {
    @cfg(target_os = "linux") {
        unsafe { ret unix.access(path, 2) == 0; }
    }
        @cfg(target_os = "netbsd") {
        unsafe { ret netbsd.access(path, 2) == 0; }
    }
    @cfg(target_os = "windows") { ret exists(path); }
    ret false;
}

pub fn remove(path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.unlink(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
        @cfg(target_os = "netbsd") {
        var result: i32 = -1;
        unsafe { result = netbsd.unlink(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.delete_file(core.str_as_ptr(path)) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn mkdir(path: str) Result[bool, FsError] {
    ret mkdir_mode(path, 493);
}

pub fn mkdir_mode(path: str, mode: u32) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.mkdir(path, mode); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
        @cfg(target_os = "netbsd") {
        var result: i32 = -1;
        unsafe { result = netbsd.mkdir(path, mode); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.create_directory(core.str_as_ptr(path), 0) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn rmdir(path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.rmdir(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
        @cfg(target_os = "netbsd") {
        var result: i32 = -1;
        unsafe { result = netbsd.rmdir(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.remove_directory(core.str_as_ptr(path)) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn rename(from: str, to: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.rename(from, to); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
        @cfg(target_os = "netbsd") {
        var result: i32 = -1;
        unsafe { result = netbsd.rename(from, to); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.move_file(core.str_as_ptr(from), core.str_as_ptr(to)) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn link(existing: str, new_path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.link(existing, new_path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
        @cfg(target_os = "netbsd") {
        var result: i32 = -1;
        unsafe { result = netbsd.link(existing, new_path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn symlink(target: str, link_path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.symlink(target, link_path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
        @cfg(target_os = "netbsd") {
        var result: i32 = -1;
        unsafe { result = netbsd.symlink(target, link_path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn chmod(path: str, mode: u32) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.chmod(path, mode); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
        @cfg(target_os = "netbsd") {
        var result: i32 = -1;
        unsafe { result = netbsd.chmod(path, mode); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

@test
fn read_to_string_with_limit_rejects_larger_files() void {
    const path = "/tmp/quazi_fs_limit_test.txt";
    var file = File.create(path).unwrap();
    file.write_str("hello world").unwrap();
    file.close();
    if (read_to_string_with_limit(path, 11).unwrap().as_str() != "hello world") { panic("exact-size file rejected"); }
    const limited = read_to_string_with_limit(path, 5);
    const too_large: bool = match limited { Err(FsError.TooLarge) => true, _ => false };
    if (!too_large) { panic("oversized file was not rejected with TooLarge"); }
    if (read_to_string(path).unwrap().as_str() != "hello world") { panic("unbounded read changed"); }
    remove(path).unwrap();
}

@test
fn read_dir_names_lists_entries_without_dot_links() void {
    const directory = "/tmp/quazi_fs_read_dir_test";
    mkdir(directory).unwrap();
    var first = File.create("/tmp/quazi_fs_read_dir_test/alpha.txt").unwrap();
    first.close();
    var second = File.create("/tmp/quazi_fs_read_dir_test/λ🙂.qz").unwrap();
    second.close();
    mkdir("/tmp/quazi_fs_read_dir_test/nested").unwrap();
    var names: Array[String] = read_dir_names(directory).unwrap();
    const total: usize = names.len();
    var seen: usize = 0;
    // Owned elements are moved out until borrowed element access exists.
    for (names.len() > 0) {
        const last: usize = names.len() - 1;
        const name: String = names.remove(last);
        const text = name.as_str();
        if (text == "alpha.txt" || text == "λ🙂.qz" || text == "nested") { seen = seen + 1; }
        if (text == "." || text == "..") { panic("dot links must be skipped"); }
    }
    if (total != 3 || seen != 3) { panic("unexpected directory entries"); }
    if (count_entries(directory).unwrap() != total) { panic("count_entries disagrees"); }
    const missing = read_dir_names("/tmp/quazi_fs_read_dir_test/absent");
    const not_found: bool = match missing { Err(FsError.NotFound) => true, _ => false };
    if (!not_found) { panic("a missing directory must report NotFound"); }
    remove("/tmp/quazi_fs_read_dir_test/alpha.txt").unwrap();
    remove("/tmp/quazi_fs_read_dir_test/λ🙂.qz").unwrap();
    rmdir("/tmp/quazi_fs_read_dir_test/nested").unwrap();
    rmdir(directory).unwrap();
}

@test
fn metadata_reports_size_kind_and_time() {
    const path = "/tmp/quazi_fs_metadata_test.txt";
    var file = File.create(path).unwrap();
    file.write_str("hello").unwrap();
    file.close();
    const info: Metadata = metadata(path).unwrap();
    if (info.len() != 5 || !info.is_file() || info.is_dir()) { panic("file metadata"); }
    // Written within the last day (1.7e18 ns is late 2023).
    if (info.modified_unix_nanos() < 1700000000000000000) { panic("modification time"); }
    if (info.readonly()) { panic("a new file is writable"); }
    chmod(path, 292).unwrap();
    if (!metadata(path).unwrap().readonly()) { panic("0444 is read-only"); }
    const directory: Metadata = metadata("/tmp").unwrap();
    if (!directory.is_dir()) { panic("directory metadata"); }
    symlink(path, "/tmp/quazi_fs_metadata_link").unwrap();
    if (!symlink_metadata("/tmp/quazi_fs_metadata_link").unwrap().is_symlink()) { panic("symlink_metadata"); }
    if (!metadata("/tmp/quazi_fs_metadata_link").unwrap().is_file()) { panic("metadata follows links"); }
    remove("/tmp/quazi_fs_metadata_link").unwrap();
    remove(path).unwrap();
    const missing = metadata("/tmp/quazi_fs_metadata_absent");
    if (!match missing { Err(FsError.NotFound) => true, _ => false }) { panic("NotFound"); }
}

@test
fn walk_lists_nested_entries_without_following_links() {
    const root = "/tmp/quazi_fs_walk_test";
    mkdir(root).unwrap();
    mkdir("/tmp/quazi_fs_walk_test/a").unwrap();
    mkdir("/tmp/quazi_fs_walk_test/a/b").unwrap();
    var file = File.create("/tmp/quazi_fs_walk_test/a/b/deep.txt").unwrap();
    file.close();
    // A link back to the root must not be descended into.
    symlink(root, "/tmp/quazi_fs_walk_test/a/loop").unwrap();
    var entries: Array[String] = walk(root).unwrap();
    const total: usize = entries.len();
    var expected: usize = 0;
    for (entries.len() > 0) {
        const last: usize = entries.len() - 1;
        const entry: String = entries.remove(last);
        const text = entry.as_str();
        if (text == "a" || text == "a/b" || text == "a/b/deep.txt" || text == "a/loop") {
            expected = expected + 1;
        }
    }
    if (total != 4 || expected != 4) { panic("walk entries"); }
    remove("/tmp/quazi_fs_walk_test/a/loop").unwrap();
    remove("/tmp/quazi_fs_walk_test/a/b/deep.txt").unwrap();
    rmdir("/tmp/quazi_fs_walk_test/a/b").unwrap();
    rmdir("/tmp/quazi_fs_walk_test/a").unwrap();
    rmdir(root).unwrap();
}

@test
fn buffered_writer_and_line_reader_round_trip() {
    const path = "/tmp/quazi_fs_buffered_test.txt";
    var writer = BufferedWriter.create(path).unwrap();
    for i : 0..20000 {
        const line = "line {i} λ\n";
        writer.write_str(line.as_str()).unwrap();
    }
    writer.write_str("crlf\r\nlast without newline").unwrap();
    writer.flush().unwrap();
    var reader = LineReader.open(path).unwrap();
    var count: usize = 0;
    var total_bytes: usize = 0;
    var last: String = String.new();
    for (true) {
        const line = reader.read_line().unwrap();
        if (line.is_none()) { break; }
        const text: String = line.unwrap();
        total_bytes = total_bytes + text.bytes_len();
        count = count + 1;
        last = text;
    }
    if (count != 20002) { panic("line count {count}"); }
    if (last.as_str() != "last without newline") { panic("last line {last}"); }
    remove(path).unwrap();
}

@test
fn read_dir_entries_iterate_with_types_and_paths() {
    const root = "/tmp/quazi_fs_read_dir_entries/a/b";
    create_dir_all(root).unwrap();
    if (!create_dir_all(root).is_ok()) { panic("create_dir_all must accept an existing tree"); }
    write("/tmp/quazi_fs_read_dir_entries/a/notes.txt", "hello").unwrap();
    symlink("/tmp/quazi_fs_read_dir_entries/a/notes.txt", "/tmp/quazi_fs_read_dir_entries/a/link").unwrap();
    var files: usize = 0;
    var dirs: usize = 0;
    var links: usize = 0;
    var seen: usize = 0;
    for entry : read_dir("/tmp/quazi_fs_read_dir_entries/a").unwrap() {
        seen = seen + 1;
        if (entry.is_file()) {
            files = files + 1;
            if (entry.name() != "notes.txt") { panic("file name"); }
            if (entry.path().as_str() != "/tmp/quazi_fs_read_dir_entries/a/notes.txt") { panic("entry path"); }
            if (entry.metadata().unwrap().len() != 5) { panic("entry metadata"); }
        }
        if (entry.is_dir()) { dirs = dirs + 1; }
        if (entry.is_symlink()) { links = links + 1; }
    }
    if (seen != 3 || files != 1 || dirs != 1 || links != 1) { panic("entry kinds"); }
    if (!is_dir("/tmp/quazi_fs_read_dir_entries/a/b") || is_file("/tmp/quazi_fs_read_dir_entries/a/b")) { panic("is_dir"); }
    if (!is_file("/tmp/quazi_fs_read_dir_entries/a/link") || !is_symlink("/tmp/quazi_fs_read_dir_entries/a/link")) { panic("link checks"); }
    const real = canonicalize("/tmp/quazi_fs_read_dir_entries/a/b/../link").unwrap();
    if (real.as_str() != "/tmp/quazi_fs_read_dir_entries/a/notes.txt") { panic("canonicalize {real.as_str()}"); }
    if (canonicalize("/tmp/quazi_fs_read_dir_entries/missing").is_ok()) { panic("canonicalize of a missing path"); }
    const renamed = Path.new("/tmp/report.tar.gz").with_extension("zip");
    if (renamed.as_str() != "/tmp/report.tar.zip") { panic("with_extension"); }
    if (!Path.new("/tmp/a/b").starts_with("/tmp/a") || Path.new("/tmp/ab").starts_with("/tmp/a")) { panic("starts_with"); }
    remove("/tmp/quazi_fs_read_dir_entries/a/link").unwrap();
    remove("/tmp/quazi_fs_read_dir_entries/a/notes.txt").unwrap();
    rmdir("/tmp/quazi_fs_read_dir_entries/a/b").unwrap();
    rmdir("/tmp/quazi_fs_read_dir_entries/a").unwrap();
    rmdir("/tmp/quazi_fs_read_dir_entries").unwrap();
}
