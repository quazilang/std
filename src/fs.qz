// std.fs — cross-platform file-system operations for Linux and Windows.
//
// File owns its operating-system handle. Whole-program destruction analysis
// finds File.free and inserts it on every lexical exit, including early return.
// Application code normally never calls close/free explicitly.
import std.core;
import std.unix;
import std.win32_core;

// Private ownership adapters keep raw buffers and directory handles inside the
// same automatic-destruction model exposed by File and String.
struct FsRawBuffer {
    data: *u8,
}

impl FsRawBuffer {
    unsafe fn take(self: FsRawBuffer) *u8 {
        const data: *u8 = self.data;
        self.data = 0;
        ret data;
    }

    fn free(self: FsRawBuffer) void {
        if (self.data != 0) { unsafe { core.free(self.data); } }
        self.data = 0;
    }
}

struct DirectoryScan {
    handle: isize,
    data: *u8,
}

impl DirectoryScan {
    fn free(self: DirectoryScan) void {
        @cfg(target_os = "linux") {
            if (self.handle >= 0) { unsafe { unix.close(self.handle as i32); } }
        }
        @cfg(target_os = "windows") {
            if (self.handle != -1) {
                unsafe { win32_core.find_close(self.handle as usize); }
            }
        }
        if (self.data != 0) { unsafe { core.free(self.data); } }
        self.handle = -1;
        self.data = 0;
    }
}

unsafe fn is_dot_entry(name: *u8) bool {
    if (*name != 46) { ret false; }
    if (*(name + 1) == 0) { ret true; }
    ret *(name + 1) == 46 && *(name + 2) == 0;
}

pub struct File {
    handle: isize,
}

impl File {
    // Open an existing file for reading.
    pub fn open(path: str) Result[File, i32] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 0, 0);
                if (fd < 0) { ret Err(fd); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 2147483648 as u32, 3, 0, 3, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(-1); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(-1);
    }

    // Create or truncate a file for writing.
    pub fn create(path: str) Result[File, i32] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 577, 420);
                if (fd < 0) { ret Err(fd); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 1073741824, 3, 0, 2, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(-1); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(-1);
    }

    // Open for reading and writing, creating the file when needed.
    pub fn open_rw(path: str) Result[File, i32] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 66, 420);
                if (fd < 0) { ret Err(fd); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 3221225472 as u32, 3, 0, 4, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(-1); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(-1);
    }

    // Open for append, creating the file when needed.
    pub fn open_append(path: str) Result[File, i32] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 1089, 420);
                if (fd < 0) { ret Err(fd); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            const opened: Result[File, i32] = File.open_rw(path);
            if (opened.is_err()) { ret Err(opened.unwrap_err()); }
            const file: File = opened.unwrap();
            file.seek(0, 2);
            ret Ok(file);
        }
        ret Err(-1);
    }

    // Raw buffer read. The caller guarantees `buf` is writable for `n` bytes.
    pub unsafe fn read(self: File, buf: *u8, n: usize) isize {
        @cfg(target_os = "linux") {
            ret core.read(self.handle as i32, buf, n);
        }
        @cfg(target_os = "windows") {
            var count: u32 = 0;
            const ok: i32 = win32_core.read_file(
                self.handle as usize, buf, n as u32, &count, 0
            );
            if (ok == 0) { ret -1; }
            ret count as isize;
        }
        ret -1;
    }

    pub fn write(self: File, buf: bytes) isize {
        var result: isize = -1;
        unsafe { result = self.write_raw(buf.as_ptr(), buf.len()); }
        ret result;
    }

    // Raw buffer write. The caller guarantees `buf` is readable for `n` bytes.
    pub unsafe fn write_raw(self: File, buf: *u8, n: usize) isize {
        @cfg(target_os = "linux") {
            ret core.write_bytes(self.handle as i32, buf, n);
        }
        @cfg(target_os = "windows") {
            var count: u32 = 0;
            const ok: i32 = win32_core.write_file(
                self.handle as usize, buf, n as u32, &count, 0
            );
            if (ok == 0) { ret -1; }
            ret count as isize;
        }
        ret -1;
    }

    pub fn write_str(self: File, text: str) isize {
        var result: isize = -1;
        unsafe { result = self.write_raw(core.str_as_ptr(text), core.strlen(text)); }
        ret result;
    }

    // Explicit close is available for scarce-resource handoff. It invalidates
    // this File, so the later automatic destructor is a harmless no-op.
    pub fn close(self: File) i32 {
        if (self.handle < 0) { ret 0; }
        var result: i32 = 0;
        @cfg(target_os = "linux") {
            unsafe { result = unix.close(self.handle as i32); }
        }
        @cfg(target_os = "windows") {
            unsafe {
                if (win32_core.close_handle(self.handle as usize) == 0) { result = -1; }
            }
        }
        self.handle = -1;
        ret result;
    }

    // Destructor discovered by whole-program analysis.
    pub fn free(self: File) void {
        self.close();
    }

    pub fn seek(self: File, offset: i64, whence: i32) i64 {
        @cfg(target_os = "linux") {
            unsafe { ret unix.lseek(self.handle as i32, offset, whence); }
        }
        @cfg(target_os = "windows") {
            var position: i64 = 0;
            unsafe {
                const ok: i32 = win32_core.seek(
                    self.handle as usize, offset, &position, whence as u32
                );
                if (ok == 0) { ret -1; }
                ret position;
            }
        }
        ret -1;
    }

    // Linux descriptor, or a truncated Windows HANDLE for compatibility.
    pub fn fd(self: File) i32 { ret self.handle as i32; }
    pub fn raw_handle(self: File) usize { ret self.handle as usize; }

    pub fn sync(self: File) i32 {
        @cfg(target_os = "linux") {
            unsafe { ret unix.fsync(self.handle as i32); }
        }
        @cfg(target_os = "windows") {
            unsafe {
                if (win32_core.sync(self.handle as usize) == 0) { ret -1; }
            }
            ret 0;
        }
        ret -1;
    }

    // File truncation is currently implemented by the Linux backend.
    pub fn truncate(self: File, len: i64) i32 {
        @cfg(target_os = "linux") {
            unsafe { ret unix.ftruncate(self.handle as i32, len); }
        }
        ret -1;
    }
}

pub fn seek_set() i32 { ret 0; }
pub fn seek_cur() i32 { ret 1; }
pub fn seek_end() i32 { ret 2; }

// Read a UTF-8 text file into an owned String. File closure is automatic on
// success and every error path; only the private raw staging allocation needs
// explicit release before it has been promoted into String ownership.
pub fn read_to_string(path: str) Result[String, i32] {
    const opened: Result[File, i32] = File.open(path);
    if (opened.is_err()) { ret Err(opened.unwrap_err()); }
    const file: File = opened.unwrap();
    var capacity: usize = 4096;
    var length: usize = 0;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity + 1); }
    if (buffer.data == 0) { ret Err(-1); }

    for (true) {
        if (length == capacity) {
            capacity = capacity * 2;
            var grown: *u8 = 0;
            unsafe { grown = core.realloc(buffer.data, capacity + 1); }
            if (grown == 0) { ret Err(-1); }
            buffer.data = grown;
        }
        var count: isize = -1;
        unsafe { count = file.read(buffer.data + length, capacity - length); }
        if (count < 0) { ret Err(count as i32); }
        if (count == 0) { break; }
        length = length + count as usize;
    }
    unsafe { *(buffer.data + length) = 0; }
    var result: String = String.new();
    unsafe { result = String.from_raw(buffer.take(), length, capacity + 1); }
    ret Ok(result);
}

pub fn exists(path: str) bool {
    @cfg(target_os = "linux") {
        unsafe { ret unix.access(path, 0) == 0; }
    }
    @cfg(target_os = "windows") {
        unsafe {
            ret win32_core.file_attributes(core.str_as_ptr(path)) != 4294967295 as u32;
        }
    }
    ret false;
}

pub fn readable(path: str) bool {
    const opened: Result[File, i32] = File.open(path);
    if (opened.is_err()) { ret false; }
    const file: File = opened.unwrap();
    ret true;
}

// Count immediate directory entries, excluding `.` and `..`. The scan buffer
// and OS enumeration handle are closed automatically on success and errors.
pub fn count_entries(path: str) Result[usize, i32] {
    const capacity: usize = 4096;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity); }
    if (buffer.data == 0) { ret Err(-1); }

    @cfg(target_os = "linux") {
        var fd: i32 = -1;
        unsafe { fd = unix.open(path, 65536, 0); }
        if (fd < 0) { ret Err(fd); }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: fd as isize,
            data: scan_data,
        };
        var count: usize = 0;
        for (true) {
            var batch_size: isize = -1;
            unsafe { batch_size = unix.getdents64(fd, scan.data, capacity); }
            if (batch_size < 0) { ret Err(batch_size as i32); }
            if (batch_size == 0) { break; }
            var offset: usize = 0;
            for (offset < batch_size as usize) {
                var record_length: usize = 0;
                unsafe {
                    record_length = (*(scan.data + offset + 16)) as usize;
                    record_length = record_length
                        + (((*(scan.data + offset + 17)) as usize) << 8);
                }
                if (record_length < 20 || offset + record_length > batch_size as usize) {
                    ret Err(-1);
                }
                unsafe {
                    if (!is_dot_entry(scan.data + offset + 19)) { count++; }
                }
                offset = offset + record_length;
            }
        }
        ret Ok(count);
    }

    @cfg(target_os = "windows") {
        var pattern: String = String.from(path);
        pattern = pattern.push_str("\\*");
        var raw_handle: usize = 0;
        unsafe {
            raw_handle = win32_core.find_first(
                core.str_as_ptr(pattern.as_str()), buffer.data
            );
        }
        const handle: isize = raw_handle as isize;
        if (handle == -1) {
            var error: u32 = 0;
            unsafe { error = win32_core.last_error(); }
            if (error == 2 || error == 18) { ret Ok(0); }
            ret Err(error as i32);
        }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: handle,
            data: scan_data,
        };
        var count: usize = 0;
        for (true) {
            unsafe {
                if (!is_dot_entry(scan.data + 44)) { count++; }
                if (win32_core.find_next(raw_handle, scan.data) == 0) { break; }
            }
        }
        ret Ok(count);
    }

    ret Err(-1);
}

pub fn writable(path: str) bool {
    @cfg(target_os = "linux") {
        unsafe { ret unix.access(path, 2) == 0; }
    }
    @cfg(target_os = "windows") { ret exists(path); }
    ret false;
}

pub fn remove(path: str) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.unlink(path) == 0; } }
    @cfg(target_os = "windows") {
        unsafe { ret win32_core.delete_file(core.str_as_ptr(path)) != 0; }
    }
    ret false;
}

pub fn mkdir(path: str) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.mkdir(path, 493) == 0; } }
    @cfg(target_os = "windows") {
        unsafe { ret win32_core.create_directory(core.str_as_ptr(path), 0) != 0; }
    }
    ret false;
}

pub fn mkdir_mode(path: str, mode: u32) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.mkdir(path, mode) == 0; } }
    @cfg(target_os = "windows") { ret mkdir(path); }
    ret false;
}

pub fn rmdir(path: str) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.rmdir(path) == 0; } }
    @cfg(target_os = "windows") {
        unsafe { ret win32_core.remove_directory(core.str_as_ptr(path)) != 0; }
    }
    ret false;
}

pub fn rename(from: str, to: str) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.rename(from, to) == 0; } }
    @cfg(target_os = "windows") {
        unsafe {
            ret win32_core.move_file(core.str_as_ptr(from), core.str_as_ptr(to)) != 0;
        }
    }
    ret false;
}

pub fn link(existing: str, new_path: str) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.link(existing, new_path) == 0; } }
    ret false;
}

pub fn symlink(target: str, link_path: str) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.symlink(target, link_path) == 0; } }
    ret false;
}

pub fn chmod(path: str, mode: u32) bool {
    @cfg(target_os = "linux") { unsafe { ret unix.chmod(path, mode) == 0; } }
    ret false;
}
