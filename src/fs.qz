// std.fs — cross-platform file-system operations for Linux and Windows.
//
// File owns its operating-system handle. Whole-program destruction analysis
// finds File.free and inserts it on every lexical exit, including early return.
// Application code normally never calls close/free explicitly.
import std.core;
import std.unix;
import std.win32_core;

pub enum FsError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidPath,
    IsDirectory,
    NotDirectory,
    DirectoryNotEmpty,
    ReadOnly,
    NoSpace,
    TooManyOpenFiles,
    AllocationFailed,
    InvalidData,
    Unsupported,
    Native(i32),
}

impl FsError {
    pub fn message(self: FsError) str {
        ret match self {
            FsError.NotFound => "file or directory not found",
            FsError.PermissionDenied => "file-system permission denied",
            FsError.AlreadyExists => "file or directory already exists",
            FsError.InvalidPath => "invalid file-system path",
            FsError.IsDirectory => "expected a file, found a directory",
            FsError.NotDirectory => "expected a directory",
            FsError.DirectoryNotEmpty => "directory is not empty",
            FsError.ReadOnly => "file system is read-only",
            FsError.NoSpace => "no space left on device",
            FsError.TooManyOpenFiles => "too many open files",
            FsError.AllocationFailed => "file-system buffer allocation failed",
            FsError.InvalidData => "invalid file-system data",
            FsError.Unsupported => "file-system operation is unsupported",
            FsError.Native(_) => "unclassified operating-system file error",
        };
    }
}

fn fs_error(code: i32) FsError {
    if (code == -2 || code == 2 || code == 3) { ret FsError.NotFound; }
    if (code == -13 || code == 5) { ret FsError.PermissionDenied; }
    if (code == -17 || code == 80 || code == 183) { ret FsError.AlreadyExists; }
    if (code == -22 || code == 87 || code == 123 || code == 161) { ret FsError.InvalidPath; }
    if (code == -21) { ret FsError.IsDirectory; }
    if (code == -20 || code == 267) { ret FsError.NotDirectory; }
    if (code == -39 || code == 145) { ret FsError.DirectoryNotEmpty; }
    if (code == -30 || code == 19) { ret FsError.ReadOnly; }
    if (code == -28 || code == 112) { ret FsError.NoSpace; }
    if (code == -24 || code == 4) { ret FsError.TooManyOpenFiles; }
    if (code == -12 || code == 8 || code == 14) { ret FsError.AllocationFailed; }
    ret FsError.Native(code);
}

fn last_fs_error() FsError {
    var code: u32 = 0;
    unsafe { code = win32_core.last_error(); }
    ret fs_error(code as i32);
}

// Private ownership adapters keep raw buffers and directory handles inside the
// same automatic-destruction model exposed by File and String.
struct FsRawBuffer {
    data: *u8,
}

impl FsRawBuffer {
    unsafe fn take(self: FsRawBuffer) *u8 {
        const data: *u8 = self.data;
        self.data = 0;
        ret data;
    }

    fn free(self: FsRawBuffer) void {
        if (self.data != 0) { unsafe { core.free(self.data); } }
        self.data = 0;
    }
}

struct DirectoryScan {
    handle: isize,
    data: *u8,
}

impl DirectoryScan {
    fn free(self: DirectoryScan) void {
        @cfg(target_os = "linux") {
            if (self.handle >= 0) { unsafe { unix.close(self.handle as i32); } }
        }
        @cfg(target_os = "windows") {
            if (self.handle != -1) {
                unsafe { win32_core.find_close(self.handle as usize); }
            }
        }
        if (self.data != 0) { unsafe { core.free(self.data); } }
        self.handle = -1;
        self.data = 0;
    }
}

unsafe fn is_dot_entry(name: *u8) bool {
    if (*name != 46) { ret false; }
    if (*(name + 1) == 0) { ret true; }
    ret *(name + 1) == 46 && *(name + 2) == 0;
}

pub struct File {
    handle: isize,
}

impl File {
    // Open an existing file for reading.
    pub fn open(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 0, 0);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 2147483648 as u32, 3, 0, 3, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(last_fs_error()); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Create or truncate a file for writing.
    pub fn create(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 577, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 1073741824, 3, 0, 2, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(last_fs_error()); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Open for reading and writing, creating the file when needed.
    pub fn open_rw(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 66, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            unsafe {
                const raw: usize = win32_core.create_file(
                    core.str_as_ptr(path), 3221225472 as u32, 3, 0, 4, 128, 0
                );
                const handle: isize = raw as isize;
                if (handle == -1) { ret Err(last_fs_error()); }
                ret Ok(File { handle: handle });
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Open for append, creating the file when needed.
    pub fn open_append(path: str) Result[File, FsError] {
        @cfg(target_os = "linux") {
            unsafe {
                const fd: i32 = unix.open(path, 1089, 420);
                if (fd < 0) { ret Err(fs_error(fd)); }
                ret Ok(File { handle: fd as isize });
            }
        }
        @cfg(target_os = "windows") {
            const opened: Result[File, FsError] = File.open_rw(path);
            if (opened.is_err()) { ret Err(opened.unwrap_err()); }
            const file: File = opened.unwrap();
            const position: Result[i64, FsError] = file.seek(0, 2);
            if (position.is_err()) { ret Err(position.unwrap_err()); }
            ret Ok(file);
        }
        ret Err(FsError.Unsupported);
    }

    // Raw buffer read. The caller guarantees `buf` is writable for `n` bytes.
    pub unsafe fn read(self: File, buf: *u8, n: usize) isize {
        @cfg(target_os = "linux") {
            ret core.read(self.handle as i32, buf, n);
        }
        @cfg(target_os = "windows") {
            var count: u32 = 0;
            const ok: i32 = win32_core.read_file(
                self.handle as usize, buf, n as u32, &count, 0
            );
            if (ok == 0) { ret -1; }
            ret count as isize;
        }
        ret -1;
    }

    pub fn write(self: File, buf: bytes) Result[usize, FsError] {
        var result: isize = -1;
        unsafe { result = self.write_raw(buf.as_ptr(), buf.len()); }
        if (result < 0) {
            @cfg(target_os = "windows") { ret Err(last_fs_error()); }
            ret Err(fs_error(result as i32));
        }
        ret Ok(result as usize);
    }

    // Raw buffer write. The caller guarantees `buf` is readable for `n` bytes.
    pub unsafe fn write_raw(self: File, buf: *u8, n: usize) isize {
        @cfg(target_os = "linux") {
            ret core.write_bytes(self.handle as i32, buf, n);
        }
        @cfg(target_os = "windows") {
            var count: u32 = 0;
            const ok: i32 = win32_core.write_file(
                self.handle as usize, buf, n as u32, &count, 0
            );
            if (ok == 0) { ret -1; }
            ret count as isize;
        }
        ret -1;
    }

    pub fn write_str(self: File, text: str) Result[usize, FsError] {
        var result: isize = -1;
        unsafe { result = self.write_raw(core.str_as_ptr(text), core.strlen(text)); }
        if (result < 0) {
            @cfg(target_os = "windows") { ret Err(last_fs_error()); }
            ret Err(fs_error(result as i32));
        }
        ret Ok(result as usize);
    }

    // Explicit close is available for scarce-resource handoff. It invalidates
    // this File, so the later automatic destructor is a harmless no-op.
    pub fn close(self: File) Result[bool, FsError] {
        if (self.handle < 0) { ret Ok(false); }
        var result: i32 = 0;
        @cfg(target_os = "linux") {
            unsafe { result = unix.close(self.handle as i32); }
        }
        @cfg(target_os = "windows") {
            unsafe {
                if (win32_core.close_handle(self.handle as usize) == 0) {
                    const error: FsError = last_fs_error();
                    self.handle = -1;
                    ret Err(error);
                }
            }
        }
        self.handle = -1;
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }

    // Destructor discovered by whole-program analysis.
    pub fn free(self: File) void {
        self.close();
    }

    pub fn seek(self: File, offset: i64, whence: i32) Result[i64, FsError] {
        @cfg(target_os = "linux") {
            var position: i64 = -1;
            unsafe { position = unix.lseek(self.handle as i32, offset, whence); }
            if (position < 0) { ret Err(fs_error(position as i32)); }
            ret Ok(position);
        }
        @cfg(target_os = "windows") {
            var position: i64 = 0;
            unsafe {
                const ok: i32 = win32_core.seek(
                    self.handle as usize, offset, &position, whence as u32
                );
                if (ok == 0) { ret Err(last_fs_error()); }
                ret Ok(position);
            }
        }
        ret Err(FsError.Unsupported);
    }

    // Linux descriptor, or a truncated Windows HANDLE for compatibility.
    pub fn fd(self: File) i32 { ret self.handle as i32; }
    pub fn raw_handle(self: File) usize { ret self.handle as usize; }

    pub fn sync(self: File) Result[bool, FsError] {
        @cfg(target_os = "linux") {
            var result: i32 = -1;
            unsafe { result = unix.fsync(self.handle as i32); }
            if (result < 0) { ret Err(fs_error(result)); }
            ret Ok(true);
        }
        @cfg(target_os = "windows") {
            unsafe {
                if (win32_core.sync(self.handle as usize) == 0) { ret Err(last_fs_error()); }
            }
            ret Ok(true);
        }
        ret Err(FsError.Unsupported);
    }

    // File truncation is currently implemented by the Linux backend.
    pub fn truncate(self: File, len: i64) Result[bool, FsError] {
        @cfg(target_os = "linux") {
            var result: i32 = -1;
            unsafe { result = unix.ftruncate(self.handle as i32, len); }
            if (result < 0) { ret Err(fs_error(result)); }
            ret Ok(true);
        }
        ret Err(FsError.Unsupported);
    }
}

pub fn seek_set() i32 { ret 0; }
pub fn seek_cur() i32 { ret 1; }
pub fn seek_end() i32 { ret 2; }

// Read a UTF-8 text file into an owned String. File closure is automatic on
// success and every error path; only the private raw staging allocation needs
// explicit release before it has been promoted into String ownership.
pub fn read_to_string(path: str) Result[String, FsError] {
    const opened: Result[File, FsError] = File.open(path);
    if (opened.is_err()) { ret Err(opened.unwrap_err()); }
    const file: File = opened.unwrap();
    var capacity: usize = 4096;
    var length: usize = 0;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity + 1); }
    if (buffer.data == 0) { ret Err(FsError.AllocationFailed); }

    for (true) {
        if (length == capacity) {
            capacity = capacity * 2;
            var grown: *u8 = 0;
            unsafe { grown = core.realloc(buffer.data, capacity + 1); }
            if (grown == 0) { ret Err(FsError.AllocationFailed); }
            buffer.data = grown;
        }
        var count: isize = -1;
        unsafe { count = file.read(buffer.data + length, capacity - length); }
        if (count < 0) {
            @cfg(target_os = "windows") { ret Err(last_fs_error()); }
            ret Err(fs_error(count as i32));
        }
        if (count == 0) { break; }
        length = length + count as usize;
    }
    unsafe { *(buffer.data + length) = 0; }
    var result: String = String.new();
    unsafe { result = String.from_raw(buffer.take(), length, capacity + 1); }
    ret Ok(result);
}

pub fn exists(path: str) bool {
    @cfg(target_os = "linux") {
        unsafe { ret unix.access(path, 0) == 0; }
    }
    @cfg(target_os = "windows") {
        unsafe {
            ret win32_core.file_attributes(core.str_as_ptr(path)) != 4294967295 as u32;
        }
    }
    ret false;
}

pub fn readable(path: str) bool {
    const opened: Result[File, FsError] = File.open(path);
    if (opened.is_err()) { ret false; }
    const file: File = opened.unwrap();
    ret true;
}

// Count immediate directory entries, excluding `.` and `..`. The scan buffer
// and OS enumeration handle are closed automatically on success and errors.
pub fn count_entries(path: str) Result[usize, FsError] {
    const capacity: usize = 4096;
    var buffer: FsRawBuffer = FsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity); }
    if (buffer.data == 0) { ret Err(FsError.AllocationFailed); }

    @cfg(target_os = "linux") {
        var fd: i32 = -1;
        unsafe { fd = unix.open(path, 65536, 0); }
        if (fd < 0) { ret Err(fs_error(fd)); }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: fd as isize,
            data: scan_data,
        };
        var count: usize = 0;
        for (true) {
            var batch_size: isize = -1;
            unsafe { batch_size = unix.getdents64(fd, scan.data, capacity); }
            if (batch_size < 0) { ret Err(fs_error(batch_size as i32)); }
            if (batch_size == 0) { break; }
            var offset: usize = 0;
            for (offset < batch_size as usize) {
                var record_length: usize = 0;
                unsafe {
                    record_length = (*(scan.data + offset + 16)) as usize;
                    record_length = record_length
                        + (((*(scan.data + offset + 17)) as usize) << 8);
                }
                if (record_length < 20 || offset + record_length > batch_size as usize) {
                    ret Err(FsError.InvalidData);
                }
                unsafe {
                    if (!is_dot_entry(scan.data + offset + 19)) { count++; }
                }
                offset = offset + record_length;
            }
        }
        ret Ok(count);
    }

    @cfg(target_os = "windows") {
        var pattern: String = String.from(path);
        pattern = pattern.push_str("\\*");
        var raw_handle: usize = 0;
        unsafe {
            raw_handle = win32_core.find_first(
                core.str_as_ptr(pattern.as_str()), buffer.data
            );
        }
        const handle: isize = raw_handle as isize;
        if (handle == -1) {
            var error: u32 = 0;
            unsafe { error = win32_core.last_error(); }
            if (error == 2 || error == 18) { ret Ok(0); }
            ret Err(fs_error(error as i32));
        }
        var scan_data: *u8 = 0;
        unsafe { scan_data = buffer.take(); }
        const scan: DirectoryScan = DirectoryScan {
            handle: handle,
            data: scan_data,
        };
        var count: usize = 0;
        for (true) {
            unsafe {
                if (!is_dot_entry(scan.data + 44)) { count++; }
                if (win32_core.find_next(raw_handle, scan.data) == 0) { break; }
            }
        }
        ret Ok(count);
    }

    ret Err(FsError.Unsupported);
}

pub fn writable(path: str) bool {
    @cfg(target_os = "linux") {
        unsafe { ret unix.access(path, 2) == 0; }
    }
    @cfg(target_os = "windows") { ret exists(path); }
    ret false;
}

pub fn remove(path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.unlink(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.delete_file(core.str_as_ptr(path)) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn mkdir(path: str) Result[bool, FsError] {
    ret mkdir_mode(path, 493);
}

pub fn mkdir_mode(path: str, mode: u32) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.mkdir(path, mode); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.create_directory(core.str_as_ptr(path), 0) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn rmdir(path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.rmdir(path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.remove_directory(core.str_as_ptr(path)) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn rename(from: str, to: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.rename(from, to); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    @cfg(target_os = "windows") {
        unsafe {
            if (win32_core.move_file(core.str_as_ptr(from), core.str_as_ptr(to)) == 0) { ret Err(last_fs_error()); }
        }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn link(existing: str, new_path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.link(existing, new_path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn symlink(target: str, link_path: str) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.symlink(target, link_path); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

pub fn chmod(path: str, mode: u32) Result[bool, FsError] {
    @cfg(target_os = "linux") {
        var result: i32 = -1;
        unsafe { result = unix.chmod(path, mode); }
        if (result < 0) { ret Err(fs_error(result)); }
        ret Ok(true);
    }
    ret Err(FsError.Unsupported);
}

// ── BufReader ─────────────────────────────────────────────────────────────────

// A buffered reader wrapping a File. Accumulates kernel I/O into an internal
// buffer so that small reads (e.g. one line at a time) are cheap.
//
//   const r = BufReader.open("log.txt")?;
//   for (true) {
//       const line = r.read_line()?;
//       if (line.is_none()) { break; }
//       println("{}", line.unwrap().as_str());
//   }
pub struct BufReader {
    file: File,
    buf: *u8,
    buf_cap: usize,
    buf_len: usize,
    buf_pos: usize,
}

impl BufReader {


    // Open a file for buffered reading.
    pub fn open(path: str) Result[BufReader, FsError] {
        const file_result: Result[File, FsError] = File.open(path);
        if (file_result.is_err()) { ret Err(file_result.unwrap_err()); }
        const file: File = file_result.unwrap();
        var buf: *u8 = 0;
        unsafe { buf = core.malloc(8192); }
        if (buf == 0) { ret Err(FsError.AllocationFailed); }
        ret Ok(BufReader { file: file, buf: buf, buf_cap: 8192, buf_len: 0, buf_pos: 0 });
    }

    // Wrap an already-open File.
    pub fn from_file(file: File) Result[BufReader, FsError] {
        var buf: *u8 = 0;
        unsafe { buf = core.malloc(8192); }
        if (buf == 0) { ret Err(FsError.AllocationFailed); }
        ret Ok(BufReader { file: file, buf: buf, buf_cap: 8192, buf_len: 0, buf_pos: 0 });
    }

    // Fill the internal buffer from the file. Returns false on EOF.
    fn __fill(self: BufReader) bool {
        if (self.buf_pos < self.buf_len) { ret true; }
        var n: isize = -1;
        unsafe { n = self.file.read(self.buf, self.buf_cap); }
        if (n <= 0) { self.buf_len = 0; self.buf_pos = 0; ret false; }
        self.buf_len = n as usize;
        self.buf_pos = 0;
        ret true;
    }

    // Read one line (including the trailing newline if present).
    // Returns None on EOF, Err on read failure.
    pub fn read_line(self: BufReader) Result[Option[String], FsError] {
        var line: String = String.new();
        var found_newline: bool = false;
        for (!found_newline) {
            if (!self.__fill()) {
                if (line.is_empty()) { ret Ok(None); }
                ret Ok(Some(line));
            }
            for (self.buf_pos < self.buf_len) {
                var b: u8 = 0;
                unsafe { b = *(self.buf + self.buf_pos); }
                self.buf_pos++;
                // Append byte to line.
                unsafe {
                    var ch: *u8 = core.malloc(2);
                    if (ch != 0) {
                        *ch = b;
                        *(ch + 1) = 0;
                        line = line.push_str(core.str_from_ptr(ch));
                        core.free(ch);
                    }
                }
                if (b == 10) { found_newline = true; break; } // '\n'
            }
        }
        ret Ok(Some(line));
    }

    // Read all remaining content into a single String.
    pub fn read_to_string(self: BufReader) Result[String, FsError] {
        var result: String = String.new();
        for (true) {
            if (!self.__fill()) { break; }
            // Append remaining buffered bytes.
            for (self.buf_pos < self.buf_len) {
                var b: u8 = 0;
                unsafe { b = *(self.buf + self.buf_pos); }
                self.buf_pos++;
                unsafe {
                    var ch: *u8 = core.malloc(2);
                    if (ch != 0) {
                        *ch = b;
                        *(ch + 1) = 0;
                        result = result.push_str(core.str_from_ptr(ch));
                        core.free(ch);
                    }
                }
            }
        }
        ret Ok(result);
    }

    // Read exactly n bytes into the returned Array. May return fewer at EOF.
    pub fn read_bytes(self: BufReader, n: usize) Result[Array[u8], FsError] {
        var out: Array[u8] = Array.new();
        var remaining: usize = n;
        for (remaining > 0) {
            if (!self.__fill()) { break; }
            for (self.buf_pos < self.buf_len && remaining > 0) {
                var b: u8 = 0;
                unsafe { b = *(self.buf + self.buf_pos); }
                self.buf_pos++;
                out.push(b);
                remaining--;
            }
        }
        ret Ok(out);
    }

    // Explicitly close the reader and free the buffer.
    pub fn close(self: BufReader) void {
        self.file.close();
        unsafe { if (self.buf != 0) { core.free(self.buf); self.buf = 0; } }
    }

    pub fn free(self: BufReader) void {
        self.close();
    }
}

// ── BufWriter ─────────────────────────────────────────────────────────────────

// A buffered writer wrapping a File. Accumulates small writes in memory and
// flushes to the kernel when the buffer is full or flush() / free() is called.
//
//   const w = BufWriter.create("out.txt")?;
//   w.write_str("hello\n")?;
//   w.flush()?;
pub struct BufWriter {
    file: File,
    buf: *u8,
    buf_cap: usize,
    buf_len: usize,
}

impl BufWriter {


    pub fn create(path: str) Result[BufWriter, FsError] {
        const file_result: Result[File, FsError] = File.create(path);
        if (file_result.is_err()) { ret Err(file_result.unwrap_err()); }
        ret BufWriter.__from_file(file_result.unwrap());
    }

    pub fn open_append(path: str) Result[BufWriter, FsError] {
        const file_result: Result[File, FsError] = File.open_append(path);
        if (file_result.is_err()) { ret Err(file_result.unwrap_err()); }
        ret BufWriter.__from_file(file_result.unwrap());
    }

    pub fn from_file(file: File) Result[BufWriter, FsError] {
        ret BufWriter.__from_file(file);
    }

    fn __from_file(file: File) Result[BufWriter, FsError] {
        var buf: *u8 = 0;
        unsafe { buf = core.malloc(8192); }
        if (buf == 0) { ret Err(FsError.AllocationFailed); }
        ret Ok(BufWriter { file: file, buf: buf, buf_cap: 8192, buf_len: 0 });
    }

    // Flush internal buffer to disk.
    pub fn flush(self: BufWriter) Result[bool, FsError] {
        if (self.buf_len == 0) { ret Ok(true); }
        var written: usize = 0;
        for (written < self.buf_len) {
            var n: isize = -1;
            unsafe { n = self.file.write_raw(self.buf + written, self.buf_len - written); }
            if (n <= 0) { ret Err(FsError.Native(-1)); }
            written = written + n as usize;
        }
        self.buf_len = 0;
        ret Ok(true);
    }

    // Buffer a str for writing. Flushes automatically when the buffer is full.
    pub fn write_str(self: BufWriter, text: str) Result[usize, FsError] {
        var src: *u8 = 0;
        unsafe { src = core.str_as_ptr(text); }
        const len: usize = text.len();
        var written: usize = 0;
        for (written < len) {
            const space: usize = self.buf_cap - self.buf_len;
            const chunk: usize = len - written;
            var copy: usize = chunk;
            if (copy > space) { copy = space; }
            unsafe { core.memcpy(self.buf + self.buf_len, src + written, copy); }
            self.buf_len = self.buf_len + copy;
            written = written + copy;
            if (self.buf_len == self.buf_cap) {
                const flush_result: Result[bool, FsError] = self.flush();
                if (flush_result.is_err()) { ret Err(flush_result.unwrap_err()); }
            }
        }
        ret Ok(len);
    }

    // Buffer a line (appends '\n' automatically).
    pub fn write_line(self: BufWriter, text: str) Result[usize, FsError] {
        const a: Result[usize, FsError] = self.write_str(text);
        if (a.is_err()) { ret Err(a.unwrap_err()); }
        const b: Result[usize, FsError] = self.write_str("\n");
        if (b.is_err()) { ret Err(b.unwrap_err()); }
        ret Ok(a.unwrap() + b.unwrap());
    }

    // Flush and close.
    pub fn close(self: BufWriter) Result[bool, FsError] {
        const f: Result[bool, FsError] = self.flush();
        if (f.is_err()) { ret Err(f.unwrap_err()); }
        self.file.close();
        unsafe { if (self.buf != 0) { core.free(self.buf); self.buf = 0; } }
        ret Ok(true);
    }

    pub fn free(self: BufWriter) void {
        self.close();
        unsafe { if (self.buf != 0) { core.free(self.buf); self.buf = 0; } }
    }
}

// ── FileMetadata ──────────────────────────────────────────────────────────────

// File attributes returned by stat().
pub struct FileMetadata {
    size: u64,         // byte length of a regular file (0 for directories)
    is_file: bool,
    is_dir: bool,
    is_symlink: bool,
    modified_secs: i64,  // Unix timestamp of last modification (0 = unknown)
    mode: u32,           // POSIX permission bits (0 = unknown on Windows)
}

impl FileMetadata {
    pub fn size(self: FileMetadata) u64 { ret self.size; }
    pub fn is_file(self: FileMetadata) bool { ret self.is_file; }
    pub fn is_dir(self: FileMetadata) bool { ret self.is_dir; }
    pub fn is_symlink(self: FileMetadata) bool { ret self.is_symlink; }
    // Seconds since Unix epoch of the last write. 0 when unavailable.
    pub fn modified_secs(self: FileMetadata) i64 { ret self.modified_secs; }
    pub fn mode(self: FileMetadata) u32 { ret self.mode; }
}

// Query attributes for a path.
pub fn stat(path: str) Result[FileMetadata, FsError] {
    @cfg(target_os = "linux") {
        // struct stat on x86-64 Linux: 144 bytes.
        // Relevant fields (offsets):
        //   st_mode  u32 at byte 24
        //   st_size  i64 at byte 48
        //   st_mtime i64 at byte 88
        var buf: *u8 = 0;
        unsafe { buf = core.malloc(144); core.memset(buf, 0, 144); }
        if (buf == 0) { ret Err(FsError.AllocationFailed); }
        var r: i32 = -1;
        unsafe { r = unix.stat(path, buf); }
        if (r < 0) { unsafe { core.free(buf); } ret Err(fs_error(r)); }
        var mode: u32 = 0;
        var size: i64 = 0;
        var mtime: i64 = 0;
        unsafe {
            mode  = *((buf + 24) as *u32);
            size  = *((buf + 48) as *i64);
            mtime = *((buf + 88) as *i64);
            core.free(buf);
        }
        const file_type: u32 = mode & 61440; // S_IFMT = 0xF000
        const is_file: bool    = file_type == 32768;  // S_IFREG = 0x8000
        const is_dir: bool     = file_type == 16384;  // S_IFDIR = 0x4000
        const is_symlink: bool = file_type == 40960;  // S_IFLNK = 0xA000
        var final_size: u64 = 0;
        if (is_file) { final_size = size as u64; }
        ret Ok(FileMetadata {
            size: final_size,
            is_file: is_file, is_dir: is_dir, is_symlink: is_symlink,
            modified_secs: mtime, mode: mode & 4095,
        });
    }
    @cfg(target_os = "windows") {
        var attr: u32 = 0;
        unsafe { attr = win32_core.file_attributes(core.str_as_ptr(path)); }
        if (attr == 4294967295 as u32) { ret Err(last_fs_error()); }
        const is_dir: bool = (attr & 16) != 0;
        ret Ok(FileMetadata {
            size: 0,        // would need GetFileAttributesExA for size
            is_file: !is_dir, is_dir: is_dir, is_symlink: (attr & 1024) != 0,
            modified_secs: 0, mode: 0,
        });
    }
    ret Err(FsError.Unsupported);
}
