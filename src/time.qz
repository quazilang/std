// std.time — monotonic durations and instants, UTC wall-clock time.
//
// `Instant` is suitable for elapsed-time measurements and deadlines; its epoch
// is opaque and values from separate system boots are incomparable.
// `SystemTime` is POSIX wall-clock time (Unix seconds, leap seconds not
// counted) limited to years 0001-9999; `DateTime` is its proleptic-Gregorian
// UTC calendar form. Named time zones are not supported; RFC 3339 parsing
// accepts numeric UTC offsets and normalizes to UTC.

import std.core;
@cfg(target_os="linux")
import std.unix;
@cfg(target_os = "netbsd")
import std.netbsd;
@cfg(target_os="windows")
import std.win32_core;

pub enum TimeError { ClockUnavailable, ClockWentBackwards, InvalidFormat, OutOfRange, }

impl TimeError {
    pub fn message(self: TimeError) str {
        ret match self {
            ClockUnavailable => "clock is unavailable",
            ClockWentBackwards => "clock moved backwards",
            InvalidFormat => "text is not a valid RFC 3339 timestamp",
            OutOfRange => "time is outside years 0001-9999",
        };
    }
}

pub struct Duration {
    seconds: u64,
    nanoseconds: u32,
}

impl Duration {
    pub fn zero() Duration { ret Duration { seconds: 0, nanoseconds: 0 }; }

    pub fn from_nanoseconds(nanoseconds: u64) Duration {
        ret Duration {
            seconds: nanoseconds / 1000000000,
            nanoseconds: (nanoseconds % 1000000000) as u32,
        };
    }

    pub fn from_microseconds(microseconds: u64) Duration {
        ret Duration {
            seconds: microseconds / 1000000,
            nanoseconds: ((microseconds % 1000000) * 1000) as u32,
        };
    }

    pub fn from_milliseconds(milliseconds: u64) Duration {
        ret Duration {
            seconds: milliseconds / 1000,
            nanoseconds: ((milliseconds % 1000) * 1000000) as u32,
        };
    }

    pub fn from_seconds(seconds: u64) Duration {
        ret Duration { seconds: seconds, nanoseconds: 0 };
    }

    // Minutes and hours are fixed 60/3600-second units; None on u64 overflow.
    // Days and longer calendar units are deliberately absent.
    pub fn from_minutes(minutes: u64) Option[Duration] {
        if (minutes > 18446744073709551615 / 60) { ret None; }
        ret Some(Duration { seconds: minutes * 60, nanoseconds: 0 });
    }

    pub fn from_hours(hours: u64) Option[Duration] {
        if (hours > 18446744073709551615 / 3600) { ret None; }
        ret Some(Duration { seconds: hours * 3600, nanoseconds: 0 });
    }

    // -1, 0 or 1 as `self` is shorter than, equal to or longer than `other`.
    pub fn compare(self: &Duration, other: &Duration) i32 {
        ret __compare_parts(self.seconds as i64, self.nanoseconds, other.seconds as i64, other.nanoseconds, false);
    }

    pub fn seconds(self: &Duration) u64 { ret self.seconds; }
    pub fn subsec_nanoseconds(self: &Duration) u32 { ret self.nanoseconds; }

    pub fn checked_add(self: &Duration, other: Duration) Option[Duration] {
        var seconds: u64 = self.seconds + other.seconds;
        if seconds < self.seconds { ret None; }
        var nanoseconds: u32 = self.nanoseconds + other.nanoseconds;
        if nanoseconds >= 1000000000 {
            nanoseconds = nanoseconds - 1000000000;
            seconds = seconds + 1;
            if seconds == 0 { ret None; }
        }
        ret Some(Duration { seconds: seconds, nanoseconds: nanoseconds });
    }

    pub fn checked_sub(self: &Duration, other: Duration) Option[Duration] {
        if self.seconds < other.seconds { ret None; }
        if self.seconds == other.seconds && self.nanoseconds < other.nanoseconds { ret None; }
        var seconds: u64 = self.seconds - other.seconds;
        var nanoseconds: u32 = self.nanoseconds;
        if nanoseconds < other.nanoseconds {
            seconds = seconds - 1;
            nanoseconds = nanoseconds + 1000000000;
        }
        ret Some(Duration { seconds: seconds, nanoseconds: nanoseconds - other.nanoseconds });
    }
}

pub struct Instant {
    seconds: u64,
    nanoseconds: u32,
}

impl Instant {
    @cfg(target_os="linux")
    pub fn now() Result[Instant, TimeError] {
        var raw: *u8 = 0;
        unsafe { raw = core.malloc(16); }
        if raw == 0 { ret Err(TimeError.ClockUnavailable); }
        var status: i32 = 0;
        unsafe { status = unix.clock_gettime(1, raw); }
        if status != 0 {
            unsafe { core.free(raw); }
            ret Err(TimeError.ClockUnavailable);
        }
        var seconds: i64 = 0;
        var nanoseconds: i64 = 0;
        unsafe {
            seconds = *(raw as *i64);
            nanoseconds = *((raw + 8) as *i64);
            core.free(raw);
        }
        if seconds < 0 || nanoseconds < 0 || nanoseconds >= 1000000000 {
            ret Err(TimeError.ClockUnavailable);
        }
        ret Ok(Instant {
            seconds: seconds as u64,
            nanoseconds: nanoseconds as u32,
        });
    }

    @cfg(target_os="netbsd")
    pub fn now() Result[Instant, TimeError] {
        var raw: *u8 = 0;
        unsafe { raw = core.malloc(16); }
        if (raw == 0) { ret Err(TimeError.ClockUnavailable); }
        var status: i32 = 0;
        unsafe { status = netbsd.clock_gettime(3, raw); }
        if (status != 0) {
            unsafe { core.free(raw); }
            ret Err(TimeError.ClockUnavailable);
        }
        var seconds: i64 = 0;
        var nanoseconds: i64 = 0;
        unsafe {
            seconds = *(raw as *i64);
            nanoseconds = *((raw + 8) as *i64);
            core.free(raw);
        }
        if (seconds < 0 || nanoseconds < 0 || nanoseconds >= 1000000000) {
            ret Err(TimeError.ClockUnavailable);
        }
        ret Ok(Instant { seconds: seconds as u64, nanoseconds: nanoseconds as u32 });
    }

    @cfg(target_os="windows")
    pub fn now() Result[Instant, TimeError] {
        var milliseconds: u64 = 0;
        unsafe { milliseconds = win32_core.get_tick_count64(); }
        ret Ok(Instant {
            seconds: milliseconds / 1000,
            nanoseconds: ((milliseconds % 1000) * 1000000) as u32,
        });
    }

    pub fn duration_since(self: Instant, earlier: Instant) Result[Duration, TimeError] {
        if self.seconds < earlier.seconds {
            ret Err(TimeError.ClockWentBackwards);
        }
        if self.seconds == earlier.seconds && self.nanoseconds < earlier.nanoseconds {
            ret Err(TimeError.ClockWentBackwards);
        }
        var seconds: u64 = self.seconds - earlier.seconds;
        var nanoseconds: u32 = self.nanoseconds;
        if nanoseconds < earlier.nanoseconds {
            seconds = seconds - 1;
            nanoseconds = nanoseconds + 1000000000;
        }
        ret Ok(Duration { seconds: seconds, nanoseconds: nanoseconds - earlier.nanoseconds });
    }

    // None if the result does not fit the instant representation.
    pub fn checked_add(self: &Instant, duration: Duration) Option[Instant] {
        const sum: Option[Duration] = Duration { seconds: self.seconds, nanoseconds: self.nanoseconds }
            .checked_add(duration);
        if (sum.is_none()) { ret None; }
        const value: Duration = sum.unwrap();
        Some(Instant { seconds: value.seconds, nanoseconds: value.nanoseconds })
    }

    // -1, 0 or 1 as `self` is earlier than, equal to or later than `other`.
    pub fn compare(self: &Instant, other: &Instant) i32 {
        __compare_parts(self.seconds as i64, self.nanoseconds, other.seconds as i64, other.nanoseconds, false)
    }

    pub fn elapsed(self: Instant) Result[Duration, TimeError] {
        var current: Instant = Instant.now()?;
        ret current.duration_since(self);
    }
}

// Block the calling thread for at least `duration`, rounded up to whole
// milliseconds (the platform sleep granularity); saturates at u64::MAX ms.
pub fn sleep(duration: Duration) void {
    core.sleep_ms(__ceil_milliseconds(&duration));
}

fn __ceil_milliseconds(duration: &Duration) u64 {
    const extra: u64 = ((duration.nanoseconds as u64) + 999999) / 1000000;
    if (duration.seconds > (18446744073709551615 - extra) / 1000) { ret 18446744073709551615; }
    duration.seconds * 1000 + extra
}

// A periodic timer on the monotonic clock. Ticks are scheduled at
// start + k * period, so repeated waits do not drift; ticks missed while the
// caller was busy are skipped and reported by the next `wait`.
pub struct Interval {
    period_nanos: u64,
    next_seconds: u64,
    next_nanos: u32,
}

impl Interval {
    // The first tick is one `period` from now; a zero period is OutOfRange.
    pub fn new(period: Duration) Result[Interval, TimeError] {
        const now: Instant = Instant.now()?;
        Interval.starting_at(&now, period)
    }

    // An interval whose first tick is one `period` after `start`.
    pub fn starting_at(start: &Instant, period: Duration) Result[Interval, TimeError] {
        if (period.seconds > 18000000000 || (period.seconds == 0 && period.nanoseconds == 0)) {
            ret Err(TimeError.OutOfRange);
        }
        const nanos: u64 = period.seconds * 1000000000 + (period.nanoseconds as u64);
        var interval = Interval { period_nanos: nanos, next_seconds: start.seconds, next_nanos: start.nanoseconds };
        interval.step(1);
        Ok(interval)
    }

    fn step(self: &Interval!, ticks: u64) {
        const total: u64 = (self.next_nanos as u64) + self.period_nanos * ticks;
        self.next_seconds = self.next_seconds + total / 1000000000;
        self.next_nanos = (total % 1000000000) as u32;
    }

    // Blocks until the next tick and returns how many ticks have passed
    // (1, or more when the caller fell behind).
    pub fn wait(self: &Interval!) Result[u64, TimeError] {
        const now: Instant = Instant.now()?;
        const left: Duration = self.until(&now);
        if (left.seconds != 0 || left.nanoseconds != 0) { sleep(left); }
        const after: Instant = Instant.now()?;
        var ticks: u64 = self.advance_at(&after);
        // Millisecond sleep granularity can wake a moment early.
        for (ticks == 0) {
            sleep(Duration.from_milliseconds(1));
            const later: Instant = Instant.now()?;
            ticks = self.advance_at(&later);
        }
        Ok(ticks)
    }

    // Time from `now` until the next tick, zero if it is due.
    pub fn until(self: &Interval, now: &Instant) Duration {
        if (__compare_parts(now.seconds as i64, now.nanoseconds, self.next_seconds as i64, self.next_nanos, false) >= 0) {
            ret Duration.zero();
        }
        var seconds: u64 = self.next_seconds - now.seconds;
        var nanoseconds: u32 = self.next_nanos;
        if (nanoseconds < now.nanoseconds) {
            seconds = seconds - 1;
            nanoseconds = nanoseconds + 1000000000;
        }
        Duration { seconds: seconds, nanoseconds: nanoseconds - now.nanoseconds }
    }

    // Ticks due at `now` (0 before the next tick), moving the schedule past
    // `now`; deterministic for tests.
    pub fn advance_at(self: &Interval!, now: &Instant) u64 {
        if (__compare_parts(now.seconds as i64, now.nanoseconds, self.next_seconds as i64, self.next_nanos, false) < 0) {
            ret 0;
        }
        var late_seconds: u64 = now.seconds - self.next_seconds;
        var late_nanos: u32 = now.nanoseconds;
        if (late_nanos < self.next_nanos) {
            late_seconds = late_seconds - 1;
            late_nanos = late_nanos + 1000000000;
        }
        const late: u64 = late_seconds * 1000000000 + ((late_nanos - self.next_nanos) as u64);
        const ticks: u64 = 1 + late / self.period_nanos;
        self.step(ticks);
        ticks
    }
}

// A point on the monotonic clock by which an operation should finish.
pub struct Deadline {
    at: Instant,
}

impl Deadline {
    pub fn at(instant: Instant) Deadline { Deadline { at: instant } }

    // The deadline `duration` from now; OutOfRange if it cannot be represented.
    pub fn after(duration: Duration) Result[Deadline, TimeError] {
        const now: Instant = Instant.now()?;
        const at: Option[Instant] = now.checked_add(duration);
        if (at.is_none()) { ret Err(TimeError.OutOfRange); }
        Ok(Deadline { at: at.unwrap() })
    }

    // Time left before the deadline, or zero once it has passed.
    pub fn remaining(self: &Deadline) Result[Duration, TimeError] {
        const now: Instant = Instant.now()?;
        Ok(self.remaining_at(&now))
    }

    pub fn has_expired(self: &Deadline) Result[bool, TimeError] {
        const left: Duration = self.remaining()?;
        Ok(left.seconds == 0 && left.nanoseconds == 0)
    }

    // `remaining` measured from an explicit instant (deterministic for tests).
    pub fn remaining_at(self: &Deadline, now: &Instant) Duration {
        if (__compare_parts(now.seconds as i64, now.nanoseconds, self.at.seconds as i64, self.at.nanoseconds, false) >= 0) {
            ret Duration.zero();
        }
        var seconds: u64 = self.at.seconds - now.seconds;
        var nanoseconds: u32 = self.at.nanoseconds;
        if (nanoseconds < now.nanoseconds) {
            seconds = seconds - 1;
            nanoseconds = nanoseconds + 1000000000;
        }
        Duration { seconds: seconds, nanoseconds: nanoseconds - now.nanoseconds }
    }
}

// Order two (seconds, nanoseconds) pairs; `signed` compares seconds as i64.
fn __compare_parts(left: i64, left_nanos: u32, right: i64, right_nanos: u32, signed: bool) i32 {
    if (left != right) {
        if (signed) { ret if (left < right) { -1 } else { 1 }; }
        ret if ((left as u64) < (right as u64)) { -1 } else { 1 };
    }
    if (left_nanos == right_nanos) { ret 0; }
    ret if (left_nanos < right_nanos) { -1 } else { 1 };
}

// Unix seconds of 0001-01-01T00:00:00Z and 9999-12-31T23:59:59Z.
fn __min_unix_seconds() i64 { -62135596800 }
fn __max_unix_seconds() i64 { 253402300799 }

fn __floor_div(value: i64, divisor: i64) i64 {
    const quotient: i64 = value / divisor;
    if (value % divisor != 0 && (value < 0) != (divisor < 0)) { ret quotient - 1; }
    ret quotient;
}

fn __is_leap_year(year: i64) bool {
    ret (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
}

fn __days_in_month(year: i64, month: u32) u32 {
    if (month == 2) { ret if (__is_leap_year(year)) { 29 } else { 28 }; }
    if (month == 4 || month == 6 || month == 9 || month == 11) { ret 30; }
    31
}

// Days since 1970-01-01 of a proleptic-Gregorian date (H. Hinnant's algorithm).
fn __days_from_civil(year: i64, month: u32, day: u32) i64 {
    const shifted: i64 = if (month <= 2) { year - 1 } else { year };
    const era: i64 = __floor_div(shifted, 400);
    const year_of_era: i64 = shifted - era * 400;
    const month_index: i64 = if (month > 2) { (month as i64) - 3 } else { (month as i64) + 9 };
    const day_of_year: i64 = (153 * month_index + 2) / 5 + (day as i64) - 1;
    const day_of_era: i64 = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
    era * 146097 + day_of_era - 719468
}

// Wall-clock time as Unix seconds plus nanoseconds, UTC, without leap seconds.
pub struct SystemTime {
    seconds: i64,
    nanoseconds: u32,
}

impl SystemTime {
    // None unless `nanoseconds < 1_000_000_000` and the time is in years 0001-9999.
    pub fn from_unix(seconds: i64, nanoseconds: u32) Option[SystemTime] {
        if (nanoseconds >= 1000000000 || seconds < __min_unix_seconds() || seconds > __max_unix_seconds()) {
            ret None;
        }
        Some(SystemTime { seconds: seconds, nanoseconds: nanoseconds })
    }

    pub fn unix_epoch() SystemTime { SystemTime { seconds: 0, nanoseconds: 0 } }

    @cfg(target_os="linux")
    pub fn now() Result[SystemTime, TimeError] {
        var raw: *u8 = 0;
        unsafe { raw = core.malloc(16); }
        if (raw == 0) { ret Err(TimeError.ClockUnavailable); }
        var status: i32 = 0;
        unsafe { status = unix.clock_gettime(0, raw); }
        var seconds: i64 = 0;
        var nanoseconds: i64 = 0;
        unsafe {
            seconds = *(raw as *i64);
            nanoseconds = *((raw + 8) as *i64);
            core.free(raw);
        }
        ret __system_time_from_clock(status, seconds, nanoseconds);
    }

    @cfg(target_os="netbsd")
    pub fn now() Result[SystemTime, TimeError] {
        var raw: *u8 = 0;
        unsafe { raw = core.malloc(16); }
        if (raw == 0) { ret Err(TimeError.ClockUnavailable); }
        var status: i32 = 0;
        unsafe { status = netbsd.clock_gettime(0, raw); }
        var seconds: i64 = 0;
        var nanoseconds: i64 = 0;
        unsafe {
            seconds = *(raw as *i64);
            nanoseconds = *((raw + 8) as *i64);
            core.free(raw);
        }
        ret __system_time_from_clock(status, seconds, nanoseconds);
    }

    @cfg(target_os="windows")
    pub fn now() Result[SystemTime, TimeError] {
        var raw: *u8 = 0;
        unsafe { raw = core.malloc(8); }
        if (raw == 0) { ret Err(TimeError.ClockUnavailable); }
        var ticks: u64 = 0;
        unsafe {
            win32_core.get_system_time_as_file_time(raw);
            ticks = *(raw as *u64);
            core.free(raw);
        }
        // 11644473600 seconds separate 1601-01-01 from the Unix epoch.
        const seconds: i64 = ((ticks / 10000000) as i64) - 11644473600;
        const nanoseconds: i64 = ((ticks % 10000000) * 100) as i64;
        ret __system_time_from_clock(0, seconds, nanoseconds);
    }

    pub fn unix_seconds(self: &SystemTime) i64 { self.seconds }
    pub fn subsec_nanoseconds(self: &SystemTime) u32 { self.nanoseconds }

    // -1, 0 or 1 as `self` is earlier than, equal to or later than `other`.
    pub fn compare(self: &SystemTime, other: &SystemTime) i32 {
        __compare_parts(self.seconds, self.nanoseconds, other.seconds, other.nanoseconds, true)
    }

    // The elapsed time from `earlier` to `self`; ClockWentBackwards if negative.
    pub fn duration_since(self: &SystemTime, earlier: &SystemTime) Result[Duration, TimeError] {
        if (self.compare(earlier) < 0) { ret Err(TimeError.ClockWentBackwards); }
        var seconds: u64 = (self.seconds - earlier.seconds) as u64;
        var nanoseconds: u32 = self.nanoseconds;
        if (nanoseconds < earlier.nanoseconds) {
            seconds = seconds - 1;
            nanoseconds = nanoseconds + 1000000000;
        }
        Ok(Duration { seconds: seconds, nanoseconds: nanoseconds - earlier.nanoseconds })
    }

    // None when the result leaves years 0001-9999.
    pub fn checked_add(self: &SystemTime, duration: Duration) Option[SystemTime] {
        if (duration.seconds > (__max_unix_seconds() - __min_unix_seconds()) as u64) { ret None; }
        var seconds: i64 = self.seconds + (duration.seconds as i64);
        var nanoseconds: u32 = self.nanoseconds + duration.nanoseconds;
        if (nanoseconds >= 1000000000) {
            nanoseconds = nanoseconds - 1000000000;
            seconds = seconds + 1;
        }
        SystemTime.from_unix(seconds, nanoseconds)
    }

    pub fn checked_sub(self: &SystemTime, duration: Duration) Option[SystemTime] {
        if (duration.seconds > (__max_unix_seconds() - __min_unix_seconds()) as u64) { ret None; }
        var seconds: i64 = self.seconds - (duration.seconds as i64);
        var nanoseconds: u32 = self.nanoseconds;
        if (nanoseconds < duration.nanoseconds) {
            seconds = seconds - 1;
            nanoseconds = nanoseconds + 1000000000;
        }
        SystemTime.from_unix(seconds, nanoseconds - duration.nanoseconds)
    }

    // Proleptic-Gregorian UTC calendar fields.
    pub fn to_utc(self: &SystemTime) DateTime {
        const days: i64 = __floor_div(self.seconds, 86400);
        const second_of_day: i64 = self.seconds - days * 86400;
        // Civil-from-days (H. Hinnant), shifted so eras start on March 1.
        const shifted: i64 = days + 719468;
        const era: i64 = __floor_div(shifted, 146097);
        const day_of_era: i64 = shifted - era * 146097;
        const year_of_era: i64 = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
        const day_of_year: i64 = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
        const month_index: i64 = (5 * day_of_year + 2) / 153;
        const day: i64 = day_of_year - (153 * month_index + 2) / 5 + 1;
        const month: i64 = if (month_index < 10) { month_index + 3 } else { month_index - 9 };
        const year: i64 = year_of_era + era * 400 + if (month <= 2) { 1 } else { 0 };
        DateTime {
            year: year as i32,
            month: month as u32,
            day: day as u32,
            hour: (second_of_day / 3600) as u32,
            minute: ((second_of_day % 3600) / 60) as u32,
            second: (second_of_day % 60) as u32,
            nanosecond: self.nanoseconds,
        }
    }

    // Wall-clock fields at a fixed offset; None if they leave years 0001-9999.
    pub fn to_offset(self: &SystemTime, offset: &UtcOffset) Option[DateTime] {
        const shifted: Option[SystemTime] = SystemTime.from_unix(self.seconds + (offset.seconds as i64), self.nanoseconds);
        if (shifted.is_none()) { ret None; }
        Some(shifted.unwrap().to_utc())
    }

    // RFC 3339 text at a fixed offset, e.g. `2000-02-29T14:34:56+02:00`
    // (`Z` for UTC); None if the local fields leave years 0001-9999.
    pub fn format_rfc3339_at(self: &SystemTime, offset: &UtcOffset) Option[String] {
        const local: Option[DateTime] = self.to_offset(offset);
        if (local.is_none()) { ret None; }
        const text: String = local.unwrap().format_rfc3339();
        if (offset.seconds == 0) { ret Some(text); }
        const body: String = text[0:(text.len() as isize) - 1];
        var output: String = body.push_str(if (offset.seconds < 0) { "-" } else { "+" });
        const magnitude: i64 = if (offset.seconds < 0) { -(offset.seconds as i64) } else { offset.seconds as i64 };
        output = __push_padded(output, magnitude / 3600, 2);
        output = output.push_str(":");
        Some(__push_padded(output, (magnitude % 3600) / 60, 2))
    }

    // RFC 3339 UTC text, e.g. `2026-11-08T09:05:00Z`; nonzero fractions use
    // nine digits (`...:00.000000123Z`).
    pub fn format_rfc3339(self: &SystemTime) String {
        const civil: DateTime = self.to_utc();
        civil.format_rfc3339()
    }

    // Parse `YYYY-MM-DDTHH:MM:SS[.fraction](Z|+hh:mm|-hh:mm)`. `T`/`Z` may be
    // lowercase; at most nine fraction digits; second 60 is rejected because
    // leap seconds are not representable. The offset is applied to give UTC.
    pub fn parse_rfc3339(text: str) Result[SystemTime, TimeError] {
        const local: Option[__ParsedLocal] = __parse_local_date_time(text);
        if (local.is_none()) { ret Err(TimeError.InvalidFormat); }
        const parsed: __ParsedLocal = local.unwrap();
        const offset: Option[i64] = __parse_utc_offset(text, parsed.end);
        if (offset.is_none()) { ret Err(TimeError.InvalidFormat); }
        const naive: SystemTime = parsed.civil.to_system_time();
        const utc: Option[SystemTime] = SystemTime.from_unix(naive.seconds - offset.unwrap(), naive.nanoseconds);
        if (utc.is_none()) { ret Err(TimeError.OutOfRange); }
        Ok(utc.unwrap())
    }
}

// A validated civil date-time and the byte offset just after it.
struct __ParsedLocal {
    civil: DateTime,
    end: usize,
}

// `YYYY-MM-DDTHH:MM:SS[.fraction]`, with at most nine fraction digits.
fn __parse_local_date_time(text: str) Option[__ParsedLocal] {
    if (text.bytes_len() < 20) { ret None; }
    if (!__byte_is(text, 4, 45) || !__byte_is(text, 7, 45) || !__byte_is(text, 13, 58) || !__byte_is(text, 16, 58)) {
        ret None;
    }
    if (!__byte_is(text, 10, 84) && !__byte_is(text, 10, 116)) { ret None; }
    const year: i64 = __digits(text, 0, 4);
    const month: i64 = __digits(text, 5, 2);
    const day: i64 = __digits(text, 8, 2);
    const hour: i64 = __digits(text, 11, 2);
    const minute: i64 = __digits(text, 14, 2);
    const second: i64 = __digits(text, 17, 2);
    if (year < 1 || month < 1 || day < 1 || hour < 0 || minute < 0 || second < 0) { ret None; }
    const end: usize = __fraction_end(text, 19);
    if (end == 0) { ret None; }
    const civil: Option[DateTime] = DateTime.new(year as i32, month as u32, day as u32,
        hour as u32, minute as u32, second as u32, __fraction_nanoseconds(text, 19, end));
    if (civil.is_none()) { ret None; }
    Some(__ParsedLocal { civil: civil.unwrap(), end: end })
}

// End of an optional `.digits` fraction at `start`, or 0 if it is malformed.
fn __fraction_end(text: str, start: usize) usize {
    if (!__byte_is(text, start, 46)) { ret start; }
    var end: usize = start + 1;
    for (end < text.bytes_len() && __is_digit(core.str_byte_at(text, end))) { end = end + 1; }
    const digits: usize = end - start - 1;
    if (digits == 0 || digits > 9) { ret 0; }
    end
}

fn __fraction_nanoseconds(text: str, start: usize, end: usize) u32 {
    var nanoseconds: u32 = 0;
    var scale: u32 = 100000000;
    var index: usize = start + 1;
    for (index < end) {
        nanoseconds = nanoseconds + ((core.str_byte_at(text, index) - 48) as u32) * scale;
        scale = scale / 10;
        index = index + 1;
    }
    nanoseconds
}

// Seconds east of UTC for a final `Z`/`z` or `+hh:mm`/`-hh:mm`, else None.
fn __parse_utc_offset(text: str, start: usize) Option[i64] {
    const length: usize = text.bytes_len();
    if (start + 1 == length && (__byte_is(text, start, 90) || __byte_is(text, start, 122))) { ret Some(0); }
    if (start + 6 != length || !__byte_is(text, start + 3, 58)) { ret None; }
    if (!__byte_is(text, start, 43) && !__byte_is(text, start, 45)) { ret None; }
    const hours: i64 = __digits(text, start + 1, 2);
    const minutes: i64 = __digits(text, start + 4, 2);
    if (hours < 0 || hours > 23 || minutes < 0 || minutes > 59) { ret None; }
    const seconds: i64 = hours * 3600 + minutes * 60;
    if (__byte_is(text, start, 45)) { ret Some(-seconds); }
    Some(seconds)
}

fn __system_time_from_clock(status: i32, seconds: i64, nanoseconds: i64) Result[SystemTime, TimeError] {
    if (status != 0 || nanoseconds < 0 || nanoseconds >= 1000000000) {
        ret Err(TimeError.ClockUnavailable);
    }
    const checked: Option[SystemTime] = SystemTime.from_unix(seconds, nanoseconds as u32);
    if (checked.is_none()) { ret Err(TimeError.OutOfRange); }
    Ok(checked.unwrap())
}

fn __is_digit(byte: u8) bool { byte >= 48 && byte <= 57 }

fn __byte_is(text: str, index: usize, expected: u8) bool {
    index < text.bytes_len() && core.str_byte_at(text, index) == expected
}

// Value of `count` ASCII digits at `start`, or -1 if any is not a digit.
fn __digits(text: str, start: usize, count: usize) i64 {
    if (start + count > text.bytes_len()) { ret -1; }
    var value: i64 = 0;
    for i : start..(start + count) {
        const byte: u8 = core.str_byte_at(text, i);
        if (!__is_digit(byte)) { ret -1; }
        value = value * 10 + ((byte - 48) as i64);
    }
    value
}

fn __push_padded(output: String, value: i64, width: usize) String {
    var digits: String = String.from(value.to_str());
    var result: String = output;
    var padding: usize = digits.bytes_len();
    for (padding < width) {
        result = result.push_str("0");
        padding = padding + 1;
    }
    result.push_str(digits.as_str())
}

// A fixed offset from UTC in whole minutes, -23:59 through +23:59. It is not
// a time zone: it carries no daylight-saving rules.
pub struct UtcOffset {
    seconds: i32,
}

impl UtcOffset {
    pub fn utc() UtcOffset { UtcOffset { seconds: 0 } }

    // `hours` carries the sign; `minutes` is 0-59 (e.g. (-5, 30) is -05:30).
    pub fn from_hours_minutes(hours: i32, minutes: i32) Option[UtcOffset] {
        if (hours < -23 || hours > 23 || minutes < 0 || minutes > 59) { ret None; }
        const magnitude: i32 = (if (hours < 0) { -hours } else { hours }) * 3600 + minutes * 60;
        Some(UtcOffset { seconds: if (hours < 0) { -magnitude } else { magnitude } })
    }

    // Seconds east of UTC.
    pub fn seconds(self: &UtcOffset) i32 { self.seconds }
}

// A proleptic-Gregorian UTC date and time of day.
pub struct DateTime {
    year: i32,
    month: u32,
    day: u32,
    hour: u32,
    minute: u32,
    second: u32,
    nanosecond: u32,
}

impl DateTime {
    // None unless every field is in range for years 0001-9999 (seconds 0-59).
    pub fn new(year: i32, month: u32, day: u32, hour: u32, minute: u32, second: u32, nanosecond: u32) Option[DateTime] {
        if (year < 1 || year > 9999 || month < 1 || month > 12) { ret None; }
        if (day < 1 || day > __days_in_month(year as i64, month)) { ret None; }
        if (hour > 23 || minute > 59 || second > 59 || nanosecond >= 1000000000) { ret None; }
        Some(DateTime {
            year: year, month: month, day: day,
            hour: hour, minute: minute, second: second, nanosecond: nanosecond,
        })
    }

    pub fn year(self: &DateTime) i32 { self.year }
    pub fn month(self: &DateTime) u32 { self.month }
    pub fn day(self: &DateTime) u32 { self.day }
    pub fn hour(self: &DateTime) u32 { self.hour }
    pub fn minute(self: &DateTime) u32 { self.minute }
    pub fn second(self: &DateTime) u32 { self.second }
    pub fn nanosecond(self: &DateTime) u32 { self.nanosecond }

    // ISO weekday: 1 = Monday ... 7 = Sunday.
    pub fn weekday(self: &DateTime) u32 {
        const days: i64 = __days_from_civil(self.year as i64, self.month, self.day);
        // 1970-01-01 was a Thursday (4).
        (((days % 7) + 7 + 3) % 7 + 1) as u32
    }

    pub fn to_system_time(self: &DateTime) SystemTime {
        const days: i64 = __days_from_civil(self.year as i64, self.month, self.day);
        const seconds: i64 = days * 86400 + (self.hour as i64) * 3600 + (self.minute as i64) * 60 + (self.second as i64);
        SystemTime { seconds: seconds, nanoseconds: self.nanosecond }
    }

    pub fn format_rfc3339(self: &DateTime) String {
        var output: String = String.new();
        output = __push_padded(output, self.year as i64, 4);
        output = output.push_str("-");
        output = __push_padded(output, self.month as i64, 2);
        output = output.push_str("-");
        output = __push_padded(output, self.day as i64, 2);
        output = output.push_str("T");
        output = __push_padded(output, self.hour as i64, 2);
        output = output.push_str(":");
        output = __push_padded(output, self.minute as i64, 2);
        output = output.push_str(":");
        output = __push_padded(output, self.second as i64, 2);
        if (self.nanosecond != 0) {
            output = output.push_str(".");
            output = __push_padded(output, self.nanosecond as i64, 9);
        }
        output.push_str("Z")
    }
}

@test
fn duration_construction_normalizes_subsecond_units() void {
    const nanos = Duration.from_nanoseconds(1000000001);
    if nanos.seconds() != 1 || nanos.subsec_nanoseconds() != 1 {
        panic("nanosecond duration was not normalized");
    }
    const micros = Duration.from_microseconds(1000001);
    if micros.seconds() != 1 || micros.subsec_nanoseconds() != 1000 {
        panic("microsecond duration was not normalized");
    }
    const millis = Duration.from_milliseconds(1501);
    if millis.seconds() != 1 || millis.subsec_nanoseconds() != 501000000 {
        panic("millisecond duration was not normalized");
    }
    ret;
}

@test
fn duration_checked_arithmetic_carries_and_rejects_negative_results() void {
    const carried = Duration.from_nanoseconds(999999999).checked_add(Duration.from_nanoseconds(1));
    if carried.is_none() {
        panic("valid duration addition failed");
    }
    const value = carried.unwrap();
    if value.seconds() != 1 || value.subsec_nanoseconds() != 0 {
        panic("duration addition did not carry into seconds");
    }
    const borrowed = Duration.from_seconds(1).checked_sub(Duration.from_nanoseconds(1));
    if borrowed.is_none() {
        panic("valid duration subtraction failed");
    }
    const borrowed_value = borrowed.unwrap();
    if borrowed_value.seconds() != 0 || borrowed_value.subsec_nanoseconds() != 999999999 {
        panic("duration subtraction did not borrow from seconds");
    }
    const negative = Duration.from_seconds(1).checked_sub(Duration.from_seconds(2));
    if negative.is_some() {
        panic("negative duration subtraction must fail");
    }
    const maximum_seconds: u64 = 0 - 1;
    const literal_maximum_seconds: u64 = 18446744073709551615;
    if literal_maximum_seconds != maximum_seconds {
        panic("the largest u64 literal did not retain its value");
    }
    const maximum = Duration { seconds: maximum_seconds, nanoseconds: 999999999 };
    if maximum.checked_add(Duration.from_nanoseconds(1)).is_some() {
        panic("nanosecond carry beyond the maximum duration must fail");
    }
    if Duration { seconds: maximum_seconds, nanoseconds: 0 }
        .checked_add(Duration.zero()).is_none() {
        panic("adding zero must preserve the maximum whole-second duration");
    }
    ret;
}

@test
fn instant_duration_since_borrows_and_rejects_backwards_time() void {
    const earlier = Instant { seconds: 7, nanoseconds: 900000000 };
    const later = Instant { seconds: 8, nanoseconds: 100000000 };
    if (earlier.compare(&later) != -1 || later.compare(&earlier) != 1 || later.compare(&later) != 0) {
        panic("instant comparison is wrong");
    }
    const elapsed = later.duration_since(earlier);
    if elapsed.is_err() {
        panic("valid instant comparison failed");
    }
    const duration = elapsed.unwrap();
    if duration.seconds() != 0 || duration.subsec_nanoseconds() != 200000000 {
        panic("instant duration did not borrow from seconds");
    }
    const backwards = Instant { seconds: 7, nanoseconds: 900000000 }
        .duration_since(Instant { seconds: 8, nanoseconds: 100000000 });
    if backwards.is_ok() {
        panic("backwards instant comparison must fail");
    }
    ret;
}

@test
fn duration_minutes_and_hours_are_fixed_and_checked() void {
    if (Duration.from_minutes(2).unwrap().seconds() != 120) { panic("minutes are 60 seconds"); }
    if (Duration.from_hours(3).unwrap().seconds() != 10800) { panic("hours are 3600 seconds"); }
    if (Duration.from_minutes(18446744073709551615).is_some()) { panic("minute overflow accepted"); }
    if (Duration.from_hours(5124095576030432).is_some()) { panic("hour overflow accepted"); }
    const short = Duration.from_milliseconds(1);
    const long = Duration.from_seconds(1);
    if (short.compare(&long) != -1 || long.compare(&short) != 1 || long.compare(&long) != 0) {
        panic("duration comparison is wrong");
    }
}

@test
fn system_time_converts_known_unix_instants_to_utc() void {
    const epoch = SystemTime.unix_epoch().to_utc();
    if (epoch.year() != 1970 || epoch.month() != 1 || epoch.day() != 1 || epoch.weekday() != 4) {
        panic("Unix epoch is not Thursday 1970-01-01");
    }
    // 2000-02-29T12:34:56Z, a leap day in a 400-year leap year.
    const leap = SystemTime.from_unix(951827696, 0).unwrap().to_utc();
    if (leap.year() != 2000 || leap.month() != 2 || leap.day() != 29 || leap.hour() != 12
        || leap.minute() != 34 || leap.second() != 56 || leap.weekday() != 2) {
        panic("2000-02-29 conversion is wrong");
    }
    // One second before the epoch uses floor division.
    const before = SystemTime.from_unix(-1, 0).unwrap().to_utc();
    if (before.year() != 1969 || before.month() != 12 || before.day() != 31 || before.second() != 59) {
        panic("negative Unix time conversion is wrong");
    }
    const earliest = SystemTime.from_unix(-62135596800, 0).unwrap().to_utc();
    if (earliest.year() != 1 || earliest.month() != 1 || earliest.day() != 1) { panic("year 1 lower bound is wrong"); }
    if (SystemTime.from_unix(-62135596801, 0).is_some() || SystemTime.from_unix(253402300800, 0).is_some()) {
        panic("out-of-range Unix seconds were accepted");
    }
    if (SystemTime.from_unix(0, 1000000000).is_some()) { panic("unnormalized nanoseconds were accepted"); }
}

@test
fn date_time_validates_fields_and_round_trips() void {
    if (DateTime.new(1900, 2, 29, 0, 0, 0, 0).is_some()) { panic("1900 is not a leap year"); }
    if (DateTime.new(2024, 2, 29, 0, 0, 0, 0).is_none()) { panic("2024-02-29 exists"); }
    if (DateTime.new(2024, 4, 31, 0, 0, 0, 0).is_some()) { panic("April has 30 days"); }
    if (DateTime.new(2024, 1, 1, 24, 0, 0, 0).is_some() || DateTime.new(2024, 1, 1, 0, 0, 60, 0).is_some()) {
        panic("out-of-range time of day accepted");
    }
    const civil = DateTime.new(9999, 12, 31, 23, 59, 59, 999999999).unwrap();
    const upper = civil.to_system_time();
    if (upper.unix_seconds() != 253402300799) { panic("year 9999 upper bound is wrong"); }
    const back = upper.to_utc();
    if (back.year() != 9999 || back.nanosecond() != 999999999) { panic("civil round trip lost fields"); }
}

@test
fn rfc3339_formats_and_parses_utc_and_offsets() void {
    const text: String = SystemTime.from_unix(951827696, 5).unwrap().format_rfc3339();
    if (text.as_str() != "2000-02-29T12:34:56.000000005Z") { panic("fractional RFC 3339 formatting is wrong"); }
    const whole: String = SystemTime.from_unix(-62135596800, 0).unwrap().format_rfc3339();
    if (whole.as_str() != "0001-01-01T00:00:00Z") { panic("whole-second RFC 3339 formatting is wrong"); }
    const parsed = SystemTime.parse_rfc3339("2000-02-29T14:34:56.5+02:00");
    if (parsed.is_err()) { panic("valid offset timestamp rejected"); }
    const value = parsed.unwrap();
    if (value.unix_seconds() != 951827696 || value.subsec_nanoseconds() != 500000000) {
        panic("offset was not normalized to UTC");
    }
    const negative = SystemTime.parse_rfc3339("1969-12-31t19:00:00-05:00").unwrap();
    if (negative.unix_seconds() != 0) { panic("negative offset or lowercase t was mishandled"); }
    for bad : ["2000-02-30T00:00:00Z", "2000-01-01T00:00:60Z", "2000-01-01 00:00:00Z",
               "2000-01-01T00:00:00", "2000-01-01T00:00:00.Z", "2000-01-01T00:00:00.1234567890Z",
               "2000-01-01T00:00:00+24:00", "0000-12-31T00:00:00Z", "20x0-01-01T00:00:00Z"] {
        if (SystemTime.parse_rfc3339(bad).is_ok()) { panic("invalid RFC 3339 text was accepted"); }
    }
    if (SystemTime.parse_rfc3339("0001-01-01T00:00:00+00:01").is_ok()) { panic("pre-year-1 UTC accepted"); }
}

@test
fn system_time_arithmetic_and_ordering_are_checked() void {
    const start = SystemTime.from_unix(10, 900000000).unwrap();
    const later = start.checked_add(Duration.from_milliseconds(200)).unwrap();
    if (later.unix_seconds() != 11 || later.subsec_nanoseconds() != 100000000) { panic("add did not carry"); }
    if (later.compare(&start) != 1 || start.compare(&later) != -1) { panic("ordering is wrong"); }
    const elapsed = later.duration_since(&start).unwrap();
    if (elapsed.seconds() != 0 || elapsed.subsec_nanoseconds() != 200000000) { panic("duration_since is wrong"); }
    if (start.duration_since(&later).is_ok()) { panic("negative duration accepted"); }
    const back = later.checked_sub(Duration.from_milliseconds(200)).unwrap();
    if (back.compare(&start) != 0) { panic("sub did not borrow"); }
    const last = SystemTime.from_unix(253402300799, 0).unwrap();
    if (last.checked_add(Duration.from_seconds(1)).is_some()) { panic("add past year 9999 accepted"); }
    if (SystemTime.unix_epoch().checked_sub(Duration.from_seconds(62135596801)).is_some()) {
        panic("sub before year 1 accepted");
    }
}

@test
fn system_time_now_is_after_2020() void {
    const now = SystemTime.now();
    if (now.is_err()) { panic("wall clock unavailable"); }
    // 2020-01-01T00:00:00Z; a sanity bound, not a dependency on the local zone.
    if (now.unwrap().unix_seconds() < 1577836800) { panic("wall clock is before 2020"); }
}

@test
fn deadline_remaining_counts_down_and_stops_at_zero() void {
    const deadline = Deadline.at(Instant { seconds: 10, nanoseconds: 500000000 });
    const before = Instant { seconds: 9, nanoseconds: 700000000 };
    const early = deadline.remaining_at(&before);
    if (early.seconds() != 0 || early.subsec_nanoseconds() != 800000000) { panic("remaining time is wrong"); }
    const after = Instant { seconds: 11, nanoseconds: 0 };
    const late = deadline.remaining_at(&after);
    if (late.seconds() != 0 || late.subsec_nanoseconds() != 0) { panic("an expired deadline must report zero"); }
    const huge = Instant { seconds: 18446744073709551615, nanoseconds: 999999999 };
    if (huge.checked_add(Duration.from_nanoseconds(1)).is_some()) { panic("instant overflow accepted"); }
}

@test
fn sleep_rounds_up_and_waits_at_least_the_duration() void {
    const tiny = Duration.from_nanoseconds(1);
    const whole = Duration.from_milliseconds(1500);
    if (__ceil_milliseconds(&tiny) != 1) { panic("partial millisecond not rounded up"); }
    if (__ceil_milliseconds(&whole) != 1500) { panic("whole milliseconds changed"); }
    const maximum = Duration { seconds: 18446744073709551615, nanoseconds: 0 };
    if (__ceil_milliseconds(&maximum) != 18446744073709551615) { panic("millisecond conversion did not saturate"); }
    // A lower bound only: the scheduler may wake later, never earlier.
    const start = Instant.now().unwrap();
    sleep(Duration.from_milliseconds(5));
    const elapsed = start.elapsed().unwrap();
    const requested = Duration.from_milliseconds(5);
    if (elapsed.compare(&requested) < 0) { panic("sleep returned early"); }
}

@test
fn utc_offsets_shift_wall_fields_and_format() void {
    if (UtcOffset.from_hours_minutes(24, 0).is_some() || UtcOffset.from_hours_minutes(1, 60).is_some()) {
        panic("out-of-range offset accepted");
    }
    const east = UtcOffset.from_hours_minutes(2, 0).unwrap();
    const west = UtcOffset.from_hours_minutes(-5, 30).unwrap();
    if (west.seconds() != -19800) { panic("negative offset sign is wrong"); }
    const instant = SystemTime.from_unix(951827696, 0).unwrap();
    const local = instant.to_offset(&east).unwrap();
    if (local.hour() != 14 || local.minute() != 34) { panic("east offset did not shift the hour"); }
    const text: String = instant.format_rfc3339_at(&west).unwrap();
    if (text.as_str() != "2000-02-29T07:04:56-05:30") { panic("negative offset formatting is wrong"); }
    const parsed = SystemTime.parse_rfc3339(text.as_str()).unwrap();
    if (parsed.compare(&instant) != 0) { panic("offset text did not round-trip"); }
    const utc = UtcOffset.utc();
    const zulu: String = instant.format_rfc3339_at(&utc).unwrap();
    if (zulu.as_str() != "2000-02-29T12:34:56Z") { panic("zero offset must use Z"); }
    const last = SystemTime.from_unix(253402300799, 0).unwrap();
    if (last.to_offset(&east).is_some()) { panic("local fields past year 9999 accepted"); }
}

@test
fn intervals_tick_without_drift_and_count_missed_ticks() {
    const start = Instant { seconds: 100, nanoseconds: 900000000 };
    var interval = Interval.starting_at(&start, Duration.from_milliseconds(250)).unwrap();
    const early = Instant { seconds: 101, nanoseconds: 100000000 };
    if (interval.advance_at(&early) != 0) { panic("ticked early"); }
    if (interval.until(&early).subsec_nanoseconds() != 50000000) { panic("until"); }
    const due = Instant { seconds: 101, nanoseconds: 150000000 };
    if (interval.advance_at(&due) != 1) { panic("due tick"); }
    // 1.2 s late: the tick at 101.40 plus four more periods were missed.
    const late = Instant { seconds: 102, nanoseconds: 600000000 };
    if (interval.advance_at(&late) != 5) { panic("missed ticks"); }
    // The schedule stays on the 250 ms grid: next tick at 102.65.
    if (interval.until(&late).subsec_nanoseconds() != 50000000) { panic("grid"); }
    if (Interval.new(Duration.zero()).is_ok()) { panic("zero period"); }
    var real = Interval.new(Duration.from_milliseconds(5)).unwrap();
    if (real.wait().unwrap() < 1) { panic("wait"); }
}
