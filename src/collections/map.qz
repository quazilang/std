// std.collections.map — open-addressing hash map (linear probing, tombstone delete)
// Keys and values are usize. Generic owned storage requires trait bounds and
// drop-aware slots, which the language does not expose yet.
// Resize at 75% load; initial capacity 16.
import std.core;

@intrinsic("quazi.array.store")
fn __map_store(base: *u8, idx: usize, val: usize) void;

@intrinsic("quazi.array.load")
fn __map_load(base: *u8, idx: usize) usize;

// flags slot values: 0 = empty, 1 = used, 2 = tombstone
pub enum MapError {
    AllocationFailed,
    CapacityOverflow,
}

pub struct Map {
    keys:  *u8,
    vals:  *u8,
    flags: *u8,
    len:   usize,
    cap:   usize,
}

impl Map {
    pub fn new() Result[Map, MapError] {
        var keys:  *u8 = 0;
        var vals:  *u8 = 0;
        var flags: *u8 = 0;
        unsafe {
            keys  = core.malloc(128);
            if (keys == 0) { ret Err(MapError.AllocationFailed); }
            vals  = core.malloc(128);
            if (vals == 0) {
                core.free(keys);
                ret Err(MapError.AllocationFailed);
            }
            flags = core.malloc(128);
            if (flags == 0) {
                core.free(keys);
                core.free(vals);
                ret Err(MapError.AllocationFailed);
            }
            core.memset(flags, 0, 128);
        }
        ret Ok(Map { keys: keys, vals: vals, flags: flags, len: 0, cap: 16 });
    }

    @ignore
    fn __hash(self: Map, key: usize) usize {
        ret (key * 2654435761) % self.cap;
    }

    // Methods borrow `self`; returning a second Map would duplicate this
    // allocation owner. Mutate the one owner in place instead.
    pub fn insert(self: Map, key: usize, val: usize) Result[bool, MapError] {
        if (self.len * 4 >= self.cap * 3) {
            self.__grow()?;
        }
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        var first_tomb: usize = self.cap;
        var target: usize = self.cap;
        var replacing: bool = false;
        for (probe < self.cap) {
            var f: usize = __map_load(self.flags, idx);
            if (f == 0) {
                target = idx;
                if (first_tomb < self.cap) {
                    target = first_tomb;
                }
                break;
            }
            if (f == 1) {
                var k: usize = __map_load(self.keys, idx);
                if (k == key) {
                    target = idx;
                    replacing = true;
                    break;
                }
            }
            if (f == 2) {
                if (first_tomb >= self.cap) {
                    first_tomb = idx;
                }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        if (target >= self.cap && first_tomb < self.cap) {
            target = first_tomb;
        }
        if (target < self.cap) {
            __map_store(self.vals, target, val);
            if (replacing) { ret Ok(false); }
            __map_store(self.flags, target, 1);
            __map_store(self.keys, target, key);
            self.len = self.len + 1;
            ret Ok(true);
        }
        ret Ok(false);
    }

    pub fn get(self: Map, key: usize) Option[usize] {
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        for (probe < self.cap) {
            var f: usize = __map_load(self.flags, idx);
            if (f == 0) {
                ret None;
            }
            if (f == 1) {
                var k: usize = __map_load(self.keys, idx);
                if (k == key) {
                    ret Some(__map_load(self.vals, idx));
                }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        ret None;
    }

    pub fn contains(self: Map, key: usize) bool {
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        for (probe < self.cap) {
            var f: usize = __map_load(self.flags, idx);
            if (f == 0) { ret false; }
            if (f == 1) {
                var k: usize = __map_load(self.keys, idx);
                if (k == key) { ret true; }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        ret false;
    }

    pub fn remove(self: Map, key: usize) bool {
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        for (probe < self.cap) {
            var f: usize = __map_load(self.flags, idx);
            if (f == 0) { ret false; }
            if (f == 1) {
                var k: usize = __map_load(self.keys, idx);
                if (k == key) {
                    __map_store(self.flags, idx, 2);
                    self.len = self.len - 1;
                    ret true;
                }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        ret false;
    }

    pub fn len(self: Map) usize {
        ret self.len;
    }

    pub fn free(self: Map) void {
        unsafe {
            core.free(self.keys);
            core.free(self.vals);
            core.free(self.flags);
        }
    }

    @ignore
    fn __grow(self: Map) Result[bool, MapError] {
        // Doubling and converting slots to bytes must both fit in usize.
        if (self.cap > 1152921504606846975) {
            ret Err(MapError.CapacityOverflow);
        }
        var new_cap: usize = self.cap * 2;
        var new_keys:  *u8 = 0;
        var new_vals:  *u8 = 0;
        var new_flags: *u8 = 0;
        unsafe {
            new_keys  = core.malloc(new_cap * 8);
            if (new_keys == 0) { ret Err(MapError.AllocationFailed); }
            new_vals  = core.malloc(new_cap * 8);
            if (new_vals == 0) {
                core.free(new_keys);
                ret Err(MapError.AllocationFailed);
            }
            new_flags = core.malloc(new_cap * 8);
            if (new_flags == 0) {
                core.free(new_keys);
                core.free(new_vals);
                ret Err(MapError.AllocationFailed);
            }
            core.memset(new_flags, 0, new_cap * 8);
        }
        var i: usize = 0;
        for (i < self.cap) {
            var f: usize = __map_load(self.flags, i);
            if (f == 1) {
                var k: usize = __map_load(self.keys, i);
                var v: usize = __map_load(self.vals, i);
                var idx: usize = (k * 2654435761) % new_cap;
                for (__map_load(new_flags, idx) == 1) {
                    idx = (idx + 1) % new_cap;
                }
                __map_store(new_keys, idx, k);
                __map_store(new_vals, idx, v);
                __map_store(new_flags, idx, 1);
            }
            i = i + 1;
        }
        unsafe {
            core.free(self.keys);
            core.free(self.vals);
            core.free(self.flags);
        }
        self.keys = new_keys;
        self.vals = new_vals;
        self.flags = new_flags;
        self.cap = new_cap;
        ret Ok(true);
    }
}
