// std.collections.set — open-addressing hash set (linear probing, tombstone delete)
// Elements are usize values.
// Resize at 75% load; initial capacity 16.
import std.core;

@intrinsic("quazi.array.store")
fn __set_store(base: *u8, idx: usize, val: usize) void;

@intrinsic("quazi.array.load")
fn __set_load(base: *u8, idx: usize) usize;

// flags slot values: 0 = empty, 1 = used, 2 = tombstone
pub enum SetError {
    AllocationFailed,
    CapacityOverflow,
}

pub struct Set {
    keys:  *u8,
    flags: *u8,
    len:   usize,
    cap:   usize,
}

impl Set {
    pub fn new() Result[Set, SetError] {
        var keys:  *u8 = 0;
        var flags: *u8 = 0;
        unsafe {
            keys  = core.malloc(128);
            if (keys == 0) { ret Err(SetError.AllocationFailed); }
            flags = core.malloc(128);
            if (flags == 0) {
                core.free(keys);
                ret Err(SetError.AllocationFailed);
            }
            core.memset(flags, 0, 128);
        }
        ret Ok(Set { keys: keys, flags: flags, len: 0, cap: 16 });
    }

    @ignore
    fn __hash(self: Set, key: usize) usize {
        ret (key * 2654435761) % self.cap;
    }

    // Methods borrow `self`; returning a second Set would duplicate this
    // allocation owner. Mutate the one owner in place instead.
    pub fn insert(self: Set, key: usize) Result[bool, SetError] {
        if (self.len * 4 >= self.cap * 3) {
            self.__grow()?;
        }
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        var first_tomb: usize = self.cap;
        for (probe < self.cap) {
            var f: usize = __set_load(self.flags, idx);
            if (f == 0) {
                var target: usize = idx;
                if (first_tomb < self.cap) {
                    target = first_tomb;
                }
                __set_store(self.flags, target, 1);
                __set_store(self.keys, target, key);
                self.len = self.len + 1;
                ret Ok(true);
            }
            if (f == 1) {
                var k: usize = __set_load(self.keys, idx);
                if (k == key) {
                    ret Ok(false);
                }
            }
            if (f == 2) {
                if (first_tomb >= self.cap) {
                    first_tomb = idx;
                }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        if (first_tomb < self.cap) {
            __set_store(self.flags, first_tomb, 1);
            __set_store(self.keys, first_tomb, key);
            self.len = self.len + 1;
            ret Ok(true);
        }
        ret Ok(false);
    }

    pub fn contains(self: Set, key: usize) bool {
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        for (probe < self.cap) {
            var f: usize = __set_load(self.flags, idx);
            if (f == 0) { ret false; }
            if (f == 1) {
                var k: usize = __set_load(self.keys, idx);
                if (k == key) { ret true; }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        ret false;
    }

    pub fn remove(self: Set, key: usize) bool {
        var idx: usize = self.__hash(key);
        var probe: usize = 0;
        for (probe < self.cap) {
            var f: usize = __set_load(self.flags, idx);
            if (f == 0) { ret false; }
            if (f == 1) {
                var k: usize = __set_load(self.keys, idx);
                if (k == key) {
                    __set_store(self.flags, idx, 2);
                    self.len = self.len - 1;
                    ret true;
                }
            }
            idx = (idx + 1) % self.cap;
            probe = probe + 1;
        }
        ret false;
    }

    pub fn len(self: Set) usize {
        ret self.len;
    }

    pub fn free(self: Set) void {
        if (self.keys != 0) {
            unsafe {
                core.free(self.keys);
                core.free(self.flags);
            }
            self.keys = 0;
            self.flags = 0;
            self.len = 0;
            self.cap = 0;
        }
    }

    @ignore
    fn __grow(self: Set) Result[bool, SetError] {
        // Doubling and converting slots to bytes must both fit in usize.
        if (self.cap > 1152921504606846975) {
            ret Err(SetError.CapacityOverflow);
        }
        var new_cap: usize = self.cap * 2;
        var new_keys:  *u8 = 0;
        var new_flags: *u8 = 0;
        unsafe {
            new_keys  = core.malloc(new_cap * 8);
            if (new_keys == 0) { ret Err(SetError.AllocationFailed); }
            new_flags = core.malloc(new_cap * 8);
            if (new_flags == 0) {
                core.free(new_keys);
                ret Err(SetError.AllocationFailed);
            }
            core.memset(new_flags, 0, new_cap * 8);
        }
        var i: usize = 0;
        for (i < self.cap) {
            var f: usize = __set_load(self.flags, i);
            if (f == 1) {
                var k: usize = __set_load(self.keys, i);
                var idx: usize = (k * 2654435761) % new_cap;
                for (__set_load(new_flags, idx) == 1) {
                    idx = (idx + 1) % new_cap;
                }
                __set_store(new_keys, idx, k);
                __set_store(new_flags, idx, 1);
            }
            i = i + 1;
        }
        unsafe {
            core.free(self.keys);
            core.free(self.flags);
        }
        self.keys = new_keys;
        self.flags = new_flags;
        self.cap = new_cap;
        ret Ok(true);
    }
}
