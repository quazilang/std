// std.core — platform-neutral intrinsics
// Import this for cross-platform I/O, memory, and process primitives.
// These lower to the appropriate syscall/Win32/libc call per target at AOT time.
// @no_std disables automatic std availability.
//
// UTF-8 contract:
//   str / &str / String are ALWAYS valid UTF-8.
//   Do NOT pass arbitrary bytes through str — use *u8 or [u8; N] for raw data.

// ── I/O ──────────────────────────────────────────────────────────────────────

// Raw text write. Unsafe because `count` may exceed the readable string bytes.
@intrinsic("quazi.write")
pub unsafe fn write(fd: i32, buf: str, count: usize) isize;

// Write raw bytes to fd. Unsafe — buf may contain non-UTF-8 bytes.
@intrinsic("quazi.write")
pub unsafe fn write_bytes(fd: i32, buf: *u8, count: usize) isize;

// Read raw bytes from fd into buf. Unsafe — caller must validate UTF-8 if converting to str.
@intrinsic("quazi.read")
pub unsafe fn read(fd: i32, buf: *u8, count: usize) isize;

@intrinsic("quazi.stderr_write")
pub unsafe fn stderr_write(buf: str, len: usize) isize;

// ── Process ──────────────────────────────────────────────────────────────────

@intrinsic("quazi.exit")
pub fn exit(code: i32) i32;

@intrinsic("quazi.sleep_ms")
pub fn sleep_ms(ms: u64) void;

// Returns pointer to null-terminated C string, or null on not found.
@intrinsic("quazi.getenv")
pub unsafe fn getenv(name: str) *u8;

// Fill `buf` with the platform hostname and return its byte length. Returns -1
// when the buffer is empty/too small or the operating-system query fails.
@intrinsic("quazi.os.hostname")
pub unsafe fn hostname(buf: *u8, capacity: usize) isize;

// Cross-platform physical-memory totals in bytes. A return value of zero means
// the host query failed.
@intrinsic("quazi.os.memory_total")
pub fn memory_total() u64;

@intrinsic("quazi.os.memory_available")
pub fn memory_available() u64;

// ── Memory ───────────────────────────────────────────────────────────────────

// Returns pointer to allocated heap block, or null on failure.
@intrinsic("quazi.malloc")
pub unsafe fn malloc(size: usize) *u8;

@intrinsic("quazi.free")
pub unsafe fn free(ptr: *u8) void;

// Returns pointer to resized block (may differ from ptr), or null on failure.
@intrinsic("quazi.realloc")
pub unsafe fn realloc(ptr: *u8, size: usize) *u8;

@intrinsic("quazi.memcpy")
pub unsafe fn memcpy(dst: *u8, src: *u8, n: usize) *u8;

@intrinsic("quazi.memset")
pub unsafe fn memset(ptr: *u8, val: i32, n: usize) *u8;

@intrinsic("quazi.memmove")
pub unsafe fn memmove(dst: *u8, src: *u8, n: usize) *u8;

@intrinsic("quazi.memcmp")
pub unsafe fn memcmp(a: *u8, b: *u8, n: usize) i32;

// ── String ───────────────────────────────────────────────────────────────────

// Returns byte length of null-terminated C string. str is valid UTF-8 here.
@intrinsic("quazi.strlen")
pub fn strlen(s: str) usize;

// Concatenate two strings into a new heap-allocated null-terminated string.
// Caller is responsible for freeing the returned pointer with core.free.
@intrinsic("quazi.str_concat")
pub fn str_concat(s1: str, s2: str) str;

// Convert i64 to heap-allocated decimal string. Caller must free with core.free.
@intrinsic("quazi.int_to_str")
pub fn int_to_str(n: i64) str;

// Convert f64 to heap-allocated decimal string. Caller must free with core.free.
@intrinsic("quazi.float_to_str")
pub fn float_to_str(f: f64) str;

// Return the byte at index i in s (no bounds check — caller ensures i < strlen(s)).
@intrinsic("quazi.str.byte_at")
pub fn str_byte_at(s: str, i: usize) u8;

// Allocate a 2-byte heap buffer containing byte b followed by '\0', returned as str.
// Useful for building strings byte-by-byte. Caller must free with core.free.
@intrinsic("quazi.str.from_byte")
pub fn str_from_byte(b: u8) str;

// Borrow the address of immutable UTF-8 text for pointer-correct native API
// calls. The pointer is valid only as long as `s` remains alive and must never
// be freed or written through.
@intrinsic("quazi.str.as_ptr")
pub unsafe fn str_as_ptr(s: str) *u8;

// Representation-only view of a NUL-terminated pointer after the caller has
// established that the bytes are valid UTF-8. The returned str is borrowed.
@intrinsic("quazi.str.from_ptr")
pub unsafe fn str_from_ptr(ptr: *u8) str;
