// std.posix — Unix-specific process facilities (Linux and NetBSD).
// These wrap native calls and return raw native results; std.os holds the
// portable surface. On other targets the signed-result functions return -1
// and the unsigned ones return u32::MAX as an unsupported-target sentinel.
import std.core;
import std.unix;
@cfg(target_os = "netbsd")
import std.netbsd;

// The current Linux environment: a null-terminated array of `NAME=VALUE`
// C string pointers. Arrays are never freed, so it stays readable.
pub unsafe fn linux_environment() *u8 {
    ret *((core.runtime_state() + 112) as **u8);
}

// Fill buf with the current working directory path (null-terminated).
// Returns number of bytes written (including null) or negative on error.
// buf must be at least size bytes long.
pub unsafe fn cwd(buf: str, size: usize) isize {
    @cfg(target_os = "linux") { ret unix.getcwd(buf, size); }
    @cfg(target_os = "netbsd") { ret netbsd.getcwd(buf, size); }
    ret -1;
}

// ── Identities ───────────────────────────────────────────────────────────────

// Returns the user ID of the current process.
pub fn getuid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = unix.getuid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.getuid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// Returns the group ID of the current process.
pub fn getgid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = unix.getgid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.getgid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// Returns the effective user ID.
pub fn geteuid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = unix.geteuid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.geteuid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// Returns the effective group ID.
pub fn getegid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = unix.getegid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.getegid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// ── Signals ───────────────────────────────────────────────────────────────────

// Send signal sig to process pid. Common signals: SIGTERM=15, SIGKILL=9, SIGINT=2.
pub fn kill(pid: i32, sig: i32) i32 {
    @cfg(target_os = "linux") {
        var r: i32 = 0;
        unsafe { r = unix.kill(pid, sig); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: i32 = 0;
        unsafe { r = netbsd.kill(pid, sig); }
        ret r;
    }
    ret -1;
}

// ── Umask ────────────────────────────────────────────────────────────────────

// Set process file-creation mask. Returns previous mask.
pub fn umask(mask: u32) u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = unix.umask(mask); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.umask(mask); }
        ret r;
    }
    ret 4294967295 as u32;
}


@test
fn identities_and_signals_answer_on_unix() void {
    @cfg(target_os = "linux") {
        if (getuid() == 4294967295 as u32 || geteuid() == 4294967295 as u32) { panic("uid unavailable"); }
        if (getgid() == 4294967295 as u32 || getegid() == 4294967295 as u32) { panic("gid unavailable"); }
        // Signal 0 only checks that the process exists.
        var pid: i32 = 0;
        unsafe { pid = unix.getpid(); }
        if (kill(pid, 0) != 0) { panic("kill(self, 0) failed"); }
        const previous: u32 = umask(18);
        if (umask(previous) != 18) { panic("umask did not round-trip"); }
        var buffer = String.from("................................................................................................................................................................................................................................................................");
        var written: isize = 0;
        unsafe { written = cwd(buffer.as_str(), 256); }
        if (written <= 0) { panic("cwd failed"); }
    }
}
