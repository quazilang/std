// std.posix — Unix-specific process facilities (Linux and NetBSD).
// These wrap native calls and return raw native results; std.os holds the
// portable surface. On other targets the signed-result functions return -1
// and the unsigned ones return u32::MAX as an unsupported-target sentinel.
import std.core;
import std.linux;
@cfg(target_os = "netbsd")
import std.netbsd;

// The current Linux environment: a null-terminated array of `NAME=VALUE`
// C string pointers. Arrays are never freed, so it stays readable.
pub unsafe fn linux_environment() *u8 {
    ret *((core.runtime_state() + 112) as **u8);
}

// Fill buf with the current working directory path (null-terminated).
// Returns number of bytes written (including null) or negative on error.
// buf must be at least size bytes long.
pub unsafe fn cwd(buf: str, size: usize) isize {
    @cfg(target_os = "linux") { ret linux.getcwd(buf, size); }
    @cfg(target_os = "netbsd") { ret netbsd.getcwd(buf, size); }
    ret -1;
}

// ── Identities ───────────────────────────────────────────────────────────────

// Returns the user ID of the current process.
pub fn getuid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = linux.getuid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.getuid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// Returns the group ID of the current process.
pub fn getgid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = linux.getgid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.getgid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// Returns the effective user ID.
pub fn geteuid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = linux.geteuid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.geteuid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// Returns the effective group ID.
pub fn getegid() u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = linux.getegid(); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.getegid(); }
        ret r;
    }
    ret 4294967295 as u32;
}

// ── Signals ───────────────────────────────────────────────────────────────────

// Send signal sig to process pid. Common signals: SIGTERM=15, SIGKILL=9, SIGINT=2.
pub fn kill(pid: i32, sig: i32) i32 {
    @cfg(target_os = "linux") {
        var r: i32 = 0;
        unsafe { r = linux.kill(pid, sig); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: i32 = 0;
        unsafe { r = netbsd.kill(pid, sig); }
        ret r;
    }
    ret -1;
}

// ── Umask ────────────────────────────────────────────────────────────────────

// Set process file-creation mask. Returns previous mask.
pub fn umask(mask: u32) u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = linux.umask(mask); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.umask(mask); }
        ret r;
    }
    ret 4294967295 as u32;
}


@test
fn identities_and_signals_answer_on_unix() void {
    @cfg(target_os = "linux") {
        if (getuid() == 4294967295 as u32 || geteuid() == 4294967295 as u32) { panic("uid unavailable"); }
        if (getgid() == 4294967295 as u32 || getegid() == 4294967295 as u32) { panic("gid unavailable"); }
        // Signal 0 only checks that the process exists.
        var pid: i32 = 0;
        unsafe { pid = linux.getpid(); }
        if (kill(pid, 0) != 0) { panic("kill(self, 0) failed"); }
        const previous: u32 = umask(18);
        if (umask(previous) != 18) { panic("umask did not round-trip"); }
        var buffer = String.from("................................................................................................................................................................................................................................................................");
        var written: isize = 0;
        unsafe { written = cwd(buffer.as_str(), 256); }
        if (written <= 0) { panic("cwd failed"); }
    }
}

// ── Processes (Linux system calls, NetBSD libc) ──────────────────────────────
//
// Shared by std.process for `Command`: each call returns a negative errno on
// failure, like the Linux system call. Windows has no implementation (-38).

// Duplicate the process: the child's pid, 0 in the child, or -errno.
pub unsafe fn fork() i32 {
    @cfg(target_os = "linux") { ret linux.fork(); }
    @cfg(target_os = "netbsd") { ret netbsd.fork(); }
    -38
}

// Replace the process image; returns only on failure (-errno).
pub unsafe fn execve(path: str, argv: *u8, envp: *u8) i32 {
    @cfg(target_os = "linux") { ret linux.execve(path, argv, envp); }
    @cfg(target_os = "netbsd") { ret netbsd.execve(path, argv, envp); }
    -38
}

// Change the working directory (-errno on failure).
pub unsafe fn chdir(path: str) i32 {
    @cfg(target_os = "linux") { ret linux.chdir(path); }
    @cfg(target_os = "netbsd") { ret netbsd.chdir(path); }
    -38
}

// Make `new_fd` a copy of `old` (-errno on failure).
pub unsafe fn dup2(old: i32, new_fd: i32) i32 {
    @cfg(target_os = "linux") { ret linux.dup2(old, new_fd); }
    @cfg(target_os = "netbsd") { ret netbsd.dup2(old, new_fd); }
    -38
}

// A pipe into `fds` (two i32); `cloexec` sets close-on-exec on both ends.
pub unsafe fn pipe(fds: *u8, cloexec: bool) i32 {
    const flags: i32 = if cloexec { 524288 } else { 0 };
    @cfg(target_os = "linux") { ret linux.pipe2(fds, flags); }
    @cfg(target_os = "netbsd") { ret netbsd.pipe2(fds, flags); }
    -38
}

// Wait for readiness of `count` `struct pollfd` entries.
pub unsafe fn poll(fds: *u8, count: usize, timeout: i32) i32 {
    @cfg(target_os = "linux") { ret linux.poll(fds, count, timeout); }
    @cfg(target_os = "netbsd") { ret netbsd.poll(fds, count, timeout); }
    -38
}

// Read from a descriptor (-errno on failure).
pub unsafe fn read(fd: i32, data: *u8, count: usize) isize {
    @cfg(target_os = "linux") { ret linux.read(fd, data, count); }
    @cfg(target_os = "netbsd") { ret netbsd.read(fd, data, count); }
    -38
}

// Write to a descriptor (-errno on failure).
pub unsafe fn write(fd: i32, data: *u8, count: usize) isize {
    @cfg(target_os = "linux") { ret linux.write(fd, data, count); }
    @cfg(target_os = "netbsd") { ret netbsd.write(fd, data, count); }
    -38
}

// Close a descriptor (-errno on failure).
pub unsafe fn close(fd: i32) i32 {
    @cfg(target_os = "linux") { ret linux.close(fd); }
    @cfg(target_os = "netbsd") { ret netbsd.close(fd); }
    -38
}

// `access(path, mode)` (-errno when not accessible).
pub unsafe fn access(path: str, mode: i32) i32 {
    @cfg(target_os = "linux") { ret linux.access(path, mode); }
    @cfg(target_os = "netbsd") { ret netbsd.access(path, mode); }
    -38
}

// `open` with Linux flag values (NetBSD translates them); -errno on failure.
pub unsafe fn open(path: str, flags: i32, mode: u32) i32 {
    @cfg(target_os = "linux") { ret linux.open(path, flags, mode); }
    @cfg(target_os = "netbsd") { ret netbsd.open(path, flags, mode); }
    -38
}

// End a forked child at once (no atexit handlers, no stdio flush).
pub unsafe fn exit_child(status: i32) void {
    @cfg(target_os = "linux") { linux.exit(status); }
    @cfg(target_os = "netbsd") { netbsd.exit_now(status); }
}

// Reap or poll child `pid`: its pid when it exited (with `status` set), 0
// when `no_hang` and it still runs, or -errno.
pub unsafe fn waitpid(pid: i32, status: *i32, no_hang: bool) i32 {
    const options: i32 = if no_hang { 1 } else { 0 };
    @cfg(target_os = "linux") { ret linux.wait4(pid, status as *u32, options, 0); }
    @cfg(target_os = "netbsd") { ret netbsd.waitpid(pid, status, options); }
    -38
}
