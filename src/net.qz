// std.net — TCP and HTTP/1.1 client/server building blocks.
import std.core;
import std.unix;
import std.win32_core;

@intrinsic("quazi.net.bind_tcp")
unsafe fn __net_bind_tcp(socket: isize, port: i32) i32;

@intrinsic("quazi.net.connect_tcp")
unsafe fn __net_connect_tcp(socket: isize, ip: str, port: i32) i32;

fn __socket() isize {
    @cfg(target_os = "linux") {
        var socket: i32 = 0;
        unsafe { socket = unix.socket(2, 1, 0); }
        ret socket as isize;
    }
    @cfg(target_os = "windows") {
        var startup_data: *u8 = 0;
        unsafe { startup_data = core.malloc(512); }
        if (startup_data == 0) { ret -1; }
        var started: i32 = 0;
        unsafe {
            started = win32_core.winsock_startup(514, startup_data);
            core.free(startup_data);
        }
        if (started != 0) { ret -(started as isize); }
        var socket: usize = 0;
        unsafe { socket = win32_core.socket(2, 1, 6); }
        if (socket as isize < 0) {
            var error: i32 = 0;
            unsafe {
                error = win32_core.winsock_last_error();
                win32_core.winsock_cleanup();
            }
            ret -(error as isize);
        }
        ret socket as isize;
    }
    ret -1;
}

fn __close(socket: isize) void {
    @cfg(target_os = "linux") { unsafe { unix.close(socket as i32); } }
    @cfg(target_os = "windows") {
        unsafe {
            win32_core.close_socket(socket as usize);
            win32_core.winsock_cleanup();
        }
    }
}

fn __listen(socket: isize, backlog: i32) i32 {
    @cfg(target_os = "linux") {
        var result: i32 = 0;
        unsafe { result = unix.listen(socket as i32, backlog); }
        ret result;
    }
    @cfg(target_os = "windows") {
        var result: i32 = 0;
        unsafe { result = win32_core.listen_socket(socket as usize, backlog); }
        ret result;
    }
    ret -1;
}

fn __accept(socket: isize) isize {
    @cfg(target_os = "linux") {
        var accepted: i32 = 0;
        unsafe { accepted = unix.accept(socket as i32, 0, 0); }
        ret accepted as isize;
    }
    @cfg(target_os = "windows") {
        var startup_data: *u8 = 0;
        unsafe { startup_data = core.malloc(512); }
        if (startup_data == 0) { ret -1; }
        var started: i32 = 0;
        unsafe {
            started = win32_core.winsock_startup(514, startup_data);
            core.free(startup_data);
        }
        if (started != 0) { ret -(started as isize); }
        var accepted: usize = 0;
        unsafe { accepted = win32_core.accept_socket(socket as usize, 0, 0); }
        if (accepted as isize < 0) {
            var error: i32 = 0;
            unsafe {
                error = win32_core.winsock_last_error();
                win32_core.winsock_cleanup();
            }
            ret -(error as isize);
        }
        ret accepted as isize;
    }
    ret -1;
}

unsafe fn __send(socket: isize, data: *u8, length: usize) isize {
    @cfg(target_os = "linux") { ret unix.write(socket as i32, data, length); }
    @cfg(target_os = "windows") {
        ret win32_core.send_socket(socket as usize, data, length as i32, 0) as isize;
    }
    ret -1;
}

unsafe fn __recv(socket: isize, data: *u8, length: usize) isize {
    @cfg(target_os = "linux") { ret unix.read(socket as i32, data, length); }
    @cfg(target_os = "windows") {
        ret win32_core.receive_socket(socket as usize, data, length as i32, 0) as isize;
    }
    ret -1;
}

fn __error(result: i32) i32 {
    @cfg(target_os = "linux") { ret result; }
    @cfg(target_os = "windows") {
        var code: i32 = 0;
        unsafe { code = win32_core.winsock_last_error(); }
        ret -code;
    }
    ret result;
}

pub struct TcpStream { socket: isize, }

impl TcpStream {
    pub fn connect(ip: str, port: i32) Result[TcpStream, i32] {
        const socket: isize = __socket();
        if (socket < 0) { ret Err(socket as i32); }
        var result: i32 = 0;
        unsafe { result = __net_connect_tcp(socket, ip, port); }
        if (result < 0) { const error: i32 = __error(result); __close(socket); ret Err(error); }
        ret Ok(TcpStream { socket: socket });
    }

    pub fn send(self: TcpStream, text: str) Result[usize, i32] {
        const length: usize = text.bytes_len();
        var sent: usize = 0;
        unsafe {
            const data: *u8 = core.str_as_ptr(text);
            for (sent < length) {
                const count: isize = __send(self.socket, data + sent, length - sent);
                if (count <= 0) { ret Err(count as i32); }
                sent = sent + count as usize;
            }
        }
        ret Ok(sent);
    }

    pub unsafe fn recv(self: TcpStream, data: *u8, length: usize) isize {
        ret __recv(self.socket, data, length);
    }

    pub fn receive(self: TcpStream, limit: usize) Result[String, i32] {
        if (limit == 0) { ret Ok(String.new()); }
        var data: *u8 = 0;
        unsafe { data = core.malloc(limit + 1); }
        if (data == 0) { ret Err(-1); }
        var count: isize = 0;
        unsafe { count = __recv(self.socket, data, limit); }
        if (count < 0) { unsafe { core.free(data); } ret Err(count as i32); }
        unsafe { *(data + count as usize) = 0; }
        var text: String = String.new();
        unsafe { text = String.from_raw(data, count as usize, limit + 1); }
        ret Ok(text);
    }

    pub fn close(self: TcpStream) void { __close(self.socket); }
    pub fn handle(self: TcpStream) isize { ret self.socket; }
}

pub struct TcpListener { socket: isize, }

impl TcpListener {
    pub fn bind(port: i32) Result[TcpListener, i32] {
        const socket: isize = __socket();
        if (socket < 0) { ret Err(socket as i32); }
        var result: i32 = 0;
        unsafe { result = __net_bind_tcp(socket, port); }
        if (result < 0) { const error: i32 = __error(result); __close(socket); ret Err(error); }
        result = __listen(socket, 128);
        if (result < 0) { const error: i32 = __error(result); __close(socket); ret Err(error); }
        ret Ok(TcpListener { socket: socket });
    }

    pub fn accept(self: TcpListener) Result[TcpStream, i32] {
        const socket: isize = __accept(self.socket);
        if (socket < 0) { ret Err(socket as i32); }
        ret Ok(TcpStream { socket: socket });
    }

    pub fn close(self: TcpListener) void { __close(self.socket); }
}

pub struct HttpResponse {
    status: i32,
    reason: str,
    body: str,
    content_type: str,
}

impl HttpResponse {
    pub fn text(status: i32, body: str) HttpResponse {
        var reason: str = "OK";
        if (status == 201) { reason = "Created"; }
        else if (status == 400) { reason = "Bad Request"; }
        else if (status == 404) { reason = "Not Found"; }
        else if (status == 500) { reason = "Internal Server Error"; }
        ret HttpResponse { status: status, reason: reason, body: body, content_type: "text/plain; charset=utf-8" };
    }

    pub fn encode(self: HttpResponse) String {
        var output: String = String.from("HTTP/1.1 ");
        output = output.push_str(self.status.to_string());
        output = output.push_str(" ");
        output = output.push_str(self.reason);
        output = output.push_str("\r\nContent-Type: ");
        output = output.push_str(self.content_type);
        output = output.push_str("\r\nContent-Length: ");
        output = output.push_str(self.body.bytes_len().to_string());
        output = output.push_str("\r\nConnection: close\r\n\r\n");
        output = output.push_str(self.body);
        ret output;
    }
}

pub struct HttpConnection { stream: TcpStream, }

impl HttpConnection {
    pub fn read_request(self: HttpConnection, limit: usize) Result[String, i32] {
        ret self.stream.receive(limit);
    }

    pub fn respond(self: HttpConnection, response: HttpResponse) Result[usize, i32] {
        const encoded: String = response.encode();
        const result: Result[usize, i32] = self.stream.send(encoded.as_str());
        self.stream.close();
        ret result;
    }
}

pub struct HttpServer { listener: TcpListener, }

impl HttpServer {
    pub fn bind(port: i32) Result[HttpServer, i32] {
        const listener: Result[TcpListener, i32] = TcpListener.bind(port);
        if (listener.is_err()) { ret Err(listener.unwrap_err()); }
        ret Ok(HttpServer { listener: listener.unwrap() });
    }

    pub fn accept(self: HttpServer) Result[HttpConnection, i32] {
        const stream: Result[TcpStream, i32] = self.listener.accept();
        if (stream.is_err()) { ret Err(stream.unwrap_err()); }
        ret Ok(HttpConnection { stream: stream.unwrap() });
    }

    pub fn close(self: HttpServer) void { self.listener.close(); }

    // Accept one request, send one response, close client and listener.
    pub fn serve_once(self: HttpServer, response: HttpResponse, limit: usize) Result[String, i32] {
        const client_socket: isize = __accept(self.listener.socket);
        if (client_socket < 0) { self.listener.close(); ret Err(client_socket as i32); }
        const stream: TcpStream = TcpStream { socket: client_socket };
        const request: Result[String, i32] = stream.receive(limit);
        if (request.is_err()) { stream.close(); self.listener.close(); ret Err(request.unwrap_err()); }
        const encoded: String = response.encode();
        const sent: Result[usize, i32] = stream.send(encoded.as_str());
        stream.close();
        self.listener.close();
        if (sent.is_err()) { ret Err(sent.unwrap_err()); }
        ret request;
    }
}

pub fn http_request(ip: str, port: i32, method: str, path: str, body: str) Result[String, i32] {
    const connected: Result[TcpStream, i32] = TcpStream.connect(ip, port);
    if (connected.is_err()) { ret Err(connected.unwrap_err()); }
    const stream: TcpStream = connected.unwrap();
    var request: String = String.from(method);
    request = request.push_str(" ");
    request = request.push_str(path);
    request = request.push_str(" HTTP/1.1\r\nHost: ");
    request = request.push_str(ip);
    request = request.push_str("\r\nContent-Length: ");
    request = request.push_str(body.bytes_len().to_string());
    request = request.push_str("\r\nConnection: close\r\n\r\n");
    request = request.push_str(body);
    const sent: Result[usize, i32] = stream.send(request.as_str());
    if (sent.is_err()) { stream.close(); ret Err(sent.unwrap_err()); }
    const response: Result[String, i32] = stream.receive(1024 * 1024);
    stream.close();
    ret response;
}

pub fn http_get(ip: str, port: i32, path: str) Result[String, i32] {
    ret http_request(ip, port, "GET", path, "");
}

pub fn http_post(ip: str, port: i32, path: str, body: str) Result[String, i32] {
    ret http_request(ip, port, "POST", path, body);
}
