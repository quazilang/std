// std.tls — TLS client streams over std.net TCP, backed by the system TLS
// library (D-008).
//
// Linux and NetBSD use the system OpenSSL 3 (`libssl`/`libcrypto`) and its
// trust store (NetBSD 11: OpenSSL 3.5 in the base system).
// Programs that call into this module must link those libraries and libc:
//
//     [target.x86_64-linux.link]
//     libc = true
//     libraries = ["ssl", "crypto"]
//
// Windows uses Schannel (SSPI, secur32) for TLS 1.2 and verifies the
// server itself through the certificate chain API (crypt32): the system
// store, or only the PEM certificates of the CA file (maintainer answer
// В32А).
//
// Certificate and host-name verification are always on; TLS 1.2 is the
// minimum protocol version.
import std.core;
import std.fs;
import std.ffi.{c_char, CString, CStringError, nullptr};
import std.net.{NetError, TcpStream, HttpRequest, HttpResponse, Url};
import std.win32_core;
@cfg(target_os = "netbsd")
import std.netbsd;

@cfg(target_family = "unix")
@api("TLS_client_method")
unsafe fn __tls_client_method() usize;
@cfg(target_family = "unix")
@api("SSL_CTX_new")
unsafe fn __ssl_ctx_new(method: usize) usize;
