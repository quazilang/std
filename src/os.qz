// std.os — operating system abstractions
// Cross-platform: uses core intrinsics (void.*) where possible,
// falls back to unix.* for Linux-specific calls.
import std.core;
import std.unix;
@cfg(target_os = "netbsd")
import std.netbsd;
import std.win32_core;
import std.posix;
import std.fs;
import std.fs.FsError;
import ./os_memory;

struct OsRawBuffer {
    data: *u8,
}

impl OsRawBuffer {
    unsafe fn take(self: OsRawBuffer) *u8 {
        const data: *u8 = self.data;
        self.data = 0;
        ret data;
    }

    fn free(self: OsRawBuffer) void {
        if (self.data != 0) { unsafe { core.free(self.data); } }
        self.data = 0;
    }
}

struct ProcessSnapshot {
    handle: usize,
}

impl ProcessSnapshot {
    fn free(self: ProcessSnapshot) void {
        @cfg(target_os = "windows") {
            if (self.handle != 0 && self.handle as isize != -1) {
                unsafe { win32_core.close_handle(self.handle); }
            }
        }
        self.handle = 0;
    }
}

fn ascii_equal(left: str, right: str) bool {
    const left_len: usize = core.strlen(left);
    if (left_len != core.strlen(right)) { ret false; }
    var index: usize = 0;
    for (index < left_len) {
        var a: u8 = core.str_byte_at(left, index);
        var b: u8 = core.str_byte_at(right, index);
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (b >= 65 && b <= 90) { b = b + 32; }
        if (a != b) { ret false; }
        index++;
    }
    ret true;
}

fn owned_u32(value: u32) String {
    ret (value as u64).to_string();
}

@cfg(target_os = "windows")
unsafe fn read_u32(address: *u8) u32 {
    ret (*address) as u32
        + (((*(address + 1)) as u32) << 8)
        + (((*(address + 2)) as u32) << 16)
        + (((*(address + 3)) as u32) << 24);
}

@cfg(target_os = "windows")
fn process_role(role: i32) String {
    const capacity: usize = 304;
    var buffer: OsRawBuffer = OsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity); }
    if (buffer.data == 0) { ret String.new(); }
    var raw_snapshot: usize = 0;
    unsafe { raw_snapshot = win32_core.process_snapshot(2, 0); }
    if (raw_snapshot as isize == -1) { ret String.new(); }
    const snapshot: ProcessSnapshot = ProcessSnapshot { handle: raw_snapshot };
    var wanted: u32 = 0;
    unsafe { wanted = win32_core.current_process_id(); }
    var depth: usize = 0;
    for (depth < 16 && wanted != 0) {
        unsafe {
            *buffer.data = 48;
            *(buffer.data + 1) = 1;
            *(buffer.data + 2) = 0;
            *(buffer.data + 3) = 0;
        }
        var found: bool = false;
        unsafe {
            var more: i32 = win32_core.first_process(raw_snapshot, buffer.data);
            for (more != 0) {
                if (read_u32(buffer.data + 8) == wanted) {
                    found = true;
                    break;
                }
                more = win32_core.next_process(raw_snapshot, buffer.data);
            }
        }
        if (!found) { break; }
        var parent: u32 = 0;
        unsafe { parent = read_u32(buffer.data + 32); }
        if (depth > 0) {
            var executable: String = String.new();
            unsafe { executable = String.from(core.str_from_ptr(buffer.data + 44)); }
            const executable_name: str = executable.as_str();
            if (role == 1) {
                if (ascii_equal(executable_name, "pwsh.exe")) { ret String.from("PowerShell"); }
                if (ascii_equal(executable_name, "powershell.exe")) { ret String.from("PowerShell"); }
                if (ascii_equal(executable_name, "cmd.exe")) { ret String.from("cmd.exe"); }
                if (ascii_equal(executable_name, "nu.exe")) { ret String.from("Nushell"); }
                if (ascii_equal(executable_name, "bash.exe")) { ret String.from("bash"); }
            }
            if (role == 2) {
                if (ascii_equal(executable_name, "windowsterminal.exe")) {
                    ret String.from("Windows Terminal");
                }
                if (ascii_equal(executable_name, "wezterm-gui.exe")) { ret String.from("WezTerm"); }
                if (ascii_equal(executable_name, "alacritty.exe")) { ret String.from("Alacritty"); }
                if (ascii_equal(executable_name, "hyper.exe")) { ret String.from("Hyper"); }
                if (ascii_equal(executable_name, "conemu64.exe")) { ret String.from("ConEmu"); }
                if (ascii_equal(executable_name, "openconsole.exe")) {
                    ret String.from("Windows Console");
                }
            }
        }
        wanted = parent;
        depth++;
    }
    ret String.new();
}

// ── Process ──────────────────────────────────────────────────────────────────

// Terminate the process with the given exit code. Never returns.
// The process arguments, the program name first, as owned UTF-8 strings.
// Linux reads /proc/self/cmdline; Windows splits GetCommandLineW like the C
// runtime. An argument that is not valid UTF-8 reports InvalidData.
pub fn args() Result[Array[String], fs.FsError] {
    var values: Array[String] = Array.new();
    @cfg(target_os = "linux") {
        // /proc/self/cmdline can exceed any fixed buffer: grow until EOF.
        var capacity: usize = 65536;
        var buffer: *u8 = 0;
        unsafe { buffer = core.malloc(capacity + 1); }
        if (buffer == 0) { ret Err(FsError.AllocationFailed); }
        var file = fs.File.open("/proc/self/cmdline")?;
        var length: usize = 0;
        for (true) {
            if (length == capacity) {
                capacity = capacity * 2;
                var grown: *u8 = 0;
                unsafe { grown = core.realloc(buffer, capacity + 1); }
                if (grown == 0) {
                    unsafe { core.free(buffer); }
                    ret Err(FsError.AllocationFailed);
                }
                buffer = grown;
            }
            var count: isize = 0;
            unsafe { count = file.read(buffer + length, capacity - length); }
            if (count < 0) {
                unsafe { core.free(buffer); }
                ret Err(FsError.InvalidData);
            }
            if (count == 0) { break; }
            length = length + (count as usize);
        }
        var start: usize = 0;
        for (start < length) {
            var end: usize = start;
            unsafe { for (end < length && *(buffer + end) != 0) { end = end + 1; } }
            const size: usize = end - start;
            var copy: *u8 = 0;
            unsafe {
                copy = core.malloc(size + 1);
                if (copy == 0) { core.free(buffer); ret Err(FsError.AllocationFailed); }
                core.memcpy(copy, buffer + start, size);
                *(copy + size) = 0;
                if (!core.is_valid_utf8(copy, size)) {
                    core.free(copy);
                    core.free(buffer);
                    ret Err(FsError.InvalidData);
                }
                values.push(String.from_raw(copy, size, size + 1));
            }
            start = end + 1;
        }
        unsafe { core.free(buffer); }
        ret Ok(values);
    }
    @cfg(target_os = "windows") {
        var count: i32 = 0;
        var list: *u8 = 0;
        unsafe { list = win32_core.command_line_to_argv_w(win32_core.command_line_w(), &count); }
        if (list == 0) { ret Err(FsError.AllocationFailed); }
        var index: i32 = 0;
        for (index < count) {
            unsafe {
                const wide: *u8 = *((list + (index as usize) * 8) as **u8);
                // Size including the terminator, then the conversion itself.
                const size: i32 = win32_core.wide_to_multi_byte(65001, 0, wide, -1, 0, 0, 0, 0);
                if (size <= 0) { win32_core.local_free(list); ret Err(FsError.InvalidData); }
                const copy: *u8 = core.malloc(size as usize);
                if (copy == 0) { win32_core.local_free(list); ret Err(FsError.AllocationFailed); }
                win32_core.wide_to_multi_byte(65001, 0, wide, -1, copy, size, 0, 0);
                values.push(String.from_raw(copy, (size - 1) as usize, size as usize));
            }
            index = index + 1;
        }
        unsafe { win32_core.local_free(list); }
        ret Ok(values);
    }
    Err(FsError.Unsupported)
}

// Ends the process now with status `code`; destructors do not run.
pub fn exit(code: i32) void {
    core.exit(code);
}

// Suspend execution for ms milliseconds.
pub fn sleep(ms: u64) void {
    core.sleep_ms(ms);
}

// Yield the CPU to other threads/processes.
pub fn yield_cpu() void {
    @cfg(target_os = "linux") { unsafe { unix.sched_yield(); } }
    @cfg(target_os = "netbsd") { unsafe { netbsd.sched_yield(); } }
    // Sleep(0) relinquishes the remainder of the current time slice to a
    // runnable peer without introducing a fixed-delay scheduling policy.
    @cfg(target_os = "windows") { core.sleep_ms(0); }
}

// Returns the PID of the current process.
pub fn getpid() i32 {
    @cfg(target_os = "linux") {
        var r: i32 = 0;
        unsafe { r = unix.getpid(); }
        ret r;
    }
        @cfg(target_os = "netbsd") {
        var r: i32 = 0;
        unsafe { r = netbsd.getpid(); }
        ret r;
    }
    @cfg(target_os = "windows") {
        var r: u32 = 0;
        unsafe { r = win32_core.current_process_id(); }
        ret r as i32;
    }
    ret 0;
}

// Returns the PID of the parent process.
pub fn getppid() i32 {
    @cfg(target_os = "linux") {
        var r: i32 = 0;
        unsafe { r = unix.getppid(); }
        ret r;
    }
        @cfg(target_os = "netbsd") {
        var r: i32 = 0;
        unsafe { r = netbsd.getppid(); }
        ret r;
    }
    ret -1;
}

// ── Environment variables ─────────────────────────────────────────────────────

// Returns a pointer to the value of environment variable name, or null if not set.
// Result is a null-terminated C string pointer — treat as unsafe.
pub unsafe fn getenv(name: str) *u8 {
    ret core.getenv(name);
}

// Why an environment change was rejected.
pub enum EnvError {
    // The name is empty or contains `=` or a NUL byte.
    InvalidName,
    // The value contains a NUL byte.
    InvalidValue,
    AllocationFailed,
    // A platform error code (NetBSD errno, Windows GetLastError).
    Native(i32),
}

impl EnvError {
    // A short English description of the error, for display.
    pub fn message(self: EnvError) str {
        ret match self {
            InvalidName => "environment variable name is empty or contains '=' or NUL",
            InvalidValue => "environment variable value contains NUL",
            AllocationFailed => "out of memory while changing the environment",
            Native(_) => "the platform rejected the environment change",
        };
    }
}

fn env_text_has_nul(text: str) bool {
    var index: usize = 0;
    for (index < text.bytes_len()) {
        if (core.str_byte_at(text, index) == 0) { ret true; }
        index = index + 1;
    }
    ret false;
}

fn env_name_valid(name: str) bool {
    if (name.bytes_len() == 0 || env_text_has_nul(name)) { ret false; }
    var index: usize = 0;
    for (index < name.bytes_len()) {
        if (core.str_byte_at(name, index) == 61) { ret false; }
        index = index + 1;
    }
    ret true;
}

// A malloc'd NUL-terminated copy of `prefix` + `suffix`, or 0.
unsafe fn env_c_text(prefix: str, separator: bool, suffix: str) *u8 {
    const head: usize = prefix.bytes_len();
    var total: usize = head;
    if (separator) { total = total + 1 + suffix.bytes_len(); }
    const text: *u8 = core.malloc(total + 1);
    if (text == 0) { ret 0; }
    core.memcpy(text, core.str_as_ptr(prefix), head);
    if (separator) {
        *(text + head) = 61;
        core.memcpy(text + head + 1, core.str_as_ptr(suffix), suffix.bytes_len());
    }
    *(text + total) = 0;
    ret text;
}

// Whether the C string `entry` is `name=...`.
unsafe fn env_entry_named(entry: *u8, name: str) bool {
    var index: usize = 0;
    for (index < name.bytes_len()) {
        if (*(entry + index) != core.str_byte_at(name, index)) { ret false; }
        index = index + 1;
    }
    ret *(entry + index) == 61;
}

// Linux: publish a copy of the environment without `name` (and with
// `name=value` unless `remove`; Linux, and NetBSD next to libc's own copy).
// Writers serialize on a spin lock; readers
// see the old or the new complete array (docs/internals/runtime-state.md).
unsafe fn linux_change_env(name: str, value: str, remove: bool) Result[bool, EnvError] {
    const lock: *i64 = (core.runtime_state() + 104) as *i64;
    for (core.atomic_cas(lock, 0, 1) != 0) { yield_cpu(); }
    const current: *u8 = posix.linux_environment();
    var count: usize = 0;
    if (current != 0) {
        for (*((current + count * 8) as **u8) != 0) { count = count + 1; }
    }
    const replacement: *u8 = core.malloc((count + 2) * 8);
    if (replacement == 0) {
        core.atomic_cas(lock, 1, 0);
        ret Err(EnvError.AllocationFailed);
    }
    var kept: usize = 0;
    var found: bool = false;
    var index: usize = 0;
    for (index < count) {
        const entry: *u8 = *((current + index * 8) as **u8);
        if (env_entry_named(entry, name)) {
            found = true;
        } else {
            *((replacement + kept * 8) as **u8) = entry;
            kept = kept + 1;
        }
        index = index + 1;
    }
    if (!remove) {
        const entry: *u8 = env_c_text(name, true, value);
        if (entry == 0) {
            core.free(replacement);
            core.atomic_cas(lock, 1, 0);
            ret Err(EnvError.AllocationFailed);
        }
        *((replacement + kept * 8) as **u8) = entry;
        kept = kept + 1;
    }
    *((replacement + kept * 8) as **u8) = 0;
    // One aligned 8-byte store publishes the array; only lock holders write it.
    *((core.runtime_state() + 112) as **u8) = replacement;
    core.atomic_cas(lock, 1, 0);
    if (remove) { ret Ok(found); }
    ret Ok(true);
}

// Sets environment variable `name` to `value` for this process and the
// children it starts afterwards. Safe to call from several threads: on
// Linux each change publishes a new environment copy (earlier copies stay
// allocated, since another thread may be reading them).
pub fn set_env(name: str, value: str) Result[bool, EnvError] {
    if (!env_name_valid(name)) { ret Err(EnvError.InvalidName); }
    if (env_text_has_nul(value)) { ret Err(EnvError.InvalidValue); }
    @cfg(target_os = "linux") {
        unsafe { ret linux_change_env(name, value, false); }
    }
    unsafe {
        const name_text: *u8 = env_c_text(name, false, "");
        const value_text: *u8 = env_c_text(value, false, "");
        if (name_text == 0 || value_text == 0) {
            core.free(name_text); core.free(value_text);
            ret Err(EnvError.AllocationFailed);
        }
        var error: i32 = 0;
        @cfg(target_os = "windows") {
            if (win32_core.set_environment(name_text, value_text) == 0) { error = win32_core.last_error() as i32; }
        }
        @cfg(target_os = "netbsd") {
            error = -netbsd.setenv(name_text, value_text);
            // Keep the runtime's copy (std.process child environments) current.
            if (error == 0) { linux_change_env(name, value, false); }
        }
        // Other targets (macOS) have no environment backend yet: ENOSYS.
        @cfg(target_os = "macos") { error = 38; }
        core.free(name_text); core.free(value_text);
        if (error != 0) { ret Err(EnvError.Native(error)); }
    }
    ret Ok(true);
}

// Removes environment variable `name` from this process (and later
// children): `Ok(true)` when it was set, `Ok(false)` when it was not.
pub fn remove_env(name: str) Result[bool, EnvError] {
    if (!env_name_valid(name)) { ret Err(EnvError.InvalidName); }
    @cfg(target_os = "linux") {
        unsafe { ret linux_change_env(name, "", true); }
    }
    const present: bool = env_present(name);
    unsafe {
        const name_text: *u8 = env_c_text(name, false, "");
        if (name_text == 0) { ret Err(EnvError.AllocationFailed); }
        var error: i32 = 0;
        @cfg(target_os = "windows") {
            if (win32_core.set_environment(name_text, 0) == 0 && present) { error = win32_core.last_error() as i32; }
        }
        @cfg(target_os = "netbsd") {
            error = -netbsd.unsetenv(name_text);
            if (error == 0) { linux_change_env(name, "", true); }
        }
        @cfg(target_os = "macos") { error = 38; }
        core.free(name_text);
        if (error != 0) { ret Err(EnvError.Native(error)); }
    }
    ret Ok(present);
}

// Whether environment variable `name` is set (even to an empty value).
pub fn env_present(name: str) bool {
    @cfg(target_os = "windows") {
        unsafe {
            const name_text: *u8 = env_c_text(name, false, "");
            if (name_text == 0) { ret false; }
            var probe: *u8 = core.malloc(1);
            if (probe == 0) { core.free(name_text); ret false; }
            win32_core.set_last_error(0);
            const length: u32 = win32_core.environment(name_text, probe, 1);
            const error: u32 = win32_core.last_error();
            core.free(probe); core.free(name_text);
            // ERROR_ENVVAR_NOT_FOUND (203) marks a missing variable.
            ret length > 0 || error != 203;
        }
    }
    unsafe { ret core.getenv(name) != 0; }
}

// Return an owned copy of an environment variable. Callers do not need to
// manage the platform buffer or call free; String is destroyed automatically
// at the end of its lexical lifetime.
pub fn env(name: str, fallback: str) String {
    @cfg(target_os = "windows") {
        const capacity: usize = 32768;
        var buffer: OsRawBuffer = OsRawBuffer { data: 0 };
        unsafe {
            buffer.data = core.malloc(capacity);
            if (buffer.data == 0) { ret String.from(fallback); }
            const len: u32 = win32_core.environment(
                core.str_as_ptr(name), buffer.data, capacity as u32
            );
            if (len == 0 || len as usize >= capacity) {
                ret String.from(fallback);
            }
            ret String.from_raw(buffer.take(), len as usize, capacity);
        }
    }

    @cfg(target_os = "netbsd") {
        unsafe {
            const value: *u8 = core.getenv(name);
            if (value == 0) { ret String.from(fallback); }
            ret String.from(core.str_from_ptr(value));
        }
    }

    @cfg(target_os = "linux") {
        unsafe {
            const value: *u8 = core.getenv(name);
            if (value == 0) { ret String.from(fallback); }
            ret String.from(core.str_from_ptr(value));
        }
    }

    ret String.from(fallback);
}

// Host operating-system name suitable for display and feature diagnostics.
pub fn name() str {
    @cfg(target_os = "windows") { ret "Windows"; }
    @cfg(target_os = "linux") { ret "Linux"; }
    @cfg(target_os = "netbsd") { ret "NetBSD"; }
    ret "Unknown";
}

// Human-readable OS release. Windows uses authoritative registry build,
// edition, and display-version values instead of compatibility-shimmed APIs.
pub fn version() String {
    @cfg(target_os = "windows") {
        const build: u32 = core.windows_build();
        const product_type: u32 = core.windows_product();
        var product: str = "Windows 10";
        if (build >= 22000) { product = "Windows 11"; }
        var edition: str = "";
        if (product_type == 101 || product_type == 2 || product_type == 3) {
            edition = "Home";
        }
        if (product_type == 48 || product_type == 49 || product_type == 103) {
            edition = "Pro";
        }
        if (product_type == 4 || product_type == 27 || product_type == 70) {
            edition = "Enterprise";
        }
        if (product_type == 121 || product_type == 122) { edition = "Education"; }
        if (product_type == 7 || product_type == 8 || product_type == 10) {
            edition = "Server";
        }
        var result: String = String.from(product);
        if (core.strlen(edition) > 0) {
            result.push_str(" ");
            result.push_str(edition);
        }
        if (build > 0) {
            const build_text: String = owned_u32(build);
            result.push_str(" (build ");
            result.push_str(build_text.as_str());
            result.push_str(")");
        }
        ret result;
    }
    @cfg(target_os = "linux") { ret String.from("Linux"); }
    @cfg(target_os = "netbsd") { ret String.from("NetBSD"); }
    ret String.from("Unknown");
}

// CPU branding suitable for display. PROCESSOR_IDENTIFIER is only an
// architecture identifier, so Windows reads ProcessorNameString instead.
pub fn cpu_name() String {
    const capacity: usize = 64;
    var buffer: OsRawBuffer = OsRawBuffer { data: 0 };
    unsafe { buffer.data = core.malloc(capacity); }
    if (buffer.data == 0) { ret String.from("unknown"); }
    var length: isize = -1;
    unsafe { length = core.cpu_name(buffer.data, capacity); }
    if (length < 0) { ret String.from("unknown"); }
    var start: usize = 0;
    var end: usize = length as usize;
    unsafe {
        for (start < end && *(buffer.data + start) == 32) { start++; }
        for (end > start && *(buffer.data + end - 1) == 32) { end--; }
        const trimmed_length: usize = end - start;
        var index: usize = 0;
        for (index < trimmed_length) {
            *(buffer.data + index) = *(buffer.data + start + index);
            index++;
        }
        *(buffer.data + trimmed_length) = 0;
        ret String.from_raw(buffer.take(), trimmed_length, capacity);
    }
    ret String.from("unknown");
}

// Best-effort interactive shell and terminal names. Windows environment hints
// are checked first, then the parent-process chain is inspected directly.
pub fn shell() String {
    @cfg(target_os = "windows") {
        const detected: String = process_role(1);
        if (!detected.is_empty()) { ret detected; }
        ret String.from("Console");
    }
    @cfg(target_os = "linux") { ret env("SHELL", "unknown"); }
    @cfg(target_os = "netbsd") { ret env("SHELL", "unknown"); }
    ret String.from("unknown");
}

// The terminal: `TERM` on Linux and NetBSD, the console host on Windows,
// `unknown` when it cannot be detected.
pub fn terminal() String {
    @cfg(target_os = "windows") {
        const session: String = env("WT_SESSION", "");
        if (!session.is_empty()) { ret String.from("Windows Terminal"); }
        const detected: String = process_role(2);
        if (!detected.is_empty()) { ret detected; }
        ret String.from("Windows Console");
    }
    @cfg(target_os = "linux") { ret env("TERM", "unknown"); }
    @cfg(target_os = "netbsd") { ret env("TERM", "unknown"); }
    ret String.from("unknown");
}

// Return the hostname as an owned UTF-8 string. The compiler-provided
// intrinsic uses GetComputerNameA on Windows and uname(2) on Linux.
pub fn hostname() String {
    const capacity: usize = 256;
    var buffer: OsRawBuffer = OsRawBuffer { data: 0 };
    unsafe {
        buffer.data = core.malloc(capacity);
        if (buffer.data == 0) { ret String.from("unknown"); }
        const len: isize = core.hostname(buffer.data, capacity);
        if (len < 0) { ret String.from("unknown"); }
        ret String.from_raw(buffer.take(), len as usize, capacity);
    }
    ret String.from("unknown");
}

// Physical-memory counters in bytes. Linux availability includes reclaimable
// memory through MemAvailable, falling back to sysinfo.free_ram without procfs.
// Windows reports MEMORYSTATUSEX.available_physical.
pub fn memory_total() u64 { ret core.memory_total(); }
// Memory in bytes that can be allocated without swapping (Linux
// `MemAvailable`, Windows available physical memory).
pub fn memory_available() u64 {
    @cfg(target_os = "linux") {
        const read: Result[String, fs.FsError] = fs.read_to_string("/proc/meminfo");
        if (read.is_ok()) {
            const text: String = read.unwrap();
            const available: Option[u64] = os_memory.available_bytes(text.as_str());
            if (available.is_some()) { ret available.unwrap(); }
        }
    }
    ret core.memory_available();
}

// ── Current directory ─────────────────────────────────────────────────────────

// The current working directory as an owned path; see fs.current_dir.
pub fn current_dir() Result[String, fs.FsError] { fs.current_dir() }

// Change the current working directory for the whole process.
pub fn set_current_dir(path: str) Result[bool, fs.FsError] { fs.set_current_dir(path) }

@test
fn args_start_with_the_program() {
    var values: Array[String] = args().unwrap();
    if (values.len() == 0) { panic("no program name"); }
    const first: String = values.remove(0);
    if (first.is_empty()) { panic("empty program name"); }
}
