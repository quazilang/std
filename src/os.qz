    ret 4294967295 as u32;
}

// ── Signals ───────────────────────────────────────────────────────────────────

// Send signal sig to process pid. Common signals: SIGTERM=15, SIGKILL=9, SIGINT=2.
pub fn kill(pid: i32, sig: i32) i32 {
    @cfg(target_os = "linux") {
        var r: i32 = 0;
        unsafe { r = unix.kill(pid, sig); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: i32 = 0;
        unsafe { r = netbsd.kill(pid, sig); }
        ret r;
    }
    ret -1;
}

// ── Umask ────────────────────────────────────────────────────────────────────

// Set process file-creation mask. Returns previous mask.
pub fn umask(mask: u32) u32 {
    @cfg(target_os = "linux") {
        var r: u32 = 0;
        unsafe { r = unix.umask(mask); }
        ret r;
    }
    @cfg(target_os = "netbsd") {
        var r: u32 = 0;
        unsafe { r = netbsd.umask(mask); }
        ret r;
    }
    ret 4294967295 as u32;
}

@test
fn args_start_with_the_program() {
    var values: Array[String] = args().unwrap();
    if (values.len() == 0) { panic("no program name"); }
    const first: String = values.remove(0);
    if (first.is_empty()) { panic("empty program name"); }
}
