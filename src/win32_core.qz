// Minimal pointer-correct Win32 substrate used by cross-platform std modules.
// Keep C ABI pointers raw here; safe String/str wrappers belong in std.fs/os.

@api("CreateFileA")
pub unsafe fn create_file(path: *u8, access: u32, share: u32, security: *u8,
    disposition: u32, flags: u32, template: usize) usize;

@api("ReadFile")
pub unsafe fn read_file(file: usize, buf: *u8, count: u32,
    read: *u32, overlapped: *u8) i32;

@api("WriteFile")
pub unsafe fn write_file(file: usize, buf: *u8, count: u32,
    written: *u32, overlapped: *u8) i32;

@api("GetStdHandle")
pub unsafe fn get_std_handle(kind: u32) usize;

@api("GetConsoleMode")
pub unsafe fn get_console_mode(console: usize, mode: *u32) i32;

@api("SetConsoleMode")
pub unsafe fn set_console_mode(console: usize, mode: u32) i32;

@api("MultiByteToWideChar")
pub unsafe fn utf8_to_utf16(code_page: u32, flags: u32, input: *u8,
    input_len: i32, output: *u16, output_len: i32) i32;

@api("WriteConsoleW")
pub unsafe fn write_console_utf16(console: usize, text: *u16, count: u32,
    written: *u32, reserved: *u8) i32;

@api("CloseHandle")
pub unsafe fn close_handle(handle: usize) i32;

@api("SetFilePointerEx")
pub unsafe fn seek(file: usize, distance: i64, position: *i64, method: u32) i32;

@api("FlushFileBuffers")
pub unsafe fn sync(file: usize) i32;

@api("GetFileAttributesA")
pub unsafe fn file_attributes(path: *u8) u32;

@api("DeleteFileA")
pub unsafe fn delete_file(path: *u8) i32;

@api("CreateDirectoryA")
pub unsafe fn create_directory(path: *u8, security: *u8) i32;

@api("RemoveDirectoryA")
pub unsafe fn remove_directory(path: *u8) i32;

@api("MoveFileA")
pub unsafe fn move_file(from: *u8, to: *u8) i32;

@api("GetEnvironmentVariableA")
pub unsafe fn environment(name: *u8, buf: *u8, capacity: u32) u32;

@api("FindFirstFileA")
pub unsafe fn find_first(pattern: *u8, data: *u8) usize;

@api("FindNextFileA")
pub unsafe fn find_next(handle: usize, data: *u8) i32;

@api("FindClose")
pub unsafe fn find_close(handle: usize) i32;

@api("GetLastError")
pub unsafe fn last_error() u32;

@api("CreateToolhelp32Snapshot")
pub unsafe fn process_snapshot(flags: u32, process: u32) usize;

@api("Process32First")
pub unsafe fn first_process(snapshot: usize, entry: *u8) i32;

@api("Process32Next")
pub unsafe fn next_process(snapshot: usize, entry: *u8) i32;

@api("GetCurrentProcessId")
pub unsafe fn current_process_id() u32;

// Minimal pointer-correct Winsock2 substrate used by std.net.
@api("WSAStartup")
pub unsafe fn winsock_startup(version: u16, data: *u8) i32;

@api("WSACleanup")
pub unsafe fn winsock_cleanup() i32;

@api("WSAGetLastError")
pub unsafe fn winsock_last_error() i32;

@api("socket")
pub unsafe fn socket(af: i32, kind: i32, protocol: i32) usize;

@api("closesocket")
pub unsafe fn close_socket(socket: usize) i32;

@api("listen")
pub unsafe fn listen_socket(socket: usize, backlog: i32) i32;

@api("accept")
pub unsafe fn accept_socket(socket: usize, address: *u8, address_length: *i32) usize;

@api("send")
pub unsafe fn send_socket(socket: usize, data: *u8, length: i32, flags: i32) i32;

@api("recv")
pub unsafe fn receive_socket(socket: usize, data: *u8, length: i32, flags: i32) i32;

@api("sendto")
pub unsafe fn send_to_socket(socket: usize, data: *u8, length: i32, flags: i32, address: *u8, address_length: i32) i32;

@api("recvfrom")
pub unsafe fn receive_from_socket(socket: usize, data: *u8, length: i32, flags: i32, address: *u8, address_length: *i32) i32;

@api("shutdown")
pub unsafe fn shutdown_socket(socket: usize, how: i32) i32;

@api("LoadLibraryA")
pub unsafe fn load_library(path: *i8) usize;

@api("GetProcAddress")
pub unsafe fn library_symbol(library: usize, name: *i8) usize;

@api("FreeLibrary")
pub unsafe fn free_library(library: usize) i32;

@api("getaddrinfo")
pub unsafe fn get_address_info(node: *i8, service: *i8, hints: *u8, result: **u8) i32;

@api("freeaddrinfo")
pub unsafe fn free_address_info(result: *u8) void;

// ── Time ─────────────────────────────────────────────────────────────────────

// High-resolution monotonic counter. lpPerformanceCount is LARGE_INTEGER* (i64*).
@api("QueryPerformanceCounter")
pub unsafe fn query_perf_counter(count: *i64) i32;

// Ticks per second for QueryPerformanceCounter.
@api("QueryPerformanceFrequency")
pub unsafe fn query_perf_freq(freq: *i64) i32;

// Wall-clock time as FILETIME (100-ns intervals since 1601-01-01), stored as u64.
@api("GetSystemTimeAsFileTime")
pub unsafe fn get_system_time_as_file_time(ft: *u64) void;

// TIME_ZONE_INFORMATION pointer (172 bytes). Returns TIME_ZONE_ID_*.
// 0=unknown, 1=standard, 2=daylight, 0xFFFFFFFF=error.
@api("GetTimeZoneInformation")
pub unsafe fn get_tz_info(info: *u8) u32;

// ── Process ───────────────────────────────────────────────────────────────────

// CreateProcessA. startup_info must be STARTUPINFOA (68 bytes), proc_info must
// be PROCESS_INFORMATION (24 bytes). Returns nonzero on success.
@api("CreateProcessA")
pub unsafe fn create_process(
    app: *u8, cmd_line: *u8, proc_attr: *u8, thread_attr: *u8,
    inherit_handles: i32, flags: u32, environment: *u8, current_dir: *u8,
    startup_info: *u8, proc_info: *u8) i32;

// ms: INFINITE = 0xFFFFFFFF. Returns 0 (WAIT_OBJECT_0) on success.
@api("WaitForSingleObject")
pub unsafe fn wait_single_object(handle: usize, ms: u32) u32;

// Fills *exit_code with the process exit code after WaitForSingleObject.
@api("GetExitCodeProcess")
pub unsafe fn get_exit_code_process(handle: usize, exit_code: *u32) i32;

// Force-terminate a process.
@api("TerminateProcess")
pub unsafe fn terminate_process(handle: usize, exit_code: u32) i32;

// Create an anonymous pipe. read_handle and write_handle are HANDLE* (usize*).
@api("CreatePipe")
pub unsafe fn create_pipe(
    read_handle: *usize, write_handle: *usize,
    security: *u8, size: u32) i32;

// HANDLE_FLAG_INHERIT = 1. Used to prevent child inheriting a pipe handle.
@api("SetHandleInformation")
pub unsafe fn set_handle_info(handle: usize, mask: u32, flags: u32) i32;

// Read from a pipe handle.
@api("ReadFile")
pub unsafe fn read_pipe(handle: usize, buf: *u8, count: u32, read: *u32, overlapped: *u8) i32;

// ── Mutex (CRITICAL_SECTION) ──────────────────────────────────────────────────

// CRITICAL_SECTION is 40 bytes on x64 Windows.
@api("InitializeCriticalSection")
pub unsafe fn cs_init(cs: *u8) void;

@api("EnterCriticalSection")
pub unsafe fn cs_enter(cs: *u8) void;

@api("LeaveCriticalSection")
pub unsafe fn cs_leave(cs: *u8) void;

@api("DeleteCriticalSection")
pub unsafe fn cs_delete(cs: *u8) void;

// TryEnterCriticalSection: returns nonzero if lock was acquired.
@api("TryEnterCriticalSection")
pub unsafe fn cs_try_enter(cs: *u8) i32;

// ── Additional OS API ─────────────────────────────────────────────────────────

// GetUserNameA(lpBuffer, pcbBuffer). pcbBuffer is in/out: length on input,
// written bytes (including NUL) on output. Returns nonzero on success.
@api("GetUserNameA")
pub unsafe fn get_username(buf: *u8, size: *u32) i32;

// SetEnvironmentVariableA(name, value). Returns nonzero on success.
@api("SetEnvironmentVariableA")
pub unsafe fn set_environment_variable(name: *u8, value: *u8) i32;

// GetCurrentDirectoryA(nBufferLength, lpBuffer). Returns written length.
@api("GetCurrentDirectoryA")
pub unsafe fn get_current_directory(size: u32, buf: *u8) u32;
