// std.json — bounded validation primitives for JSON text.
// This initial module deliberately validates syntax without constructing a
// dynamic value tree; typed decoding is supplied by derived codecs later.
import std.core;

pub enum JsonError {
    InputLimit,
    DepthLimit,
    UnexpectedEnd,
    InvalidToken,
    InvalidString,
    InvalidEscape,
    InvalidNumber,
    TrailingData,
    DuplicateKey,
}

impl JsonError {
    pub fn message(self: JsonError) str {
        ret match self {
            InputLimit => "JSON input exceeds the configured byte limit",
            DepthLimit => "JSON nesting exceeds the configured depth limit",
            UnexpectedEnd => "JSON input ended unexpectedly",
            InvalidToken => "invalid JSON token",
            InvalidString => "invalid JSON string",
            InvalidEscape => "invalid JSON string escape",
            InvalidNumber => "invalid JSON number",
            TrailingData => "unexpected data after a JSON value",
            DuplicateKey => "JSON object contains a duplicate key",
        };
    }
}

struct Parser { source: str, offset: usize, max_depth: usize, }

fn whitespace(byte: u8) bool { ret byte == 32 || byte == 9 || byte == 10 || byte == 13; }
fn digit(byte: u8) bool { ret byte >= 48 && byte <= 57; }
fn hex(byte: u8) bool {
    ret digit(byte) || (byte >= 65 && byte <= 70) || (byte >= 97 && byte <= 102);
}

impl Parser {
    fn at_end(self: Parser) bool { ret self.offset >= self.source.bytes_len(); }
    fn byte(self: Parser) u8 { ret core.str_byte_at(self.source, self.offset); }
    fn skip_whitespace(self: Parser) void {
        for (!self.at_end() && whitespace(self.byte())) { self.offset = self.offset + 1; }
    }
    fn literal(self: Parser, value: str) bool {
        if (self.source.bytes_len() - self.offset < value.bytes_len()) { ret false; }
        for i : 0..value.bytes_len() {
            if (core.str_byte_at(self.source, self.offset + i) != core.str_byte_at(value, i)) { ret false; }
        }
        self.offset = self.offset + value.bytes_len();
        ret true;
    }
    fn string(self: Parser) Result[bool, JsonError] {
        self.offset = self.offset + 1;
        for (!self.at_end()) {
            const byte: u8 = self.byte();
            self.offset = self.offset + 1;
            if (byte == 34) { ret Ok(true); }
            if (byte < 32) { ret Err(JsonError.InvalidString); }
            if (byte != 92) { continue; }
            if (self.at_end()) { ret Err(JsonError.UnexpectedEnd); }
            const escaped: u8 = self.byte();
            self.offset = self.offset + 1;
            if (escaped == 34 || escaped == 92 || escaped == 47 || escaped == 98 || escaped == 102 || escaped == 110 || escaped == 114 || escaped == 116) { continue; }
            if (escaped != 117) { ret Err(JsonError.InvalidEscape); }
            for i : 0..4 {
                if (self.at_end()) { ret Err(JsonError.UnexpectedEnd); }
                if (!hex(self.byte())) { ret Err(JsonError.InvalidEscape); }
                self.offset = self.offset + 1;
            }
            const scalar: u32 = unicode_escape(self.source, self.offset - 4);
            if (scalar >= 55296 && scalar <= 56319) {
                if (self.source.bytes_len() - self.offset < 6
                    || core.str_byte_at(self.source, self.offset) != 92
                    || core.str_byte_at(self.source, self.offset + 1) != 117) {
                    ret Err(JsonError.InvalidString);
                }
                for i : 0..4 {
                    if (!hex(core.str_byte_at(self.source, self.offset + 2 + i))) { ret Err(JsonError.InvalidEscape); }
                }
                const low: u32 = unicode_escape(self.source, self.offset + 2);
                if (low < 56320 || low > 57343) { ret Err(JsonError.InvalidString); }
                self.offset = self.offset + 6;
            } else if (scalar >= 56320 && scalar <= 57343) { ret Err(JsonError.InvalidString); }
        }
        ret Err(JsonError.UnexpectedEnd);
    }
    fn number(self: Parser) Result[bool, JsonError] {
        if (self.byte() == 45) { self.offset = self.offset + 1; if (self.at_end()) { ret Err(JsonError.UnexpectedEnd); } }
        if (self.byte() == 48) { self.offset = self.offset + 1; }
        else {
            if (!digit(self.byte()) || self.byte() == 48) { ret Err(JsonError.InvalidNumber); }
            for (!self.at_end() && digit(self.byte())) { self.offset = self.offset + 1; }
        }
        if (!self.at_end() && digit(self.byte())) {
            ret Err(JsonError.InvalidNumber);
        }
        if (!self.at_end() && self.byte() == 46) {
            self.offset = self.offset + 1;
            if (self.at_end() || !digit(self.byte())) { ret Err(JsonError.InvalidNumber); }
            for (!self.at_end() && digit(self.byte())) { self.offset = self.offset + 1; }
        }
        if (!self.at_end() && (self.byte() == 101 || self.byte() == 69)) {
            self.offset = self.offset + 1;
            if (!self.at_end() && (self.byte() == 43 || self.byte() == 45)) { self.offset = self.offset + 1; }
            if (self.at_end() || !digit(self.byte())) { ret Err(JsonError.InvalidNumber); }
            for (!self.at_end() && digit(self.byte())) { self.offset = self.offset + 1; }
        }
        ret Ok(true);
    }
    fn array(self: Parser, depth: usize) Result[bool, JsonError] {
        self.offset = self.offset + 1; self.skip_whitespace();
        if (!self.at_end() && self.byte() == 93) { self.offset = self.offset + 1; ret Ok(true); }
        for (true) {
            const parsed: Result[bool, JsonError] = self.value(depth + 1);
            if (parsed.is_err()) { ret Err(parsed.unwrap_err()); }
            self.skip_whitespace();
            if (self.at_end()) { ret Err(JsonError.UnexpectedEnd); }
            if (self.byte() == 93) { self.offset = self.offset + 1; ret Ok(true); }
            if (self.byte() != 44) { ret Err(JsonError.InvalidToken); }
            self.offset = self.offset + 1; self.skip_whitespace();
        }
        ret Err(JsonError.UnexpectedEnd);
    }
    fn object(self: Parser, depth: usize) Result[bool, JsonError] {
        self.offset = self.offset + 1; self.skip_whitespace();
        if (!self.at_end() && self.byte() == 125) { self.offset = self.offset + 1; ret Ok(true); }
        for (true) {
            if (self.at_end()) { ret Err(JsonError.UnexpectedEnd); }
            if (self.byte() != 34) { ret Err(JsonError.InvalidToken); }
            const key: Result[bool, JsonError] = self.string();
            if (key.is_err()) { ret Err(key.unwrap_err()); }
            self.skip_whitespace();
            if (self.at_end() || self.byte() != 58) { ret Err(JsonError.InvalidToken); }
            self.offset = self.offset + 1;
            const parsed: Result[bool, JsonError] = self.value(depth + 1);
            if (parsed.is_err()) { ret Err(parsed.unwrap_err()); }
            self.skip_whitespace();
            if (self.at_end()) { ret Err(JsonError.UnexpectedEnd); }
            if (self.byte() == 125) { self.offset = self.offset + 1; ret Ok(true); }
            if (self.byte() != 44) { ret Err(JsonError.InvalidToken); }
            self.offset = self.offset + 1; self.skip_whitespace();
        }
        ret Err(JsonError.UnexpectedEnd);
    }
    fn value(self: Parser, depth: usize) Result[bool, JsonError] {
        self.skip_whitespace();
        if (self.at_end()) { ret Err(JsonError.UnexpectedEnd); }
        const byte: u8 = self.byte();
        if (byte == 34) { ret self.string(); }
        if (byte == 123 || byte == 91) {
            if (depth > self.max_depth) { ret Err(JsonError.DepthLimit); }
            if (byte == 123) { ret self.object(depth); }
            ret self.array(depth);
        }
        if (byte == 116 && self.literal("true")) { ret Ok(true); }
        if (byte == 102 && self.literal("false")) { ret Ok(true); }
        if (byte == 110 && self.literal("null")) { ret Ok(true); }
        if (byte == 45 || digit(byte)) { ret self.number(); }
        ret Err(JsonError.InvalidToken);
    }
}

pub fn validate_with_limits(source: str, max_input: usize, max_depth: usize) Result[bool, JsonError] {
    if (source.bytes_len() > max_input) { ret Err(JsonError.InputLimit); }
    var parser: Parser = Parser { source: source, offset: 0, max_depth: max_depth };
    const parsed: Result[bool, JsonError] = parser.value(0);
    if (parsed.is_err()) { ret Err(parsed.unwrap_err()); }
    parser.skip_whitespace();
    if (!parser.at_end()) { ret Err(JsonError.TrailingData); }
    ret Ok(true);
}

pub fn validate(source: str) Result[bool, JsonError] { ret validate_with_limits(source, 1048576, 64); }

// Encode a valid UTF-8 string as one JSON string token. Non-ASCII scalars are
// emitted directly; JSON is defined over Unicode and the input str invariant
// ensures their byte boundaries are safe to preserve.
pub fn quote(value: str) String {
    var output: String = String.from("\"");
    var offset: usize = 0;
    for (offset < value.bytes_len()) {
        const byte: u8 = core.str_byte_at(value, offset);
        if (byte == 34) { output = output.push_str("\\\""); offset = offset + 1; continue; }
        if (byte == 92) { output = output.push_str("\\\\"); offset = offset + 1; continue; }
        if (byte == 8) { output = output.push_str("\\b"); offset = offset + 1; continue; }
        if (byte == 12) { output = output.push_str("\\f"); offset = offset + 1; continue; }
        if (byte == 10) { output = output.push_str("\\n"); offset = offset + 1; continue; }
        if (byte == 13) { output = output.push_str("\\r"); offset = offset + 1; continue; }
        if (byte == 9) { output = output.push_str("\\t"); offset = offset + 1; continue; }
        if (byte < 32) {
            const digits: str = "0123456789abcdef";
            output = output.push_str("\\u00");
            const high: String = digits[(byte / 16) as isize:(byte / 16 + 1) as isize];
            const low: String = digits[(byte % 16) as isize:(byte % 16 + 1) as isize];
            output = output.push_str(high.as_str());
            output = output.push_str(low.as_str());
            offset = offset + 1;
            continue;
        }
        var width: usize = 1;
        if (byte >= 240) { width = 4; }
        else if (byte >= 224) { width = 3; }
        else if (byte >= 192) { width = 2; }
        const scalar: String = value[offset as isize:(offset + width) as isize];
        output = output.push_str(scalar.as_str());
        offset = offset + width;
    }
    output = output.push_str("\"");
    ret output;
}

pub fn boolean(value: bool) str { if (value) { ret "true"; } ret "false"; }

fn hex_value(byte: u8) u32 {
    if (byte >= 48 && byte <= 57) { ret (byte - 48) as u32; }
    if (byte >= 65 && byte <= 70) { ret (byte - 55) as u32; }
    ret (byte - 87) as u32;
}

fn unicode_escape(source: str, offset: usize) u32 {
    ret (hex_value(core.str_byte_at(source, offset)) << 12)
        | (hex_value(core.str_byte_at(source, offset + 1)) << 8)
        | (hex_value(core.str_byte_at(source, offset + 2)) << 4)
        | hex_value(core.str_byte_at(source, offset + 3));
}

unsafe fn write_scalar(buffer: *u8, offset: usize, scalar: u32) usize {
    unsafe {
        if (scalar <= 127) { *(buffer + offset) = scalar as u8; ret 1; }
        if (scalar <= 2047) {
            *(buffer + offset) = (192 | (scalar >> 6)) as u8;
            *(buffer + offset + 1) = (128 | (scalar & 63)) as u8;
            ret 2;
        }
        if (scalar <= 65535) {
            *(buffer + offset) = (224 | (scalar >> 12)) as u8;
            *(buffer + offset + 1) = (128 | ((scalar >> 6) & 63)) as u8;
            *(buffer + offset + 2) = (128 | (scalar & 63)) as u8;
            ret 3;
        }
        *(buffer + offset) = (240 | (scalar >> 18)) as u8;
        *(buffer + offset + 1) = (128 | ((scalar >> 12) & 63)) as u8;
        *(buffer + offset + 2) = (128 | ((scalar >> 6) & 63)) as u8;
        *(buffer + offset + 3) = (128 | (scalar & 63)) as u8;
    }
    ret 4;
}

// Decode exactly one JSON string token after validating its syntax and limits.
pub fn decode_string_with_limits(source: str, max_input: usize, max_depth: usize) Result[String, JsonError] {
    const valid: Result[bool, JsonError] = validate_with_limits(source, max_input, max_depth);
    if (valid.is_err()) { ret Err(valid.unwrap_err()); }
    var start: usize = 0; var end: usize = source.bytes_len();
    for (start < end && whitespace(core.str_byte_at(source, start))) { start = start + 1; }
    for (start < end && whitespace(core.str_byte_at(source, end - 1))) { end = end - 1; }
    if (end - start < 2 || core.str_byte_at(source, start) != 34 || core.str_byte_at(source, end - 1) != 34) { ret Err(JsonError.InvalidToken); }
    var buffer: *u8 = 0;
    unsafe { buffer = core.malloc(source.bytes_len() + 1); }
    if (buffer == 0) { ret Err(JsonError.InvalidString); }
    var read: usize = start + 1; var written: usize = 0;
    for (read < end - 1) {
        var byte: u8 = core.str_byte_at(source, read); read = read + 1;
        if (byte != 92) { unsafe { *(buffer + written) = byte; } written = written + 1; continue; }
        byte = core.str_byte_at(source, read); read = read + 1;
        if (byte == 34 || byte == 92 || byte == 47) { unsafe { *(buffer + written) = byte; } written = written + 1; continue; }
        if (byte == 98) { unsafe { written = written + write_scalar(buffer, written, 8); } continue; }
        if (byte == 102) { unsafe { written = written + write_scalar(buffer, written, 12); } continue; }
        if (byte == 110) { unsafe { written = written + write_scalar(buffer, written, 10); } continue; }
        if (byte == 114) { unsafe { written = written + write_scalar(buffer, written, 13); } continue; }
        if (byte == 116) { unsafe { written = written + write_scalar(buffer, written, 9); } continue; }
        var scalar: u32 = unicode_escape(source, read); read = read + 4;
        if (scalar >= 55296 && scalar <= 56319) {
            if (read + 6 > end - 1 || core.str_byte_at(source, read) != 92 || core.str_byte_at(source, read + 1) != 117) { unsafe { core.free(buffer); } ret Err(JsonError.InvalidString); }
            const low: u32 = unicode_escape(source, read + 2);
            if (low < 56320 || low > 57343) { unsafe { core.free(buffer); } ret Err(JsonError.InvalidString); }
            scalar = 65536 + ((scalar - 55296) << 10) + (low - 56320); read = read + 6;
        } else if (scalar >= 56320 && scalar <= 57343) { unsafe { core.free(buffer); } ret Err(JsonError.InvalidString); }
        unsafe { written = written + write_scalar(buffer, written, scalar); }
    }
    unsafe { *(buffer + written) = 0; }
    var result: String = String.new(); unsafe { result = String.from_raw(buffer, written, source.bytes_len() + 1); }
    ret Ok(result);
}

pub fn decode_string(source: str) Result[String, JsonError] { ret decode_string_with_limits(source, 1048576, 64); }

// Return the raw JSON value for one object key. The returned token is validated
// JSON and can be passed to a typed scalar decoder. Duplicate matching keys are
// rejected instead of selecting an implementation-defined winner.
pub fn object_field_with_limits(source: str, key: str, max_input: usize, max_depth: usize) Result[Option[String], JsonError] {
    const valid: Result[bool, JsonError] = validate_with_limits(source, max_input, max_depth);
    if (valid.is_err()) { ret Err(valid.unwrap_err()); }
    var start: usize = 0; var end: usize = source.bytes_len();
    for (start < end && whitespace(core.str_byte_at(source, start))) { start = start + 1; }
    for (start < end && whitespace(core.str_byte_at(source, end - 1))) { end = end - 1; }
    if (end - start < 2 || core.str_byte_at(source, start) != 123 || core.str_byte_at(source, end - 1) != 125) { ret Err(JsonError.InvalidToken); }
    var parser: Parser = Parser { source: source, offset: start + 1, max_depth: max_depth };
    parser.skip_whitespace();
    var found: Option[String] = None;
    if (!parser.at_end() && parser.byte() == 125) { ret Ok(found); }
    for (true) {
        if (parser.at_end() || parser.byte() != 34) { ret Err(JsonError.InvalidToken); }
        const key_start: usize = parser.offset;
        const scanned_key: Result[bool, JsonError] = parser.string();
        if (scanned_key.is_err()) { ret Err(scanned_key.unwrap_err()); }
        const key_end: usize = parser.offset;
        const raw_key: String = source[key_start as isize:key_end as isize];
        const decoded_key: Result[String, JsonError] = decode_string_with_limits(raw_key.as_str(), max_input, max_depth);
        if (decoded_key.is_err()) { ret Err(decoded_key.unwrap_err()); }
        parser.skip_whitespace();
        if (parser.at_end() || parser.byte() != 58) { ret Err(JsonError.InvalidToken); }
        parser.offset = parser.offset + 1; parser.skip_whitespace();
        const value_start: usize = parser.offset;
        const scanned_value: Result[bool, JsonError] = parser.value(1);
        if (scanned_value.is_err()) { ret Err(scanned_value.unwrap_err()); }
        const value_end: usize = parser.offset;
        if (decoded_key.unwrap().as_str() == key) {
            if (found.is_some()) { ret Err(JsonError.DuplicateKey); }
            found = Some(source[value_start as isize:value_end as isize]);
        }
        parser.skip_whitespace();
        if (parser.at_end()) { ret Err(JsonError.UnexpectedEnd); }
        if (parser.byte() == 125) { ret Ok(found); }
        if (parser.byte() != 44) { ret Err(JsonError.InvalidToken); }
        parser.offset = parser.offset + 1; parser.skip_whitespace();
    }
    ret Ok(found);
}

pub fn object_field(source: str, key: str) Result[Option[String], JsonError] {
    ret object_field_with_limits(source, key, 1048576, 64);
}
