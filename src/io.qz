// std.io — console I/O
// UTF-8 contract: all str/&str parameters are valid UTF-8.

import std.core.write as raw_write;
import std.core.write_bytes as raw_write_bytes;
import std.core.read as sys_read;
import std.core.strlen;
import std.core.malloc;
import std.core.free;
import std.core.realloc;
import std.core.str_as_ptr;
import std.win32_core;
import std.unix;

@cfg(target_os = "linux")
fn write_text(fd: i32, s: str) isize {
    var result: isize = 0;
    unsafe { result = raw_write(fd, s, strlen(s)); }
    ret result;
}

@cfg(target_os = "windows")
fn write_text(fd: i32, s: str) isize {
    const byte_len: usize = strlen(s);
    if (byte_len == 0) { ret 0; }
    if ((fd != 1 && fd != 2) || byte_len > 2147483647) {
        var raw_result: isize = 0;
        unsafe { raw_result = raw_write(fd, s, byte_len); }
        ret raw_result;
    }

    var handle: usize = 0;
    var mode: *u32 = 0;
    unsafe {
        if (fd == 1) { handle = win32_core.get_std_handle(4294967285); }
        else { handle = win32_core.get_std_handle(4294967284); }
        mode = malloc(4) as *u32;
    }
    if (mode == 0) {
        var raw_result: isize = 0;
        unsafe { raw_result = raw_write(fd, s, byte_len); }
        ret raw_result;
    }

    var is_console: i32 = 0;
    unsafe {
        is_console = win32_core.get_console_mode(handle, mode);
        free(mode as *u8);
    }
    // Pipes and files have no console mode and must keep portable UTF-8 bytes.
    if (is_console == 0) {
        var raw_result: isize = 0;
        unsafe { raw_result = raw_write(fd, s, byte_len); }
        ret raw_result;
    }

    var wide_len: i32 = 0;
    unsafe {
        wide_len = win32_core.utf8_to_utf16(
            65001, 8, str_as_ptr(s), byte_len as i32, 0, 0
        );
    }
    if (wide_len <= 0) { ret -1; }

    var wide: *u16 = 0;
    var written: *u32 = 0;
    unsafe {
        wide = malloc((wide_len as usize) * 2) as *u16;
        written = malloc(4) as *u32;
    }
    if (wide == 0 || written == 0) {
        unsafe {
            if (wide != 0) { free(wide as *u8); }
            if (written != 0) { free(written as *u8); }
        }
        ret -1;
    }

    var converted: i32 = 0;
    var succeeded: i32 = 0;
    unsafe {
        converted = win32_core.utf8_to_utf16(
            65001, 8, str_as_ptr(s), byte_len as i32, wide, wide_len
        );
        if (converted > 0) {
            succeeded = win32_core.write_console_utf16(
                handle, wide, converted as u32, written, 0
            );
        }
        free(wide as *u8);
        free(written as *u8);
    }
    if (succeeded == 0) { ret -1; }
    ret byte_len as isize;
}
// ── Writer types ──────────────────────────────────────────────────────────────

pub struct Stdout { fd: i32, }
pub struct Stderr { fd: i32, }

pub fn stdout() Stdout { ret Stdout { fd: 1 }; }
pub fn stderr() Stderr { ret Stderr { fd: 2 }; }

impl Write for Stdout {
    pub fn write(self: Stdout, s: str) void {
        write_text(1, s);
    }

    pub fn writeln(self: Stdout, s: str) void {
        write_text(1, s);
        write_text(1, "\n");
    }

    @format
    pub fn writef(self: Stdout, s: str, ...args: any) void {
        write_text(1, s);
    }

    @format
    pub fn writelnf(self: Stdout, s: str, ...args: any) void {
        write_text(1, s);
        write_text(1, "\n");
    }
}

impl Write for Stderr {
    pub fn write(self: Stderr, s: str) void {
        write_text(2, s);
    }

    pub fn writeln(self: Stderr, s: str) void {
        write_text(2, s);
        write_text(2, "\n");
    }

    @format
    pub fn writef(self: Stderr, s: str, ...args: any) void {
        write_text(2, s);
    }

    @format
    pub fn writelnf(self: Stderr, s: str, ...args: any) void {
        write_text(2, s);
        write_text(2, "\n");
    }
}

// ── stdout convenience ────────────────────────────────────────────────────────

@format
pub fn print(s: str, ...args: any) void {
    write_text(1, s);
}

@format
pub fn println(s: str, ...args: any) void {
    write_text(1, s);
    write_text(1, "\n");
}

// ── stderr convenience ────────────────────────────────────────────────────────

@format
pub fn err(s: str, ...args: any) void {
    write_text(2, s);
}

@format
pub fn errln(s: str, ...args: any) void {
    write_text(2, s);
    write_text(2, "\n");
}

// ── arbitrary fd ─────────────────────────────────────────────────────────────

pub fn writeln(fd: i32, s: str) void {
    write_text(fd, s);
    write_text(fd, "\n");
}

// ── stdin ─────────────────────────────────────────────────────────────────────

pub enum ReadError {
    AllocationFailed,
    CapacityOverflow,
    InputFailed,
    InvalidDelimiter,
    InvalidUtf8,
}

// Put an interactive terminal into byte-at-a-time mode. A null state means
// stdin is redirected (or the mode could not be changed), so ordinary buffered
// reads remain correct. The caller must restore every non-null state.
@cfg(target_os = "linux")
unsafe fn __io_begin_immediate_input() *u8 {
    // Linux x86-64 kernel termios occupies 36 bytes. Keep a full 64-byte
    // original plus a mutable copy so restoration is exact.
    var state: *u8 = malloc(128);
    if (state == 0) { ret 0; }
    if (unix.ioctl_ptr(0, 21505, state) != 0) { // TCGETS
        free(state);
        ret 0;
    }
    var index: usize = 0;
    for (index < 64) {
        *(state + 64 + index) = *(state + index);
        index++;
    }
    var current: *u8 = state + 64;
    // c_lflag low byte: clear ICANON (0x02) and ECHO (0x08).
    *(current + 12) = *(current + 12) & 245;
    // c_cc[VTIME] = 0, c_cc[VMIN] = 1.
    *(current + 22) = 0;
    *(current + 23) = 1;
    if (unix.ioctl_ptr(0, 21506, current) != 0) { // TCSETS
        free(state);
        ret 0;
    }
    ret state;
}

@cfg(target_os = "linux")
unsafe fn __io_end_immediate_input(state: *u8) void {
    if (state == 0) { ret; }
    unix.ioctl_ptr(0, 21506, state); // TCSETS
    free(state);
}

@cfg(target_os = "windows")
unsafe fn __io_begin_immediate_input() *u8 {
    const handle: usize = win32_core.get_std_handle(4294967286);
    var state: *u32 = malloc(4) as *u32;
    if (state == 0) { ret 0; }
    if (win32_core.get_console_mode(handle, state) == 0) {
        free(state as *u8);
        ret 0;
    }
    // Clear ENABLE_LINE_INPUT and ENABLE_ECHO_INPUT. read() echoes consumed
    // bytes itself; readkey() intentionally behaves like a conventional key read.
    const immediate_mode: u32 = *state & 4294967289;
    if (win32_core.set_console_mode(handle, immediate_mode) == 0) {
        free(state as *u8);
        ret 0;
    }
    ret state as *u8;
}

@cfg(target_os = "windows")
unsafe fn __io_end_immediate_input(state: *u8) void {
    if (state == 0) { ret; }
    const handle: usize = win32_core.get_std_handle(4294967286);
    win32_core.set_console_mode(handle, *(state as *u32));
    free(state);
}

unsafe fn __io_is_continuation(buf: *u8, idx: usize, len: usize) bool {
    if (idx >= len) { ret false; }
    var b: u8 = *(buf + idx);
    ret b >= 128 && b <= 191;
}

unsafe fn __io_ends_with(buf: *u8, len: usize, delimiter: *u8,
    delimiter_len: usize) bool {
    if (delimiter_len == 0 || delimiter_len > len) { ret false; }
    const start: usize = len - delimiter_len;
    var index: usize = 0;
    for (index < delimiter_len) {
        if (*(buf + start + index) != *(delimiter + index)) { ret false; }
        index++;
    }
    ret true;
}

unsafe fn __io_valid_utf8(buf: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        var b0: u8 = *(buf + i);
        if (b0 <= 127) {
            i = i + 1;
        } else if (b0 >= 194 && b0 <= 223) {
            if (!__io_is_continuation(buf, i + 1, len)) { ret false; }
            i = i + 2;
        } else if (b0 >= 224 && b0 <= 239) {
            if (i + 2 >= len) { ret false; }
            var b1: u8 = *(buf + i + 1);
            var b2: u8 = *(buf + i + 2);
            if (b2 < 128 || b2 > 191) { ret false; }
            if (b0 == 224) {
                if (b1 < 160 || b1 > 191) { ret false; }
            } else if (b0 == 237) {
                if (b1 < 128 || b1 > 159) { ret false; }
            } else if (b1 < 128 || b1 > 191) {
                ret false;
            }
            i = i + 3;
        } else if (b0 >= 240 && b0 <= 244) {
            if (i + 3 >= len) { ret false; }
            var b1: u8 = *(buf + i + 1);
            if (!__io_is_continuation(buf, i + 2, len)) { ret false; }
            if (!__io_is_continuation(buf, i + 3, len)) { ret false; }
            if (b0 == 240) {
                if (b1 < 144 || b1 > 191) { ret false; }
            } else if (b0 == 244) {
                if (b1 < 128 || b1 > 143) { ret false; }
            } else if (b1 < 128 || b1 > 191) {
                ret false;
            }
            i = i + 4;
        } else {
            ret false;
        }
    }
    ret true;
}

// Read from stdin until the UTF-8 `delimiter` or EOF. The delimiter is not
// returned. Interactive custom delimiters use immediate input; Enter is
// normalized from Windows CRLF/CR to `\n`.
// Returns an owned, UTF-8-validated String and frees all buffers on failure.
pub fn read(delimiter: str) Result[String, ReadError] {
    const delimiter_len: usize = strlen(delimiter);
    if (delimiter_len == 0) { ret Err(ReadError.InvalidDelimiter); }
    var delimiter_ptr: *u8 = 0;
    unsafe { delimiter_ptr = str_as_ptr(delimiter); }

    var cap: usize = 64;
    var len: usize = 0;
    var buf: *u8 = 0;
    unsafe { buf = malloc(cap); }
    if (buf == 0) { ret Err(ReadError.AllocationFailed); }

    var input_state: *u8 = 0;
    var skip_lf_after_cr: bool = false;
    if (delimiter != "\n") {
        unsafe { input_state = __io_begin_immediate_input(); }
    }

    for (true) {
        if (len + 1 >= cap) {
            if (cap > 9223372036854775807) {
                unsafe {
                    __io_end_immediate_input(input_state);
                    free(buf);
                }
                ret Err(ReadError.CapacityOverflow);
            }
            var new_cap: usize = cap * 2;
            var new_buf: *u8 = 0;
            unsafe { new_buf = realloc(buf, new_cap); }
            if (new_buf == 0) {
                unsafe {
                    __io_end_immediate_input(input_state);
                    free(buf);
                }
                ret Err(ReadError.AllocationFailed);
            }
            buf = new_buf;
            cap = new_cap;
        }

        var n: isize = 0;
        unsafe { n = sys_read(0, buf + len, 1); }
        if (n == 0) { break; }
        if (n < 0) {
            unsafe {
                __io_end_immediate_input(input_state);
                free(buf);
            }
            ret Err(ReadError.InputFailed);
        }
        var b: u8 = 0;
        unsafe { b = *(buf + len); }
        if (b == 10 && skip_lf_after_cr) {
            skip_lf_after_cr = false;
            continue;
        }
        skip_lf_after_cr = false;
        // Windows canonical input reports Enter as CRLF. Discard CR while
        // readln waits for LF; immediate input reports only CR, normalized to LF.
        if (b == 13) {
            if (delimiter == "\n" && input_state == 0) { continue; }
            b = 10;
            skip_lf_after_cr = true;
            unsafe { *(buf + len) = b; }
        }
        // Immediate terminal mode disables kernel/console echo so behavior is
        // identical on Linux and Windows. Redirected input is never echoed.
        if (input_state != 0) {
            if (b == 10) { write_text(1, "\r\n"); }
            else { unsafe { raw_write_bytes(1, buf + len, 1); } }
        }
        len = len + 1;
        var matched: bool = false;
        unsafe { matched = __io_ends_with(buf, len, delimiter_ptr, delimiter_len); }
        if (matched) {
            len = len - delimiter_len;
            break;
        }
    }

    unsafe { __io_end_immediate_input(input_state); }

    var valid: bool = false;
    unsafe { valid = __io_valid_utf8(buf, len); }
    if (!valid) {
        unsafe { free(buf); }
        ret Err(ReadError.InvalidUtf8);
    }
    var result: String;
    unsafe {
        *(buf + len) = 0;
        result = String.from_raw(buf, len, cap);
    }
    ret Ok(result);
}

// Read a full line. The trailing newline is not included.
pub fn readln() Result[String, ReadError] {
    ret read("\n");
}

// Read one complete UTF-8 scalar value. EOF returns an empty String.
pub fn readkey() Result[String, ReadError] {
    var buf: *u8 = 0;
    unsafe { buf = malloc(5); }
    if (buf == 0) { ret Err(ReadError.AllocationFailed); }

    var input_state: *u8 = 0;
    unsafe { input_state = __io_begin_immediate_input(); }

    var n: isize = 0;
    unsafe { n = sys_read(0, buf, 1); }
    if (n == 0) {
        var empty: String;
        unsafe {
            __io_end_immediate_input(input_state);
            *buf = 0;
            empty = String.from_raw(buf, 0, 5);
        }
        ret Ok(empty);
    }
    if (n < 0) {
        unsafe {
            __io_end_immediate_input(input_state);
            free(buf);
        }
        ret Err(ReadError.InputFailed);
    }

    var first: u8 = 0;
    unsafe { first = *buf; }
    if (first == 13) {
        first = 10;
        unsafe { *buf = first; }
    }
    var width: usize = 1;
    if (first >= 194 && first <= 223) {
        width = 2;
    } else if (first >= 224 && first <= 239) {
        width = 3;
    } else if (first >= 240 && first <= 244) {
        width = 4;
    } else if (first > 127) {
        unsafe {
            __io_end_immediate_input(input_state);
            free(buf);
        }
        ret Err(ReadError.InvalidUtf8);
    }

    var pos: usize = 1;
    for (pos < width) {
        unsafe { n = sys_read(0, buf + pos, width - pos); }
        if (n <= 0) {
            unsafe {
                __io_end_immediate_input(input_state);
                free(buf);
            }
            if (n < 0) { ret Err(ReadError.InputFailed); }
            ret Err(ReadError.InvalidUtf8);
        }
        pos = pos + (n as usize);
    }

    unsafe { __io_end_immediate_input(input_state); }

    var valid: bool = false;
    unsafe { valid = __io_valid_utf8(buf, width); }
    if (!valid) {
        unsafe { free(buf); }
        ret Err(ReadError.InvalidUtf8);
    }
    var result: String;
    unsafe {
        *(buf + width) = 0;
        result = String.from_raw(buf, width, 5);
    }
    ret Ok(result);
}

