// std.ini — deterministic, source-backed INI documents.
import std.fs;

// An INI document and the file it came from, if any.
// Blank lines and full-line `#`/`;` comments are ignored. Whitespace around
// section names and keys is ignored; the first `=` splits a key/value pair;
// later key definitions win; values retain their interior text. Parsing is
// atomic: malformed input never replaces a previously valid document.
pub struct IniDocument { content: String, path: String, }

// Why INI text could not be parsed.
pub enum IniError {
    EmptySection(usize),
    InvalidSection(usize),
    MissingSeparator(usize),
    EmptyKey(usize),
}

// Errors produced while decoding a valid INI document into typed fields. The
// compiler-generated `IniDecode` implementation never has to inspect source
// text itself: it only composes these stable operations.
pub enum IniDecodeError {
    Syntax(IniError),
    MissingValue(String, String),
    InvalidValue(String, String),
    // Reading or writing a document file failed.
    Io(String),
    // A value to encode contains a line break, which INI cannot hold.
    MultilineValue(String),
}

fn section_name(line: str) String {
    const text = line.trim();
    if text.len() < 2 || !text.starts_with("[") || !text.ends_with("]") { ret String.new(); }
    ret text[1:-1].trim();
}

fn ignored(line: str) bool {
    const text = line.trim();
    ret text.is_empty() || text.starts_with("#") || text.starts_with(";");
}

fn validate(content: str) Result[bool, IniError] {
    var start: usize = 0;
    var index: usize = 0;
    var line_number: usize = 1;
    const length = content.len();
    for index <= length {
        if index == length || content[index as isize] == 10 {
            const line = content[start as isize:index as isize];
            const text = line.as_str().trim();
            if !ignored(text.as_str()) {
                const opens_section = text.starts_with("[");
                const closes_section = text.ends_with("]");
                if opens_section || closes_section {
                    if !opens_section || !closes_section { ret Err(IniError.InvalidSection(line_number)); }
                    const name = text.as_str()[1:-1].trim();
                    if name.is_empty() { ret Err(IniError.EmptySection(line_number)); }
                } else {
                    const equal = text.as_str().find("=");
                    if equal.is_none() { ret Err(IniError.MissingSeparator(line_number)); }
                    const key = text.as_str()[0:equal.unwrap() as isize].trim();
                    if key.is_empty() { ret Err(IniError.EmptyKey(line_number)); }
                }
            }
            start = index + 1;
            line_number++;
        }
        index++;
    }
    ret Ok(true);
}

fn lookup(content: str, wanted_section: str, wanted_key: str) Option[String] {
    var section = String.new();
    var found = false;
    var result = String.new();
    var start: usize = 0;
    var index: usize = 0;
    const length = content.len();
    for index <= length {
        if index == length || content[index as isize] == 10 {
            const line = content[start as isize:index as isize];
            if !ignored(line.as_str()) {
                const next_section = section_name(line.as_str());
                if !next_section.is_empty() {
                    section.clear();
                    section = next_section;
                } else if section.as_str() == wanted_section {
                    const equal = line.as_str().find("=");
                    if equal.is_some() {
                        const at = equal.unwrap();
                        const key = line.as_str()[0:at as isize].trim();
                        if key.as_str() == wanted_key {
                            const value = line.as_str()[at as isize + 1:].trim();
                            result.clear();
                            result = value;
                            found = true;
                        }
                    }
                }
            }
            start = index + 1;
        }
        index++;
    }
    section.free();
    if found { ret Some(result); }
    result.free();
    ret None;
}

fn has_section_in(content: str, wanted: str) bool {
    var start: usize = 0;
    var index: usize = 0;
    const length = content.len();
    for index <= length {
        if index == length || content[index as isize] == 10 {
            const line = content[start as isize:index as isize];
            const section = section_name(line.as_str());
            if section.as_str() == wanted { ret true; }
            section.free();
            start = index + 1;
        }
        index++;
    }
    ret false;
}

impl IniDocument {
    // An empty document.
    pub fn new() IniDocument { ret IniDocument { content: String.new(), path: String.new() }; }

    // A document parsed from INI text (`[section]` headers and `key = value`
    // lines; `#` and `;` start comments).
    pub fn parse(content: str) Result[IniDocument, IniDecodeError] {
        var document = IniDocument.new();
        const parsed = document.parse_string(content);
        if parsed.is_err() { ret Err(IniDecodeError.Syntax(parsed.unwrap_err())); }
        ret Ok(document);
    }

    // The value of `key` in `section`, or `None`.
    pub fn get(self: &IniDocument, section: str, key: str) Option[String] {
        ret lookup(self.content.as_str(), section, key);
    }

    // Whether `section` has `key`.
    pub fn contains(self: &IniDocument, section: str, key: str) bool {
        ret self.get(section, key).is_some();
    }

    // Whether the document has `section`.
    pub fn has_section(self: &IniDocument, section: str) bool {
        ret has_section_in(self.content.as_str(), section);
    }

    // Frees the document; called automatically at the end of scope.
    pub fn free(self: IniDocument) void {
        self.content.free();
        self.path.free();
    }

    // Replaces the contents with the parsed `content`; on error the previous
    // contents stay.
    pub fn parse_string(self: &IniDocument!, content: str) Result[bool, IniError] {
        const checked = validate(content);
        if checked.is_err() { ret Err(checked.unwrap_err()); }
        self.content.clear();
        self.content = String.from(content);
        ret Ok(true);
    }

    // The document as INI text.
    pub fn stringify(self: &IniDocument) String { ret String.from(self.content.as_str()); }

    // The document stored in the file at `path` (D-026).
    pub fn load(path: str) Result[IniDocument, IniDecodeError] {
        const read = fs.read_to_string(path);
        if read.is_err() { ret Err(IniDecodeError.Io(String.from(read.unwrap_err().message()))); }
        const text: String = read.unwrap();
        const checked = validate(text.as_str());
        if checked.is_err() { ret Err(IniDecodeError.Syntax(checked.unwrap_err())); }
        // The file text moves into the document; nothing borrows it.
        ret Ok(IniDocument { content: text, path: String.from(path) });
    }

    // The whole document decoded as `T` (keys before any section are `T`'s
    // scalar fields; a nested struct field reads the section of its key).
    pub fn decode[T: IniDeserialize](self: &IniDocument) Result[T, IniDecodeError] {
        ret T.from_ini_section(self, "");
    }

    // Replace the document with the INI form of `value`.
    pub fn encode[T: IniSerialize](self: &IniDocument!, value: T) Result[bool, IniDecodeError] {
        const writer: IniWriter = value.to_ini_writer();
        const text: String = writer.finish()?;
        const checked = validate(text.as_str());
        if checked.is_err() { ret Err(IniDecodeError.Syntax(checked.unwrap_err())); }
        self.content.clear();
        self.content = text;
        ret Ok(true);
    }

    // Write the document back to the file it was loaded from.
    pub fn save(self: &IniDocument) Result[bool, IniDecodeError] {
        if self.path.bytes_len() == 0 { ret Err(IniDecodeError.Io(String.from("the document has no file path; use save_as"))); }
        ret self.save_as(self.path.as_str());
    }

    // Write the document to `path`.
    pub fn save_as(self: &IniDocument, path: str) Result[bool, IniDecodeError] {
        const written = fs.write(path, self.content.as_str());
        if written.is_err() { ret Err(IniDecodeError.Io(String.from(written.unwrap_err().message()))); }
        ret Ok(true);
    }

    // The value of `key` in `section`, or `MissingValue(section, key)`.
    pub fn require_string(self: &IniDocument, section: str, key: str) Result[String, IniDecodeError] {
        const value = self.get(section, key);
        if value.is_none() { ret Err(IniDecodeError.MissingValue(String.from(section), String.from(key))); }
        ret Ok(value.unwrap());
    }

    // The value of `key` parsed as `i32`.
    pub fn require_i32(self: &IniDocument, section: str, key: str) Result[i32, IniDecodeError] {
        const value = self.get(section, key);
        if value.is_none() { ret Err(IniDecodeError.MissingValue(String.from(section), String.from(key))); }
        const text = value.unwrap();
        const parsed = text.parse_i32();
        if parsed.is_err() { ret Err(IniDecodeError.InvalidValue(String.from(section), String.from(key))); }
        ret Ok(parsed.unwrap());
    }

    // The value of `key` parsed as `u64`.
    pub fn require_u64(self: &IniDocument, section: str, key: str) Result[u64, IniDecodeError] {
        const value = self.get(section, key);
        if value.is_none() { ret Err(IniDecodeError.MissingValue(String.from(section), String.from(key))); }
        const text = value.unwrap();
        const parsed = text.parse_u64();
        if parsed.is_err() { ret Err(IniDecodeError.InvalidValue(String.from(section), String.from(key))); }
        ret Ok(parsed.unwrap());
    }

    // The value of `key` parsed as `true`/`false`.
    pub fn require_bool(self: &IniDocument, section: str, key: str) Result[bool, IniDecodeError] {
        const value = self.get(section, key);
        if value.is_none() { ret Err(IniDecodeError.MissingValue(String.from(section), String.from(key))); }
        const text = value.unwrap();
        if text.as_str() == "true" { ret Ok(true); }
        if text.as_str() == "false" { ret Ok(false); }
        ret Err(IniDecodeError.InvalidValue(String.from(section), String.from(key)));
    }
}

@test
fn parses_sections_values_comments_and_crlf() void {
    var config = IniDocument.new();
    config.parse_string("# comment\r\n[database]\r\nhost = localhost\r\n[server]\r\ntoken = left=right\r\nempty =\r\n").unwrap();
    const host = config.get("database", "host").unwrap();
    if host.as_str() != "localhost" { panic("database.host was parsed incorrectly"); }
    const token = config.get("server", "token").unwrap();
    if token.as_str() != "left=right" { panic("embedded equals signs were lost"); }
    if !config.has_section("database") || !config.contains("server", "empty") { panic("section or empty value was lost"); }
    const serialized = config.stringify();
    if serialized.as_str() != "# comment\r\n[database]\r\nhost = localhost\r\n[server]\r\ntoken = left=right\r\nempty =\r\n" { panic("stringify changed the source"); }
    config.free();
}

@test
fn duplicate_keys_and_reparse_are_deterministic() void {
    var config = IniDocument.new();
    config.parse_string("[app]\nmode = development\nmode = production\n").unwrap();
    const mode = config.get("app", "mode").unwrap();
    if mode.as_str() != "production" { panic("later key definitions must win"); }
    config.parse_string("[new]\nvalue = fresh\n").unwrap();
    if config.has_section("app") || config.get("new", "value").unwrap().as_str() != "fresh" { panic("reparse did not replace source"); }
    config.free();
}

@test
fn rejects_invalid_input_without_replacing_the_document() void {
    var config = IniDocument.new();
    config.parse_string("[stable]\nvalue = kept\n").unwrap();
    const malformed = config.parse_string("[broken\nvalue = lost\n");
    if malformed.is_ok() { panic("unterminated section was accepted"); }
    if config.get("stable", "value").unwrap().as_str() != "kept" { panic("failed parse replaced the previous document"); }
    config.free();
}

@test
fn reports_each_invalid_form_with_its_line() void {
    var config = IniDocument.new();
    const empty_section = config.parse_string("\n[]\n");
    const missing_separator = config.parse_string("[app]\nvalue\n");
    const empty_key = config.parse_string("[app]\n = value\n");
    const stray_bracket = config.parse_string("[app]\nvalue]\n");
    const empty_section_line = match empty_section.unwrap_err() { IniError.EmptySection(line) => line, _ => 0, };
    const missing_separator_line = match missing_separator.unwrap_err() { IniError.MissingSeparator(line) => line, _ => 0, };
    const empty_key_line = match empty_key.unwrap_err() { IniError.EmptyKey(line) => line, _ => 0, };
    const stray_bracket_line = match stray_bracket.unwrap_err() { IniError.InvalidSection(line) => line, _ => 0, };
    if empty_section_line != 2 || missing_separator_line != 2 || empty_key_line != 2 || stray_bracket_line != 2 { panic("invalid INI line was wrong"); }
    config.free();
}

@test
fn typed_lookup_reports_missing_invalid_and_syntax_errors() void {
    const syntax = IniDocument.parse("[broken\n");
    if syntax.is_ok() { panic("malformed source decoded"); }
    var config = IniDocument.parse("port = not-a-number\n").unwrap();
    const missing = config.require_string("server", "host");
    const invalid = config.require_i32("", "port");
    const invalid_bool = config.require_bool("", "port");
    if missing.is_ok() || invalid.is_ok() || invalid_bool.is_ok() { panic("invalid typed input decoded"); }
    const missing_names = match missing.unwrap_err() { IniDecodeError.MissingValue(section, key) => section.as_str() == "server" && key.as_str() == "host", _ => false, };
    const invalid_names = match invalid.unwrap_err() { IniDecodeError.InvalidValue(section, key) => section.as_str() == "" && key.as_str() == "port", _ => false, };
    if !missing_names || !invalid_names { panic("typed error did not retain its section/key"); }
    config.free();
}

// ── Typed marshalling (D-026) ────────────────────────────────────────────────

// A scalar stored as one INI value: integers, floats, `bool` and `String`.
pub trait IniValue {
    fn ini_text(self: Self) String;
    @associated fn from_ini_text(text: str) Option[Self];
}

impl IniValue for bool {
    fn ini_text(self: bool) String { if self { ret String.from("true"); } ret String.from("false"); }
    fn from_ini_text(text: str) Option[bool] {
        if text == "true" { ret Some(true); }
        if text == "false" { ret Some(false); }
        ret None;
    }
}

impl IniValue for i8 {
    fn ini_text(self: i8) String { ret self.to_string(); }
    fn from_ini_text(text: str) Option[i8] {
        const parsed = text.parse_i8();
        if parsed.is_err() { ret None; }
        ret Some(parsed.unwrap());
    }
}

impl IniValue for i16 {
    fn ini_text(self: i16) String { ret self.to_string(); }
    fn from_ini_text(text: str) Option[i16] {
        const parsed = text.parse_i16();
        if parsed.is_err() { ret None; }
        ret Some(parsed.unwrap());
    }
}

impl IniValue for i32 {
    fn ini_text(self: i32) String { ret self.to_string(); }
    fn from_ini_text(text: str) Option[i32] {
        const parsed = text.parse_i32();
        if parsed.is_err() { ret None; }
        ret Some(parsed.unwrap());
    }
}

impl IniValue for i64 {
    fn ini_text(self: i64) String { ret self.to_string(); }
    fn from_ini_text(text: str) Option[i64] {
