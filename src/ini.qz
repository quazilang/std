}

impl IniValue for String {
    fn ini_text(self: String) String { ret self; }
    fn from_ini_text(text: str) Option[String] { ret Some(String.from(text)); }
}

// A struct written as INI: its scalar fields as `key = value` lines and its
// struct fields as `[key]` sections (`@serde("ini")` generates it).
pub trait IniSerialize {
    fn to_ini_writer(self: Self) IniWriter;
}

// A struct read from one section of an INI document (`""` is the part
// before the first section header).
pub trait IniDeserialize {
    @associated fn from_ini_section(document: &IniDocument, section: str) Result[Self, IniDecodeError];
}

// Collects the lines of one struct (used by generated `to_ini_writer`).
pub struct IniWriter { entries: String, sections: String, invalid_key: String, }

impl IniWriter {
    // An empty writer.
    pub fn new() IniWriter { ret IniWriter { entries: String.new(), sections: String.new(), invalid_key: String.new() }; }

    // Write `key = value`.
    pub fn entry[T: IniValue](self: &IniWriter!, key: str, value: T) void {
        const text: String = value.ini_text();
        if text.as_str().find("\n").is_some() && self.invalid_key.bytes_len() == 0 {
            self.invalid_key = String.from(key);
        }
        self.entries.push_str(key);
        self.entries.push_str(" = ");
        self.entries.push_str(text.as_str());
        self.entries.push_str("\n");
    }

    // Write `key = value` for `Some`, nothing for `None`.
    pub fn optional[T: IniValue](self: &IniWriter!, key: str, value: Option[T]) void {
        if value.is_some() { self.entry(key, value.unwrap()); }
    }

    // Write `value` as the section `[name]`.
    pub fn section[T: IniSerialize](self: &IniWriter!, name: str, value: T) void {
        const inner: IniWriter = value.to_ini_writer();
        if inner.invalid_key.bytes_len() > 0 && self.invalid_key.bytes_len() == 0 {
            self.invalid_key = String.from(inner.invalid_key.as_str());
        }
        self.sections.push_str("\n[");
        self.sections.push_str(name);
        self.sections.push_str("]\n");
        self.sections.push_str(inner.entries.as_str());
    }

    // The INI text: entries, then sections.
    pub fn finish(self: &IniWriter) Result[String, IniDecodeError] {
        if self.invalid_key.bytes_len() > 0 {
            ret Err(IniDecodeError.MultilineValue(String.from(self.invalid_key.as_str())));
        }
        var text = String.from(self.entries.as_str());
        text.push_str(self.sections.as_str());
        ret Ok(text);
    }
}

// The value of `key` in `section` as `T`; MissingValue or InvalidValue.
pub fn read[T: IniValue](document: &IniDocument, section: str, key: str) Result[T, IniDecodeError] {
    const text = document.get(section, key);
    if text.is_none() { ret Err(IniDecodeError.MissingValue(String.from(section), String.from(key))); }
    const raw: String = text.unwrap();
    const value: Option[T] = T.from_ini_text(raw.as_str());
    if value.is_none() { ret Err(IniDecodeError.InvalidValue(String.from(section), String.from(key))); }
    ret Ok(value.unwrap());
}

// The value of `key` in `section` as `T`, or `None` when the key is absent.
pub fn read_optional[T: IniValue](document: &IniDocument, section: str, key: str) Result[Option[T], IniDecodeError] {
    if !document.contains(section, key) { ret Ok(None); }
    const value: T = read[T](document, section, key)?;
    ret Ok(Some(value));
}
