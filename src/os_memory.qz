// Internal Linux /proc/meminfo parsing. Return scalar bytes, never text views.
import std.core;

fn whitespace(value: u8) bool {
    ret value == 32 || value == 9 || value == 13;
}

fn field_bytes(text: str, key: str) Option[u64] {
    const length: usize = core.strlen(text);
    const key_length: usize = core.strlen(key);
    var offset: usize = 0;
    var found: bool = false;
    var result: u64 = 0;
    for (offset < length) {
        const start: usize = offset;
        for (offset < length && core.str_byte_at(text, offset) != 10) { offset++; }
        const end: usize = offset;
        if (offset < length) { offset++; }
        if (end - start <= key_length) { continue; }
        var index: usize = 0;
        for (index < key_length && core.str_byte_at(text, start + index) == core.str_byte_at(key, index)) {
            index++;
        }
        if (index != key_length || core.str_byte_at(text, start + index) != 58) { continue; }
        if (found) { ret Option.None; }
        found = true;
        index = start + key_length + 1;
        for (index < end && whitespace(core.str_byte_at(text, index))) { index++; }
        const digits: usize = index;
        var kib: u64 = 0;
        for (index < end) {
            const byte: u8 = core.str_byte_at(text, index);
            if (byte < 48 || byte > 57) { break; }
            const digit: u64 = (byte - 48) as u64;
            if (kib > 1844674407370955161 || (kib == 1844674407370955161 && digit > 5)) {
                ret Option.None;
            }
            kib = kib * 10 + digit;
            index++;
        }
        if (index == digits || index == end || !whitespace(core.str_byte_at(text, index))) {
            ret Option.None;
        }
        for (index < end && whitespace(core.str_byte_at(text, index))) { index++; }
        if (end - index < 2) { ret Option.None; }
        if (core.str_byte_at(text, index) != 107 || core.str_byte_at(text, index + 1) != 66) {
            ret Option.None;
        }
        index = index + 2;
        for (index < end && whitespace(core.str_byte_at(text, index))) { index++; }
        if (index != end || kib > 18014398509481983) { ret Option.None; }
        result = kib * 1024;
    }
    if (!found) { ret Option.None; }
    ret Option.Some(result);
}

// MemAvailable includes memory reclaimable without swapping. Zero is valid.
// Missing, malformed or inconsistent snapshots use the caller's native fallback.
pub fn available_bytes(text: str) Option[u64] {
    const total: Option[u64] = field_bytes(text, "MemTotal");
    const available: Option[u64] = field_bytes(text, "MemAvailable");
    if (total.is_none() || available.is_none()) { ret Option.None; }
    const total_bytes: u64 = total.unwrap();
    const available_bytes: u64 = available.unwrap();
    if (total_bytes == 0 || available_bytes > total_bytes) { ret Option.None; }
    ret Option.Some(available_bytes);
}

// Deterministic procfs fixtures; no dependency on the host's memory pressure.
@test
fn memory_available_includes_reclaimable_cache() void {
    const value = available_bytes("MemTotal: 1000 kB\nMemFree: 100 kB\nMemAvailable: 700 kB\nCached: 600 kB\n");
    if (value.is_none() || value.unwrap() != 716800) { panic("MemAvailable was not preferred over MemFree"); }
}

@test
fn memory_available_accepts_zero_and_total() void {
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 0 kB").unwrap() != 0) { panic("zero availability is valid"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 10 kB").unwrap() != 10240) { panic("all memory can be available"); }
}

@test
fn memory_available_accepts_procfs_whitespace_and_field_order() void {
    const value = available_bytes("HugePages_Total: 0\r\nMemAvailable:\t7\tkB \r\nMemAvailableOther: 99 kB\nMemTotal: 10 kB");
    if (value.is_none() || value.unwrap() != 7168) { panic("valid procfs formatting was rejected"); }
}

@test
fn memory_available_rejects_missing_or_inconsistent_fields() void {
    if (available_bytes("").is_some()) { panic("empty procfs accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemFree: 7 kB").is_some()) { panic("MemFree is not MemAvailable"); }
    if (available_bytes("MemAvailable: 7 kB").is_some()) { panic("missing total accepted"); }
    if (available_bytes("MemTotal: 0 kB\nMemAvailable: 0 kB").is_some()) { panic("zero total accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 11 kB").is_some()) { panic("availability exceeded total"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 1 kB\nMemAvailable: 2 kB").is_some()) { panic("duplicate availability accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemTotal: 20 kB\nMemAvailable: 1 kB").is_some()) { panic("duplicate total accepted"); }
}

@test
fn memory_available_rejects_malformed_values_and_units() void {
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: -1 kB").is_some()) { panic("negative counter accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: kB").is_some()) { panic("missing counter accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 1 MB").is_some()) { panic("wrong units accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 1kB").is_some()) { panic("missing separator accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 1 kB junk").is_some()) { panic("trailing garbage accepted"); }
    if (available_bytes("MemTotal: 10 kB\nMemAvailable: 1").is_some()) { panic("missing unit accepted"); }
}

@test
fn memory_available_checks_decimal_and_byte_overflow() void {
    if (available_bytes("MemTotal: 18446744073709551616 kB\nMemAvailable: 1 kB").is_some()) { panic("decimal overflow accepted"); }
    if (available_bytes("MemTotal: 18014398509481984 kB\nMemAvailable: 1 kB").is_some()) { panic("byte conversion overflow accepted"); }
    const limit = available_bytes("MemTotal: 18014398509481983 kB\nMemAvailable: 18014398509481983 kB");
    if (limit.is_none() || limit.unwrap() != 18446744073709550592) { panic("largest representable KiB counter was rejected"); }
}
