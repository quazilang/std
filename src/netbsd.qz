pub unsafe fn closedir(handle: *u8) i32 { ret __closedir(handle); }

@api("link")
unsafe fn __link(old: *u8, new_path: *u8) i32;
@api("symlink")
unsafe fn __symlink(target: *u8, link_path: *u8) i32;
@api("chmod")
unsafe fn __chmod(path: *u8, mode: u32) i32;
@api("getpid")
unsafe fn __getpid() i32;
@api("getppid")
unsafe fn __getppid() i32;

// NetBSD libc `link`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn link(old: str, new_path: str) i32 {
    const code: i32 = __link(core.str_as_ptr(old), core.str_as_ptr(new_path));
    if (code < 0) { ret __err(); }
    ret code;
}
// NetBSD libc `symlink`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn symlink(target: str, link_path: str) i32 {
    const code: i32 = __symlink(core.str_as_ptr(target), core.str_as_ptr(link_path));
    if (code < 0) { ret __err(); }
    ret code;
}
// NetBSD libc `chmod`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn chmod(path: str, mode: u32) i32 {
    const code: i32 = __chmod(core.str_as_ptr(path), mode);
    if (code < 0) { ret __err(); }
    ret code;
}
// NetBSD libc `getpid`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn getpid() i32 { ret __getpid(); }
// NetBSD libc `getppid`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn getppid() i32 { ret __getppid(); }

// Socket APIs: wrap libc errno in the existing negative-error convention.
@api("socket")
unsafe fn __socket(domain: i32, kind: i32, protocol: i32) i32;
@api("listen")
unsafe fn __listen(socket: i32, backlog: i32) i32;
@api("accept")
unsafe fn __accept(socket: i32, addr: *u8, len: *u32) i32;
@api("sendto")
unsafe fn __sendto(socket: i32, data: *u8, length: usize, flags: i32, address: *u8, address_size: u32) isize;
@api("recvfrom")
unsafe fn __recvfrom(socket: i32, data: *u8, length: usize, flags: i32, address: *u8, address_size: *u32) isize;
@api("shutdown")
unsafe fn __shutdown(socket: i32, how: i32) i32;
@api("setsockopt")
unsafe fn __setsockopt(socket: i32, level: i32, name: i32, value: *u8, length: u32) i32;

// NetBSD libc `socket`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn socket(domain: i32, kind: i32, protocol: i32) i32 {
    const fd: i32 = __socket(domain, kind, protocol);
    if (fd < 0) { ret __err(); }
    ret fd;
}
// NetBSD libc `setsockopt`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn setsockopt(fd: i32, level: i32, name: i32, value: *u8, length: u32) i32 {
    const code: i32 = __setsockopt(fd, level, name, value, length);
    if (code < 0) { ret __err(); }
    ret code;
}
// NetBSD libc `listen`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn listen(fd: i32, backlog: i32) i32 {
    const code: i32 = __listen(fd, backlog);
    if (code < 0) { ret __err(); }
    ret code;
}
// NetBSD libc `accept`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn accept(fd: i32, addr: *u8, len: *u32) i32 {
    const accepted: i32 = __accept(fd, addr, len);
    if (accepted < 0) { ret __err(); }
    ret accepted;
}
// NetBSD libc `sendto`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn sendto(fd: i32, buf: *u8, count: usize, flags: i32, address: *u8, address_size: u32) isize {
    var native_flags: i32 = flags;
    // Linux MSG_NOSIGNAL=0x4000, NetBSD MSG_NOSIGNAL=0x0400.
    if ((flags & 16384) != 0) { native_flags = (flags ^ 16384) | 1024; }
    const written: isize = __sendto(fd, buf, count, native_flags, address, address_size);
    if (written < 0) { ret __err() as isize; }
    ret written;
}
// NetBSD libc `recvfrom`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn recvfrom(fd: i32, buf: *u8, count: usize, flags: i32, address: *u8, address_size: *u32) isize {
    const n: isize = __recvfrom(fd, buf, count, flags, address, address_size);
    if (n < 0) { ret __err() as isize; }
    ret n;
}
// NetBSD libc `shutdown`, returning a negative errno on failure like the
// Linux system call of the same name.
pub unsafe fn shutdown(fd: i32, mode: i32) i32 {
    const result: i32 = __shutdown(fd, mode);
    if (result < 0) { ret __err(); }
    ret result;
}

// Set (overwriting) an environment variable; 0 or negative errno.
pub unsafe fn setenv(name: *u8, value: *u8) i32 {
    if (__setenv(name, value, 1) == 0) { ret 0; }
    ret -(*__errno_location());
}

// Remove an environment variable; 0 or negative errno.
pub unsafe fn unsetenv(name: *u8) i32 {
    if (__unsetenv(name) == 0) { ret 0; }
    ret -(*__errno_location());
}

// ── Processes (std.posix / std.process) ─────────────────────────────────────

@api("fork")
unsafe fn __fork() i32;
@api("execve")
unsafe fn __execve(path: *u8, argv: *u8, envp: *u8) i32;
@api("dup2")
unsafe fn __dup2(old: i32, new_fd: i32) i32;
@api("pipe2")
unsafe fn __pipe2(fds: *u8, flags: i32) i32;
@api("poll")
unsafe fn __poll(fds: *u8, count: usize, timeout: i32) i32;
@api("waitpid")
unsafe fn __waitpid(pid: i32, status: *i32, options: i32) i32;
@api("_exit")
unsafe fn __exit_now(status: i32) void;

// NetBSD libc `fork`: the child's pid in the parent, 0 in the child, or a
// negative errno.
pub unsafe fn fork() i32 {
    const pid: i32 = __fork();
    if (pid < 0) { ret __err(); }
    ret pid;
}

// NetBSD libc `execve`; returns only on failure, with a negative errno.
pub unsafe fn execve(path: str, argv: *u8, envp: *u8) i32 {
    __execve(core.str_as_ptr(path), argv, envp);
    ret __err();
}

// NetBSD libc `dup2`, returning a negative errno on failure.
pub unsafe fn dup2(old: i32, new_fd: i32) i32 {
    const fd: i32 = __dup2(old, new_fd);
    if (fd < 0) { ret __err(); }
    ret fd;
}

// NetBSD libc `pipe2`. `flags` uses the Linux O_CLOEXEC value (0x80000),
// translated to NetBSD's (0x400000).
pub unsafe fn pipe2(fds: *u8, flags: i32) i32 {
    var native: i32 = 0;
    if ((flags & 524288) != 0) { native = 4194304; }
    if (__pipe2(fds, native) < 0) { ret __err(); }
    ret 0;
}

// NetBSD libc `poll` (same `struct pollfd` layout and POLLIN as Linux).
pub unsafe fn poll(fds: *u8, count: usize, timeout: i32) i32 {
    const ready: i32 = __poll(fds, count, timeout);
    if (ready < 0) { ret __err(); }
    ret ready;
}

// NetBSD libc `waitpid` (WNOHANG = 1; status encoded like Linux).
pub unsafe fn waitpid(pid: i32, status: *i32, options: i32) i32 {
    const reaped: i32 = __waitpid(pid, status, options);
    if (reaped < 0) { ret __err(); }
    ret reaped;
}

// NetBSD libc `_exit`: ends the process without running atexit handlers or
// flushing stdio (safe in a forked child).
pub unsafe fn exit_now(status: i32) void { __exit_now(status); }
