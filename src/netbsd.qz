pub unsafe fn kill(pid: i32, sig: i32) i32 {
    const code: i32 = __kill(pid, sig);
    if (code < 0) { ret __err(); }
    ret code;
}

// NetBSD libc `clock_gettime`, returning a negative errno on failure like the
