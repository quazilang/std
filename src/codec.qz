// std.codec — typed serialization contracts built on JSON wire codecs.
import std.core;
import std.json;
import std.json.JsonError;
import std.time.SystemTime;

// Why a value could not be encoded.
pub enum EncodeError {
    UnsupportedType,
    OutputLimit,
    DepthLimit,
    InvalidValue,
}

impl EncodeError {
    // A short English description of the error, for display.
    pub fn message(self: EncodeError) str {
        ret match self {
            UnsupportedType => "this value has no supported wire encoding",
            OutputLimit => "serialized output exceeds the configured byte limit",
            DepthLimit => "serialized output exceeds the configured nesting limit",
            InvalidValue => "serialized value is not a valid JSON value",
        };
    }
}

// Why decoding failed.
pub enum DecodeError {
    InputLimit,
    DepthLimit,
    InvalidJson,
    TypeMismatch,
    MissingField,
    DuplicateField,
    UnknownField,
    InvalidValue,
}

impl DecodeError {
    // A short English description of the error, for display.
    pub fn message(self: DecodeError) str {
        ret match self {
            InputLimit => "serialized input exceeds the configured byte limit",
            DepthLimit => "serialized input exceeds the configured nesting limit",
            InvalidJson => "input is not valid JSON",
            TypeMismatch => "JSON value has an incompatible type",
            MissingField => "JSON object is missing a required field",
            DuplicateField => "JSON object contains a duplicate field",
            UnknownField => "JSON object contains an unknown field",
            InvalidValue => "JSON value is not valid for the destination type",
        };
    }
}

// Implementations must produce exactly one JSON value. Future compiler derives
// implement this trait for supported non-generic structs.
pub trait Serialize {
    fn to_json(self: Self) Result[String, EncodeError];
}

// Quazi traits currently require a receiver, so typed decode starts as explicit
// free functions. A static Deserialize trait needs receiverless trait methods.
impl Serialize for bool {
    // The JSON text of the value.
    pub fn to_json(self: bool) Result[String, EncodeError] {
        ret Ok(String.from(json.boolean(self)));
    }
}

// JSON numbers use their ordinary base-10 spelling. Keeping the first signed
// integer contract at i64 matches decode_i64 and avoids silently promising
// lossy float or platform-width integer behavior to generated derives.
impl Serialize for i64 {
    // The JSON text of the value.
    pub fn to_json(self: i64) Result[String, EncodeError] {
        ret Ok(self.to_string());
    }
}

// Normalize the lower-level JSON composition errors at the typed codec
// boundary. A caller of Serialize never has to depend on JSON parser internals,
// while resource-policy failures remain distinguishable for retry or reporting.
fn encode_json_error(error: JsonError) EncodeError {
    ret match error {
        InputLimit => EncodeError.OutputLimit,
        OutputLimit => EncodeError.OutputLimit,
        DepthLimit => EncodeError.DepthLimit,
        _ => EncodeError.InvalidValue,
    };
}

// Compose a typed JSON object from ordered, already-encoded field values.
// Compiler-generated Serialize implementations use this instead of exposing a
// JsonError in their public Result type.
pub fn object(keys: Array[str], values: Array[String]) Result[String, EncodeError] {
    const encoded: Result[String, JsonError] = json.object(keys, values);
    if (encoded.is_err()) { ret Err(encode_json_error(encoded.unwrap_err())); }
    ret Ok(encoded.unwrap());
}

fn whitespace(byte: u8) bool { ret byte == 32 || byte == 9 || byte == 10 || byte == 13; }
fn digit(byte: u8) bool { ret byte >= 48 && byte <= 57; }

fn literal_at(source: str, start: usize, end: usize, value: str) bool {
    if (end - start != value.bytes_len()) { ret false; }
    for i : 0..value.bytes_len() {
        if (core.str_byte_at(source, start + i) != core.str_byte_at(value, i)) { ret false; }
    }
    ret true;
}

fn decode_validation_error(error: JsonError) DecodeError {
    ret match error {
        InputLimit => DecodeError.InputLimit,
        DepthLimit => DecodeError.DepthLimit,
        _ => DecodeError.InvalidJson,
    };
}

// Decodes a JSON boolean, with input size and nesting limits.
pub fn decode_bool_with_limits(source: str, max_input: usize, max_depth: usize) Result[bool, DecodeError] {
    const validation: Result[bool, JsonError] = json.validate_with_limits(source, max_input, max_depth);
    if (validation.is_err()) { ret Err(decode_validation_error(validation.unwrap_err())); }
    var start: usize = 0;
    var end: usize = source.bytes_len();
    for (start < end && whitespace(core.str_byte_at(source, start))) { start = start + 1; }
    for (start < end && whitespace(core.str_byte_at(source, end - 1))) { end = end - 1; }
    if (literal_at(source, start, end, "true")) { ret Ok(true); }
    if (literal_at(source, start, end, "false")) { ret Ok(false); }
    ret Err(DecodeError.TypeMismatch);
}

// Decodes a JSON boolean.
pub fn decode_bool(source: str) Result[bool, DecodeError] {
    ret decode_bool_with_limits(source, 1048576, 64);
}

// Decodes a JSON string, with input size and nesting limits.
pub fn decode_string_with_limits(source: str, max_input: usize, max_depth: usize) Result[String, DecodeError] {
    // Valid JSON of another type (a number, `true`, ...) is a type mismatch.
    const validation: Result[bool, JsonError] = json.validate_with_limits(source, max_input, max_depth);
    if (validation.is_err()) { ret Err(decode_validation_error(validation.unwrap_err())); }
    var start: usize = 0;
    for (start < source.bytes_len() && whitespace(core.str_byte_at(source, start))) { start = start + 1; }
    if (start == source.bytes_len() || core.str_byte_at(source, start) != 34) { ret Err(DecodeError.TypeMismatch); }
    const decoded: Result[String, JsonError] = json.decode_string_with_limits(source, max_input, max_depth);
    if (decoded.is_err()) { ret Err(decode_validation_error(decoded.unwrap_err())); }
    ret Ok(decoded.unwrap());
}

// Decodes a JSON string.
pub fn decode_string(source: str) Result[String, DecodeError] {
    ret decode_string_with_limits(source, 1048576, 64);
}

// Decodes a JSON integer as `i64`, with input size and nesting limits.
pub fn decode_i64_with_limits(source: str, max_input: usize, max_depth: usize) Result[i64, DecodeError] {
    const validation: Result[bool, JsonError] = json.validate_with_limits(source, max_input, max_depth);
    if (validation.is_err()) { ret Err(decode_validation_error(validation.unwrap_err())); }
    var start: usize = 0; var end: usize = source.bytes_len();
    for (start < end && whitespace(core.str_byte_at(source, start))) { start = start + 1; }
    for (start < end && whitespace(core.str_byte_at(source, end - 1))) { end = end - 1; }
    if (start == end || (core.str_byte_at(source, start) != 45 && !digit(core.str_byte_at(source, start)))) { ret Err(DecodeError.TypeMismatch); }
    const raw: String = source[start as isize:end as isize];
    const parsed: Result[i64, ParseError] = raw.parse_i64();
    if (parsed.is_err()) { ret Err(DecodeError.InvalidValue); }
    ret Ok(parsed.unwrap());
}

// Decodes a JSON integer as `i64`.
pub fn decode_i64(source: str) Result[i64, DecodeError] { ret decode_i64_with_limits(source, 1048576, 64); }

impl Serialize for str {
    // The JSON string literal of the text, with escapes.
    pub fn to_json(self: str) Result[String, EncodeError] { ret Ok(json.quote(self)); }
}

impl Serialize for String {
    // The JSON string literal of the text, with escapes.
    pub fn to_json(self: String) Result[String, EncodeError] {
        ret Ok(json.quote(self.as_str()));
    }
}

// A timestamp serializes as an RFC 3339 UTC JSON string, e.g.
// "2000-02-29T12:34:56Z"; fractions keep nine digits when nonzero.
impl Serialize for SystemTime {
    // The time as a JSON string in RFC 3339 format.
    pub fn to_json(self: SystemTime) Result[String, EncodeError] {
        const text: String = self.format_rfc3339();
        Ok(json.quote(text.as_str()))
    }
}

// Decode a JSON string holding an RFC 3339 timestamp (offsets are normalized
// to UTC). Non-strings are TypeMismatch; malformed or out-of-range text is
// InvalidValue.
pub fn decode_system_time(source: str) Result[SystemTime, DecodeError] {
    const text: String = decode_string(source)?;
    const parsed = SystemTime.parse_rfc3339(text.as_str());
    if (parsed.is_err()) { ret Err(DecodeError.InvalidValue); }
    Ok(parsed.unwrap())
}

// ── Object decoding (used by `@derive(Deserialize)`) ─────────────────────────
// Policy (maintainer answer В19В): an unknown key is `UnknownField`, a
// repeated key `DuplicateField`, a missing required field `MissingField`; an
// `Option` field is `None` when its key is missing or its value is `null`.

// The value ranges of the expected `keys` of the JSON object `source` (see
// `json.object_fields`).
pub fn object_fields(source: str, keys: &Array[str]) Result[Array[usize], DecodeError] {
    const spans = json.object_fields(source, keys);
    if (spans.is_err()) {
        ret Err(match spans.unwrap_err() {
            UnknownKey => DecodeError.UnknownField,
            DuplicateKey => DecodeError.DuplicateField,
            InputLimit => DecodeError.InputLimit,
            DepthLimit => DecodeError.DepthLimit,
            _ => DecodeError.InvalidJson,
        });
    }
    ret Ok(spans.unwrap());
}

// The raw JSON value of field `index`, or `None` when the key is missing.
fn field_text(source: str, spans: &Array[usize], index: usize) Option[String] {
    const start: usize = spans[2 * index];
    const end: usize = spans[2 * index + 1];
    if (end == 0) { ret None; }
    ret Some(source[start as isize:end as isize]);
}

// The raw JSON value of a field that may be omitted or `null`.
fn optional_text(source: str, spans: &Array[usize], index: usize) Option[String] {
    const text = field_text(source, spans, index);
    if (text.is_none()) { ret None; }
    const raw: String = text.unwrap();
    if (raw.as_str() == "null") { ret None; }
    ret Some(raw);
}

// A required boolean field.
pub fn field_bool(source: str, spans: &Array[usize], index: usize) Result[bool, DecodeError] {
    const text = field_text(source, spans, index);
    if (text.is_none()) { ret Err(DecodeError.MissingField); }
    const raw: String = text.unwrap();
    ret decode_bool(raw.as_str());
}

// A required `i64` field.
pub fn field_i64(source: str, spans: &Array[usize], index: usize) Result[i64, DecodeError] {
    const text = field_text(source, spans, index);
    if (text.is_none()) { ret Err(DecodeError.MissingField); }
    const raw: String = text.unwrap();
    ret decode_i64(raw.as_str());
}

// A required string field.
pub fn field_string(source: str, spans: &Array[usize], index: usize) Result[String, DecodeError] {
    const text = field_text(source, spans, index);
    if (text.is_none()) { ret Err(DecodeError.MissingField); }
    const raw: String = text.unwrap();
    const decoded: String = decode_string(raw.as_str())?;
    ret Ok(String.from(decoded.as_str()));
}

// An optional boolean field.
pub fn optional_bool(source: str, spans: &Array[usize], index: usize) Result[Option[bool], DecodeError] {
    const text = optional_text(source, spans, index);
    if (text.is_none()) { ret Ok(None); }
    const raw: String = text.unwrap();
    const value: bool = decode_bool(raw.as_str())?;
    ret Ok(Some(value));
}

// An optional `i64` field.
pub fn optional_i64(source: str, spans: &Array[usize], index: usize) Result[Option[i64], DecodeError] {
    const text = optional_text(source, spans, index);
    if (text.is_none()) { ret Ok(None); }
    const raw: String = text.unwrap();
    const value: i64 = decode_i64(raw.as_str())?;
    ret Ok(Some(value));
}

// An optional string field.
pub fn optional_string(source: str, spans: &Array[usize], index: usize) Result[Option[String], DecodeError] {
    const text = optional_text(source, spans, index);
    if (text.is_none()) { ret Ok(None); }
    const raw: String = text.unwrap();
    const decoded: String = decode_string(raw.as_str())?;
    ret Ok(Some(String.from(decoded.as_str())));
}

@test
fn object_fields_reject_unknown_and_duplicate_keys() void {
    var keys: Array[str] = Array.new();
    keys.push("name");
    keys.push("age");
    keys.push("nick");
    const source = "{{\"name\": \"Ann\", \"age\": 41, \"nick\": null}}";
    const spans = object_fields(source, &keys).unwrap();
    const name = field_string(source, &spans, 0).unwrap();
    if (name.as_str() != "Ann") { panic("name decoded wrong"); }
    if (field_i64(source, &spans, 1).unwrap() != 41) { panic("age decoded wrong"); }
    if (optional_string(source, &spans, 2).unwrap().is_some()) { panic("null must decode as None"); }
    const missing_source = "{{\"name\": \"Bo\"}}";
    const missing = object_fields(missing_source, &keys).unwrap();
    const missing_age: bool = match field_i64(missing_source, &missing, 1) { Err(DecodeError.MissingField) => true, _ => false };
    if (!missing_age) { panic("a missing required field must be MissingField"); }
    if (optional_i64(missing_source, &missing, 1).unwrap().is_some()) { panic("a missing optional field must be None"); }
    const unknown: bool = match object_fields("{{\"name\": \"C\", \"extra\": 1}}", &keys) { Err(DecodeError.UnknownField) => true, _ => false };
    if (!unknown) { panic("an unknown key must be UnknownField"); }
    const duplicate: bool = match object_fields("{{\"age\": 1, \"age\": 2}}", &keys) { Err(DecodeError.DuplicateField) => true, _ => false };
    if (!duplicate) { panic("a repeated key must be DuplicateField"); }
}

@test
fn system_time_round_trips_through_rfc3339_json() void {
    const time = SystemTime.from_unix(951827696, 5).unwrap();
    const encoded: String = time.to_json().unwrap();
    if (encoded.as_str() != "\"2000-02-29T12:34:56.000000005Z\"") { panic("timestamp JSON is wrong"); }
    const decoded = decode_system_time(encoded.as_str()).unwrap();
    if (decoded.unix_seconds() != 951827696 || decoded.subsec_nanoseconds() != 5) { panic("timestamp did not round-trip"); }
    if (decode_system_time("\"2000-02-30T00:00:00Z\"").is_ok()) { panic("invalid date decoded"); }
    if (decode_system_time("12").is_ok()) { panic("number decoded as a timestamp"); }
}
